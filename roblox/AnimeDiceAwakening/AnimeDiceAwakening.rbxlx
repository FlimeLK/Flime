		awakened = { name = "Riku, Storm Leaf", multiplier = 2.5 },
		look = { body = Color3.fromRGB(60, 120, 80), hair = Color3.fromRGB(40, 40, 40), skin = SKIN, height = 0.9 },
	},
	{
