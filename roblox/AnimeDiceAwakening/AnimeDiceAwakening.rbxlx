	ui.stats = UIKit.Label({
		Position = UDim2.fromOffset(12, 82),
		Size = UDim2.new(1, -24, 0, 104),
		TextSize = 14,
		LineHeight = 1.05,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		Parent = card,
	})
	-- ◀ 1/3 ▶ та "Я"
	local nav = UIKit.Create("Frame", { Position = UDim2.new(0, 10, 1, -44), Size = UDim2.new(1, -20, 0, 36), BackgroundTransparency = 1, Parent = card })
	button(nav, "◀", COLORS.Player, function()
		cycleTarget(-1)
	end, { Size = UDim2.fromOffset(44, 36) })
	ui.playerCount = UIKit.Label({ Position = UDim2.fromOffset(48, 0), Size = UDim2.new(1, -150, 1, 0), Font = UIKit.Font, TextSize = 18, Parent = nav })
	button(nav, "▶", COLORS.Player, function()
		cycleTarget(1)
	end, { Size = UDim2.fromOffset(44, 36), Position = UDim2.new(1, -98, 0, 0) })
	button(nav, "Я", COLORS.Gold, function()
		selected = player
		refreshTarget()
	end, { Size = UDim2.fromOffset(46, 36), Position = UDim2.new(1, -46, 0, 0) })

	-- Вкладки
	local tabs = UIKit.Create("Frame", { Position = UDim2.fromOffset(0, 248), Size = UDim2.new(1, 0, 1, -248), BackgroundTransparency = 1, Parent = sidebar })
	UIKit.Create("UIGridLayout", { CellSize = UDim2.new(0.5, -4, 0, 42), CellPadding = UDim2.fromOffset(8, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = tabs })
	for index, tab in {
		{ "Currency", "💰 Валюта" },
		{ "Heroes", "🦸 Герої" },
		{ "Progress", "🗺️ Прогрес" },
		{ "Player", "🧍 Гравець" },
		{ "Server", "📢 Сервер" },
		{ "Log", "📜 Журнал" },
	} do
		local id = tab[1]
		tabButtons[id] = button(tabs, tab[2], COLORS[id], function()
			AdminUI.ShowTab(id)
		end, { LayoutOrder = index, TextSize = 15 })
	end
end

function AdminUI.ShowTab(id)
	for name, page in pages do
		page.Visible = name == id
	end
	for name, b in tabButtons do
		local active = name == id
		b.BackgroundColor3 = if active then COLORS[name] else COLORS[name]:Lerp(Color3.fromRGB(40, 38, 55), 0.6)
		UIKit.SetOutline(b, if active then Color3.new(1, 1, 1) else UIKit.Colors.Outline, 3)
	end
	if id == "Log" then
		AdminUI.RefreshLog()
	end
end

---------------------------------------------------------------------
-- Сторінки
---------------------------------------------------------------------

local function buildCurrency()
	local page = newPage("Currency")
	for order, kind in { { "Coins", "🪙 Монети", { 1e3, 1e5, 1e7, 1e9 } }, { "Crystals", "💎 Кристали", { 10, 100, 1000, 10000 } } } do
		local card = section(page, kind[2], COLORS.Currency, order)
		local quick = row(card, 1)
		for index, amount in kind[3] do
			button(quick, "+" .. GameMath.FormatNumber(amount), if kind[1] == "Coins" then Color3.fromRGB(240, 170, 30) else Color3.fromRGB(70, 180, 255), function()
				request(kind[1], { amount = amount }, true)
			end, { LayoutOrder = index, Size = UDim2.fromOffset(120, 44) })
		end
		local custom = row(card, 2, 44)
		local box = input(custom, "Своя кількість: 2500, 1.5m, 3b…", { Size = UDim2.new(1, -236, 0, 44) })
		local function send(sign)
			local amount = parseAmount(box.Text)
			if not amount or amount <= 0 then
				UIKit.Toast("Введи число, напр. 5000 або 2.5m", "error")
				return
			end
			request(kind[1], { amount = amount * sign }, true)
		end
		button(custom, "➕ Видати", UIKit.Colors.Success, function()
			send(1)
		end, { Size = UDim2.fromOffset(110, 44), LayoutOrder = 2 })
		button(custom, "➖ Забрати", COLORS.Danger, function()
			send(-1)
		end, { Size = UDim2.fromOffset(110, 44), LayoutOrder = 3 })
	end

	local boosts = section(page, "🧪 Бусти", Color3.fromRGB(90, 220, 120), 3)
	local boostRow = row(boosts, 1)
	for index, entry in {
		{ "luck", 15, "🍀 Удача 15 хв" },
		{ "luck", 60, "🍀 Удача 1 год" },
		{ "income", 15, "💰 Дохід 15 хв" },
		{ "income", 60, "💰 Дохід 1 год" },
	} do
		button(boostRow, entry[3], if entry[1] == "luck" then Color3.fromRGB(70, 200, 90) else Color3.fromRGB(240, 170, 30), function()
			request("Boost", { boost = entry[1], minutes = entry[2] }, true)
		end, { LayoutOrder = index, Size = UDim2.fromOffset(145, 44), TextSize = 15 })
	end
end

local function buildHeroes()
	local page = newPage("Heroes", true)
	local selectedHero = nil
	local cards = {}

	local top = UIKit.Create("Frame", { Size = UDim2.new(1, -10, 0, 44), BackgroundTransparency = 1, LayoutOrder = 1, Parent = page })
	local search = input(top, "🔍 Пошук: ім'я, рідкість або стихія…", { Size = UDim2.fromScale(1, 1) })

	local grid = UIKit.Create("ScrollingFrame", {
		Size = UDim2.new(1, -10, 1, -158),
		BackgroundColor3 = Color3.fromRGB(24, 22, 34),
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = COLORS.Heroes,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		LayoutOrder = 2,
		Parent = page,
	})
	UIKit.Corner(grid, 12)
	UIKit.Stroke(grid, COLORS.Heroes, 3)
	UIKit.Create("UIPadding", { PaddingTop = UDim.new(0, 8), PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8), Parent = grid })
	UIKit.Create("UIGridLayout", { CellSize = UDim2.fromOffset(142, 62), CellPadding = UDim2.fromOffset(8, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = grid })

	local controls = UIKit.Card({ Size = UDim2.new(1, -10, 0, 86), LayoutOrder = 3, Parent = page }, COLORS.Heroes)
	local chosen = UIKit.Label({
		Position = UDim2.fromOffset(12, 6),
		Size = UDim2.new(1, -24, 0, 24),
		Font = UIKit.Font,
		TextSize = 20,
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = "Обери героя зі списку",
		Parent = controls,
	})
	local line = row(controls, 1, 44)
	line.Position = UDim2.fromOffset(12, 34)
	line.Size = UDim2.new(1, -24, 0, 44)
	local level = input(line, "Рівень (макс.)", { Size = UDim2.fromOffset(130, 40), LayoutOrder = 1 })
	local awakened = false
	local awakenButton
	awakenButton = button(line, "✨ Пробуджений: ні", Color3.fromRGB(70, 66, 92), function()
		awakened = not awakened
		awakenButton.Text = if awakened then "✨ Пробуджений: так" else "✨ Пробуджений: ні"
		awakenButton.BackgroundColor3 = if awakened then COLORS.Gold else Color3.fromRGB(70, 66, 92)
	end, { Size = UDim2.fromOffset(170, 40), LayoutOrder = 2, TextSize = 14 })
	local countHolder = UIKit.Create("Frame", { Size = UDim2.fromOffset(156, 40), BackgroundTransparency = 1, LayoutOrder = 3, Parent = line })
	UIKit.Create("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder, Parent = countHolder })
	local getCount = chips(countHolder, { { text = "×1", value = 1 }, { text = "×5", value = 5 }, { text = "×10", value = 10 } }, 1, COLORS.Heroes, 48)
	button(line, "🎁 Видати", UIKit.Colors.Success, function()
		if not selectedHero then
			UIKit.Toast("Спершу обери героя", "error")
			return
		end
		request("GiveHero", { heroId = selectedHero, level = tonumber(level.Text), awakened = awakened, count = getCount() }, true)
	end, { Size = UDim2.fromOffset(124, 40), LayoutOrder = 4 })

	for index, heroDef in HeroConfig.List do
		local rarityColor = RarityConfig.GetColor(heroDef.rarity)
		local card = UIKit.Button({
			Name = heroDef.id,
			BackgroundColor3 = rarityColor:Lerp(Color3.fromRGB(20, 18, 30), 0.45),
			Text = "",
			LayoutOrder = RarityConfig.GetRank(heroDef.rarity) * 100 + index,
			Parent = grid,
		}, function()
			selectedHero = heroDef.id
			for id, other in cards do
				UIKit.SetOutline(other, if id == heroDef.id then COLORS.Gold else UIKit.Colors.Outline, if id == heroDef.id then 5 else 3)
			end
			local maxLevel = RarityConfig.Info[heroDef.rarity].maxLevel
			chosen.Text = ("%s %s • %s • макс. Lv %d"):format(HeroConfig.ElementIcons[heroDef.element] or "", heroDef.name, heroDef.rarity, maxLevel)
			chosen.TextColor3 = rarityColor
		end)
		UIKit.HeroPortrait(card, heroDef.id, 0.5)
		UIKit.Label({
			Position = UDim2.fromOffset(6, 4),
			Size = UDim2.new(1, -12, 0, 30),
			Font = UIKit.Font,
			TextScaled = true,
			Text = heroDef.name,
			Parent = card,
		})
		UIKit.Label({
			Position = UDim2.fromOffset(6, 36),
			Size = UDim2.new(1, -12, 0, 20),
			Font = UIKit.Font,
			TextScaled = true,
			TextColor3 = rarityColor:Lerp(Color3.new(1, 1, 1), 0.35),
			Text = (HeroConfig.ElementIcons[heroDef.element] or "") .. " " .. heroDef.rarity,
			Parent = card,
		})
		cards[heroDef.id] = card
	end

	search:GetPropertyChangedSignal("Text"):Connect(function()
		local query = string.lower(search.Text)
		for _, heroDef in HeroConfig.List do
			local text = string.lower(heroDef.name .. " " .. heroDef.rarity .. " " .. heroDef.element)
			cards[heroDef.id].Visible = query == "" or string.find(text, query, 1, true) ~= nil
		end
	end)
end

local function buildProgress()
	local page = newPage("Progress")
	local unlock = section(page, "🔓 Прогрес гравця", COLORS.Progress, 1)
	local unlockRow = row(unlock, 1)
	for index, entry in {
		{ "UnlockAll", "🌍 Відкрити все" },
		{ "MaxBase", "🧱 Макс. база" },
		{ "AddRebirth", "♻️ +1 Rebirth" },
	} do
		button(unlockRow, entry[2], COLORS.Progress, function()
			request(entry[1], {}, true)
		end, { LayoutOrder = index, Size = UDim2.fromOffset(170, 46) })
	end
	UIKit.Label({
		Size = UDim2.new(1, 0, 0, 20),
		TextSize = 14,
		TextColor3 = UIKit.Colors.SubText,
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = "«Відкрити все» — світи, зони й кубики. «+1 Rebirth» — бонус без скидання прогресу.",
		LayoutOrder = 2,
		Parent = unlock,
	})

	local travel = section(page, "🌀 Телепорт у світ (без вимог)", Color3.fromRGB(70, 150, 255), 2)
	local travelRow = row(travel, 1)
	button(travelRow, "🏠 Лобі", Color3.fromRGB(255, 120, 200), function()
		request("Travel", { world = "Lobby" }, true)
	end, { LayoutOrder = 0, Size = UDim2.fromOffset(170, 46) })
	for index, worldId in WorldConfig.Order do
		local world = WorldConfig.Worlds[worldId]
		if world.available then
			button(travelRow, world.displayName, world.color, function()
				request("Travel", { world = worldId }, true)
			end, { LayoutOrder = index, Size = UDim2.fromOffset(170, 46), TextSize = 16 })
		end
	end

	local danger = section(page, "⚠️ Небезпечна зона", COLORS.Danger, 3)
	local dangerRow = row(danger, 1)
	confirmButton(dangerRow, "🗑️ Скинути прогрес", function()
		request("ResetData", {}, true)
	end, { Size = UDim2.fromOffset(220, 46) })
end

local function buildPlayer()
	local page = newPage("Player")
	local move = section(page, "📍 Переміщення", COLORS.Player, 1)
	local moveRow = row(move, 1)
	for index, entry in { { "GoTo", "➡️ До гравця" }, { "Bring", "⬅️ До себе" }, { "Heal", "❤️ Вилікувати" } } do
		button(moveRow, entry[2], if entry[1] == "Heal" then UIKit.Colors.Success else COLORS.Player, function()
			request(entry[1], {}, true)
		end, { LayoutOrder = index, Size = UDim2.fromOffset(170, 46) })
	end

	local speed = section(page, "🏃 Швидкість ходьби", Color3.fromRGB(80, 220, 200), 2)
	local speedRow = row(speed, 1)
	for index, value in AdminConfig.WalkSpeeds do
		button(speedRow, (if index == 1 then "🚶 " else "🏃 ") .. value, Color3.fromRGB(50, 190, 170), function()
			request("Speed", { speed = value }, true)
		end, { LayoutOrder = index, Size = UDim2.fromOffset(120, 46) })
	end

	local kick = section(page, "🚪 Вигнати з сервера", COLORS.Danger, 3)
	local kickRow = row(kick, 1, 46)
	local reason = input(kickRow, "Причина (необов'язково)", { Size = UDim2.new(1, -168, 0, 46) })
	confirmButton(kickRow, "🚪 Вигнати", function()
		request("Kick", { reason = reason.Text }, true)
		reason.Text = ""
	end, { Size = UDim2.fromOffset(160, 46), LayoutOrder = 2 })
end

local function buildServer()
	local page = newPage("Server")
	local announce = section(page, "📢 Оголошення для всіх", COLORS.Server, 1)
	local announceRow = row(announce, 1, 46)
	local text = input(announceRow, "Напр.: Через 5 хвилин подія удачі ×3!", { Size = UDim2.new(1, -168, 0, 46) })
	button(announceRow, "📢 Надіслати", COLORS.Server, function()
		if #text.Text < 2 then
			UIKit.Toast("Напиши текст оголошення", "error")
			return
		end
		if request("Announce", { text = text.Text }).ok then
			text.Text = ""
		end
	end, { Size = UDim2.fromOffset(160, 46), LayoutOrder = 2 })

	local events = section(page, "🎉 Подія для всього сервера", COLORS.Gold, 2)
	local minutesRow = row(events, 1)
	UIKit.Label({ Size = UDim2.fromOffset(110, 40), Font = UIKit.Font, TextSize = 18, Text = "⏱ Тривалість:", LayoutOrder = 0, Parent = minutesRow })
	local getMinutes = chips(minutesRow, { { text = "5 хв", value = 5 }, { text = "15 хв", value = 15 }, { text = "30 хв", value = 30 }, { text = "60 хв", value = 60 } }, 15, COLORS.Gold, 76)
	for order, kind in { { "Luck", "🍀 Удача", Color3.fromRGB(70, 200, 90) }, { "Income", "💰 Дохід", Color3.fromRGB(240, 170, 30) } } do
		local eventRow = row(events, order + 1)
		UIKit.Label({ Size = UDim2.fromOffset(110, 44), Font = UIKit.Font, TextSize = 18, Text = kind[2], TextColor3 = kind[3], LayoutOrder = 0, Parent = eventRow })
		for index, multiplier in AdminConfig.EventMultipliers do
			button(eventRow, "×" .. multiplier, kind[3], function()
				request("Event", { kind = kind[1], multiplier = multiplier, minutes = getMinutes() })
			end, { LayoutOrder = index, Size = UDim2.fromOffset(76, 44) })
		end
	end
	local stopRow = row(events, 5)
	button(stopRow, "⏹ Зупинити всі події", COLORS.Danger, function()
		request("StopEvents")
	end, { Size = UDim2.fromOffset(240, 44) })

	local world = section(page, "⚔️ Світ", Color3.fromRGB(255, 110, 70), 3)
	local worldRow = row(world, 1)
	confirmButton(worldRow, "💥 Перемогти всіх ворогів тут", function()
		request("ClearWorld")
	end, { Size = UDim2.fromOffset(300, 46) })
end

local function buildLog()
	local page = newPage("Log")
	local head = row(page, 0, 44)
	button(head, "🔄 Оновити", COLORS.Log, function()
		AdminUI.RefreshLog()
	end, { Size = UDim2.fromOffset(150, 40) })
	ui.logList = UIKit.Create("Frame", { Size = UDim2.new(1, -10, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = 1, Parent = page })
	UIKit.Create("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder, Parent = ui.logList })
end

function AdminUI.RefreshLog()
	if not ui.logList then
		return
	end
	local result = ClientState.Request("AdminAction", "GetLog")
	for _, child in ui.logList:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	local entries = if result.ok and type(result.log) == "table" then result.log else {}
	if #entries == 0 then
		UIKit.Label({ Size = UDim2.new(1, 0, 0, 40), TextSize = 18, TextColor3 = UIKit.Colors.SubText, Text = "Поки що порожньо", Parent = ui.logList })
	end
	for index, entry in entries do
		local line = UIKit.Create("Frame", { Size = UDim2.new(1, 0, 0, 40), BackgroundColor3 = if index % 2 == 0 then Color3.fromRGB(32, 30, 44) else Color3.fromRGB(26, 24, 36), LayoutOrder = index, Parent = ui.logList })
		UIKit.Corner(line, 10)
		UIKit.Label({
			Position = UDim2.fromOffset(10, 0),
			Size = UDim2.new(1, -20, 1, 0),
			TextSize = 15,
			TextXAlignment = Enum.TextXAlignment.Left,
			RichText = true,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Text = ('<font color="#a8a0d0">%s</font>  <b>%s</b> → <font color="#ffcc55">%s</font>%s %s'):format(
				os.date("%H:%M:%S", entry.time),
				entry.admin or "?",
				entry.action or "?",
				if entry.target then " • " .. entry.target else "",
				entry.details or ""
			),
			Parent = line,
		})
	end
end

---------------------------------------------------------------------
-- Панель і кнопка 👑
---------------------------------------------------------------------

local function buildPanel(gui)
	local panel, content = UIKit.Panel(gui, "Admin", "👑 Admin Panel", GOLD)
	panel.Size = UDim2.fromOffset(920, 580)
	Hud.RegisterPanel("Admin", panel)
	ui.panel = panel

	buildSidebar(content)
	ui.pageHolder = UIKit.Create("Frame", {
		Position = UDim2.fromOffset(236, 0),
		Size = UDim2.new(1, -236, 1, 0),
		BackgroundTransparency = 1,
		Parent = content,
	})
	buildCurrency()
	buildHeroes()
	buildProgress()
	buildPlayer()
	buildServer()
	buildLog()
	AdminUI.ShowTab("Currency")

	panel:GetPropertyChangedSignal("Visible"):Connect(function()
		if panel.Visible then
			refreshTarget()
		end
	end)
	Players.PlayerAdded:Connect(function()
		if panel.Visible then
			refreshTarget()
		end
	end)
	Players.PlayerRemoving:Connect(function(leaving)
		if leaving == selected then
			selected = player
		end
		task.defer(function()
			if panel.Visible then
				refreshTarget()
			end
		end)
	end)

	-- Кнопка 👑 у верхньому меню поруч із Worlds / Home / Shop
	local topNav = Hud.Get("Worlds") and Hud.Get("Worlds").Parent
	local crown = UIKit.Button({
		Name = "Admin",
		LayoutOrder = 10,
		Size = UDim2.fromOffset(62, 62),
		BackgroundColor3 = COLORS.Gold,
		Text = "👑",
		TextScaled = true,
		Parent = topNav or gui,
	}, function()
		Hud.TogglePanel("Admin")
	end)
	crown.Outline.UIStroke.Thickness = 4
	if not topNav then
		crown.Position = UDim2.new(0, 12, 0, 70)
		UIKit.AddScale(crown)
	end

	UserInputService.InputBegan:Connect(function(inputObject, gameProcessed)
		if not gameProcessed and inputObject.KeyCode == Enum.KeyCode.F2 then
			Hud.TogglePanel("Admin")
		end
	end)
end

---------------------------------------------------------------------
-- Для всіх гравців: оголошення та таймер подій
---------------------------------------------------------------------

local function buildAnnouncements(gui)
	local holder = UIKit.Create("Frame", {
		Name = "Announcement",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 150),
		Size = UDim2.fromOffset(640, 100),
		BackgroundColor3 = Color3.fromRGB(26, 20, 40),
		Visible = false,
		ZIndex = 60,
		Parent = gui,
	})
	UIKit.Corner(holder, 20)
	local stroke = UIKit.Stroke(holder, Color3.new(1, 1, 1), 5)
	local rainbow = UIKit.Create("UIGradient", { Color = UIKit.Rainbow, Parent = stroke })
	UIKit.Create("UIGradient", { Color = ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(170, 160, 200)), Rotation = 90, Parent = holder })
	local scale = UIKit.AddScale(holder)
	local title = UIKit.Label({
		Position = UDim2.fromOffset(16, 8),
		Size = UDim2.new(1, -32, 0, 26),
		Font = UIKit.Font,
		TextSize = 22,
		TextColor3 = COLORS.Gold,
		Text = "📢 ОГОЛОШЕННЯ",
		ZIndex = 61,
		Parent = holder,
	})
	local body = UIKit.Label({
		Position = UDim2.fromOffset(16, 36),
		Size = UDim2.new(1, -32, 1, -44),
		Font = UIKit.Font,
		TextScaled = true,
		ZIndex = 61,
		Parent = holder,
	})
	UIKit.Create("UITextSizeConstraint", { MaxTextSize = 30, Parent = body })

	local token = 0
	Remotes.Get("Announce").OnClientEvent:Connect(function(text, author)
		token += 1
		local mine = token
		title.Text = "📢 ОГОЛОШЕННЯ" .. (if typeof(author) == "string" then " від " .. author else "")
		body.Text = tostring(text)
		holder.Visible = true
		holder.Size = UDim2.fromOffset(640, 100)
		local base = scale.Scale
		scale.Scale = base * 0.6
		TweenService:Create(scale, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = base }):Play()
		SoundController.Play("Reward")
		task.spawn(function()
			while holder.Visible and token == mine do
				rainbow.Rotation = (rainbow.Rotation + 4) % 360
				task.wait(0.03)
			end
		end)
		task.delay(7, function()
			if token == mine then
				holder.Visible = false
			end
		end)
	end)
end

local function buildEventTimer(gui)
	local pill = UIKit.Create("Frame", {
		Name = "ServerEvents",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 164),
		Size = UDim2.fromOffset(230, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Visible = false,
		Parent = gui,
	})
	UIKit.AddScale(pill)
	UIKit.Create("UIListLayout", { Padding = UDim.new(0, 6), HorizontalAlignment = Enum.HorizontalAlignment.Right, SortOrder = Enum.SortOrder.LayoutOrder, Parent = pill })
	local labels = {}
	for index, kind in { { "Luck", "🍀 Удача", Color3.fromRGB(70, 200, 90) }, { "Income", "💰 Дохід", Color3.fromRGB(240, 170, 30) } } do
		local label = UIKit.Label({
			Size = UDim2.fromOffset(230, 40),
			BackgroundColor3 = kind[3],
			BackgroundTransparency = 0,
			Font = UIKit.Font,
			TextSize = 20,
			LayoutOrder = index,
			Visible = false,
			Parent = pill,
		})
		UIKit.Corner(label, 12)
		UIKit.Stroke(label, UIKit.Colors.Outline, 3)
		UIKit.Shade(label, 0.25)
		labels[kind[1]] = { label = label, name = kind[2] }
	end
	task.spawn(function()
		while true do
			local now = workspace:GetServerTimeNow()
			local any = false
			for kind, entry in labels do
				local multiplier = GameMath.GetEventMultiplier(kind, now)
				local ends = workspace:GetAttribute("Event" .. kind .. "Ends")
				local active = multiplier > 1 and type(ends) == "number"
				entry.label.Visible = active
				if active then
					any = true
					entry.label.Text = ("🎉 %s ×%d • %s"):format(entry.name, multiplier, GameMath.FormatTime(math.max(0, ends - now)))
				end
			end
			pill.Visible = any
			task.wait(1)
		end
	end)
end

function AdminUI.Init(gui)
	buildAnnouncements(gui)
	buildEventTimer(gui)
	-- Панель будуємо лише для адмінів (сервер ставить атрибут; він може прийти трохи пізніше)
	local built = false
	local function check()
		if not built and player:GetAttribute("IsAdmin") == true then
			built = true
			buildPanel(gui)
		end
	end
	player:GetAttributeChangedSignal("IsAdmin"):Connect(check)
	check()
end

return AdminUI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="44">
          <Properties>
            <string name="Name">ClientState</string>
            <string name="Source"><![CDATA[-- ClientState: копія даних гравця на клієнті + запити до сервера.
-- Клієнт нічого не вирішує сам — лише показує те, що надіслав сервер.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Remotes"))

local player = Players.LocalPlayer

local ClientState = {
	Data = nil,
	Coins = 0,
	Crystals = 0,
}

local dataListeners = {}
local currencyListeners = {}
local settingListeners = {}

local function fire(listeners, ...)
	for _, callback in listeners do
		task.spawn(callback, ...)
	end
end

-- callback(data) — викликається при кожному оновленні даних.
function ClientState.OnDataChanged(callback)
	table.insert(dataListeners, callback)
	if ClientState.Data then
		task.spawn(callback, ClientState.Data)
	end
end

-- callback(coins, crystals)
function ClientState.OnCurrencyChanged(callback)
	table.insert(currencyListeners, callback)
	task.spawn(callback, ClientState.Coins, ClientState.Crystals)
end

-- callback(key, value)
function ClientState.OnSettingChanged(callback)
	table.insert(settingListeners, callback)
end

function ClientState.GetSetting(key)
	local data = ClientState.Data
	return data ~= nil and data.settings[key] == true
end

function ClientState.SetSetting(key, value)
	if not ClientState.Data then
		return
	end
	ClientState.Data.settings[key] = value
	fire(settingListeners, key, value)
	task.spawn(ClientState.Request, "SetSetting", key, value)
end

-- Виклик RemoteFunction. Завжди повертає таблицю { ok, message, ... }.
function ClientState.Request(remoteName, ...)
	local remote = Remotes.Get(remoteName)
	local ok, result = pcall(remote.InvokeServer, remote, ...)
	if not ok or type(result) ~= "table" then
		return { ok = false, message = "Сервер не відповідає" }
	end
	return result
end

function ClientState.Init()
	Remotes.Get("DataSync").OnClientEvent:Connect(function(data)
		local oldSettings = ClientState.Data and ClientState.Data.settings
		ClientState.Data = data
		if not oldSettings then
			for key, value in data.settings do
				fire(settingListeners, key, value)
			end
		end
		fire(dataListeners, data)
	end)

	-- Монети змінюються щосекунди, тому читаємо їх з leaderstats, а не з DataSync.
	task.spawn(function()
		local leaderstats = player:WaitForChild("leaderstats")
		local coins = leaderstats:WaitForChild("Coins")
		local crystals = leaderstats:WaitForChild("Crystals")
		local function update()
			ClientState.Coins = coins.Value
			ClientState.Crystals = crystals.Value
			fire(currencyListeners, ClientState.Coins, ClientState.Crystals)
		end
		coins.Changed:Connect(update)
		crystals.Changed:Connect(update)
		update()
	end)
end

return ClientState
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">CombatUI</string>
            <string name="Source"><![CDATA[-- CombatUI: інтерфейс бою — поточна ціль, смуга здоров'я боса з попередженням
-- про атаку, кнопки 🎯 / ✖ / 🏠, цифри шкоди та снаряди героїв.

local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = Shared:WaitForChild("Config")
local CombatConfig = require(Config:WaitForChild("CombatConfig"))
local HeroConfig = require(Config:WaitForChild("HeroConfig"))
local GameMath = require(Shared:WaitForChild("GameMath"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local Client = script.Parent
local UIKit = require(Client:WaitForChild("UIKit"))
local ClientState = require(Client:WaitForChild("ClientState"))
local EnemyRegistry = require(Client:WaitForChild("EnemyRegistry"))
local FollowerController = require(Client:WaitForChild("FollowerController"))

local player = Players.LocalPlayer

local CombatUI = {}

local ui: { [string]: any } = {}

local function makeBar(gui, name, width, color)
	local frame = UIKit.Create("Frame", {
		Name = name,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 68),
		Size = UDim2.fromOffset(width, 50),
		BackgroundColor3 = UIKit.Colors.Background,
		BackgroundTransparency = 0.15,
		Visible = false,
		Parent = gui,
	})
	UIKit.Corner(frame, 12)
	UIKit.Stroke(frame, color, 2)
	local scale = UIKit.AddScale(frame)
	local title = UIKit.Label({
		Position = UDim2.fromOffset(10, 2),
		Size = UDim2.new(1, -20, 0, 22),
		Font = UIKit.Font,
		TextSize = 18,
		TextColor3 = color,
		Parent = frame,
	})
	local back = UIKit.Create("Frame", {
		Position = UDim2.fromOffset(10, 27),
		Size = UDim2.new(1, -20, 0, 16),
		BackgroundColor3 = Color3.fromRGB(40, 25, 35),
		Parent = frame,
	})
	UIKit.Corner(back, 6)
	local fill = UIKit.Create("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = color,
		Parent = back,
	})
	UIKit.Corner(fill, 6)
	local value = UIKit.Label({
		Size = UDim2.fromScale(1, 1),
		TextSize = 13,
		TextStrokeTransparency = 0.4,
		Parent = back,
	})
	return { frame = frame, title = title, fill = fill, value = value, scale = scale }
end

local function setBar(bar, model)
	local health = model:GetAttribute("Health") or 0
	local maxHealth = model:GetAttribute("MaxHealth") or 1
	bar.fill.Size = UDim2.fromScale(math.clamp(health / maxHealth, 0, 1), 1)
	bar.value.Text = GameMath.FormatNumber(math.ceil(health)) .. " / " .. GameMath.FormatNumber(maxHealth)
end

local function findBoss(world)
	for _, model in EnemyRegistry.All() do
		if model.Parent and model:GetAttribute("IsBoss") and model:GetAttribute("World") == world then
			return model
		end
	end
	return nil
end

local function distanceToModel(model)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then
		return math.huge
	end
	return (root.Position - model:GetPivot().Position).Magnitude
end

-- Оновлення щокадру: дешеві операції з атрибутами
local function update()
	local world = player:GetAttribute("World") or "Lobby"
	local inWorld = world ~= "Lobby"
	ui.buttons.Visible = inWorld

	-- Смуга боса
	local boss = if inWorld then findBoss(world) else nil
	local bossVisible = boss ~= nil and distanceToModel(boss) < 140
	ui.boss.frame.Visible = bossVisible
	if bossVisible then
		local attack = boss:GetAttribute("Attack")
		if attack and attack ~= "" then
			ui.boss.title.Text = "⚠️ " .. attack .. "! Вийди з червоного кола!"
			ui.boss.title.TextColor3 = UIKit.Colors.Danger
		else
			ui.boss.title.Text = "👹 " .. (boss:GetAttribute("EnemyName") or "Boss")
			ui.boss.title.TextColor3 = UIKit.Colors.Gold
		end
		setBar(ui.boss, boss)
	end

	-- Поточна ціль (бос уже показаний окремо)
	local target = EnemyRegistry.Get(player:GetAttribute("TargetId"))
	local showTarget = target ~= nil and target ~= boss
	ui.target.frame.Visible = showTarget
	-- Смуги стоять під верхньою панеллю валют (з урахуванням масштабу екрана)
	local scale = ui.boss.scale.Scale
	local top = 8 + 78 * scale -- під верхніми кнопками Worlds / Home / Shop
	ui.boss.frame.Position = UDim2.new(0.5, 0, 0, top)
	ui.target.frame.Position = UDim2.new(0.5, 0, 0, if bossVisible then top + 56 * scale else top)
	if showTarget then
		local outOfRange = distanceToModel(target) > CombatConfig.AttackRange
		ui.target.title.Text = "🎯 " .. (target:GetAttribute("EnemyName") or "?") .. (if outOfRange then "  — підійди ближче!" else "")
		setBar(ui.target, target)
	end
end

local function popDamage(enemyModel, damage, own)
	local hitbox = enemyModel:FindFirstChild("Hitbox")
	if not hitbox then
		return
	end
	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.fromOffset(90, 34)
	billboard.StudsOffsetWorldSpace = Vector3.new(math.random(-20, 20) / 10, hitbox.Size.Y / 2, 0)
	billboard.AlwaysOnTop = true
	billboard.MaxDistance = 100
	billboard.Adornee = hitbox
	local label = UIKit.Label({
		Size = UDim2.fromScale(1, 1),
		Font = UIKit.Font,
		TextScaled = true,
		TextColor3 = if own then UIKit.Colors.Gold else Color3.fromRGB(220, 220, 220),
		TextStrokeTransparency = 0.2,
		Text = GameMath.FormatNumber(damage),
		Parent = billboard,
	})
	billboard.Parent = hitbox
	TweenService:Create(billboard, TweenInfo.new(0.7), { StudsOffsetWorldSpace = billboard.StudsOffsetWorldSpace + Vector3.new(0, 3, 0) }):Play()
	TweenService:Create(label, TweenInfo.new(0.7), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
	Debris:AddItem(billboard, 0.75)
end

local function shootProjectile(fromModel, enemyModel, color)
	local origin = fromModel:GetPivot().Position + Vector3.new(0, 3, 0)
	local hitbox = enemyModel:FindFirstChild("Hitbox")
	local destination = if hitbox then hitbox.Position else enemyModel:GetPivot().Position
	local orb = Instance.new("Part")
	orb.Shape = Enum.PartType.Ball
	orb.Size = Vector3.new(0.9, 0.9, 0.9)
	orb.Material = Enum.Material.Neon
	orb.Color = color
	orb.Anchored = true
	orb.CanCollide = false
	orb.CanQuery = false
	orb.CanTouch = false
	orb.CFrame = CFrame.new(origin)
	orb.Parent = workspace
	TweenService:Create(orb, TweenInfo.new(0.18, Enum.EasingStyle.Linear), { CFrame = CFrame.new(destination) }):Play()
	Debris:AddItem(orb, 0.2)
end

local function onCombatFx(events)
	local effects = ClientState.GetSetting("effects") or ClientState.Data == nil
	for _, event in events do
		local userId, slot, enemyId, damage = event[1], event[2], event[3], event[4]
		local enemyModel = EnemyRegistry.Get(enemyId)
		if enemyModel and distanceToModel(enemyModel) < 150 then
			local own = userId == player.UserId
			if effects then
				local follower = FollowerController.GetModel(userId, slot)
				if follower then
					local heroDef = HeroConfig.Heroes[follower:GetAttribute("HeroId") or ""]
					local color = if heroDef then HeroConfig.ElementColors[heroDef.element] else UIKit.Colors.Accent2
					shootProjectile(follower, enemyModel, color or UIKit.Colors.Accent2)
				end
			end
			-- Цифри шкоди: свої завжди, чужі — лише з увімкненими ефектами
			if own or effects then
				popDamage(enemyModel, damage, own)
			end
		end
	end
end

local function request(action)
	local result = ClientState.Request("CombatAction", action)
	UIKit.Toast(result.message or "", if result.ok then "info" else "error")
end

local function buildButtons(gui)
	local column = UIKit.Create("Frame", {
		Name = "CombatButtons",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
		Size = UDim2.fromOffset(150, 220),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = gui,
	})
	UIKit.AddScale(column)
	UIKit.Create("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder, Parent = column })
	UIKit.Button({ LayoutOrder = 1, Size = UDim2.fromOffset(150, 64), BackgroundColor3 = UIKit.Colors.Danger, Text = "🎯 Target", TextSize = 22, Parent = column }, function()
		request("TargetNearest")
	end)
	UIKit.Button({ LayoutOrder = 2, Size = UDim2.fromOffset(150, 56), BackgroundColor3 = UIKit.Colors.PanelLight, Text = "✖ Stop", TextSize = 20, Parent = column }, function()
		request("Clear")
	end)
	UIKit.Button({ LayoutOrder = 3, Size = UDim2.fromOffset(150, 56), BackgroundColor3 = UIKit.Colors.Accent, Text = "🏠 Lobby", TextSize = 20, Parent = column }, function()
		local result = ClientState.Request("Travel", "Lobby")
		UIKit.Toast(result.message or "", if result.ok then "success" else "error")
	end)
	ui.buttons = column
end

function CombatUI.Init(gui)
	ui.boss = makeBar(gui, "BossBar", 520, UIKit.Colors.Gold)
	ui.target = makeBar(gui, "TargetBar", 380, UIKit.Colors.Danger)
	buildButtons(gui)
	RunService.Heartbeat:Connect(update)
	Remotes.Get("CombatFx").OnClientEvent:Connect(onCombatFx)
end

return CombatUI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="46">
          <Properties>
            <string name="Name">EnemyRegistry</string>
            <string name="Source"><![CDATA[-- EnemyRegistry: швидкий пошук моделі ворога за EnemyId на клієнті.
-- Сервер позначає всіх ворогів тегом "Enemy" (CollectionService).

local CollectionService = game:GetService("CollectionService")

local EnemyRegistry = {}

local TAG = "Enemy" -- той самий тег, що EnemyService.TAG на сервері
local byId = {}

local function add(model)
	local id = model:GetAttribute("EnemyId")
	if id then
		byId[id] = model
	end
end

local function remove(model)
	local id = model:GetAttribute("EnemyId")
	if id and byId[id] == model then
		byId[id] = nil
	end
end

function EnemyRegistry.Get(enemyId)
	local model = enemyId and byId[enemyId]
	if model and model.Parent then
		return model
	end
	return nil
end

-- Усі вороги (наприклад, щоб знайти боса поточного світу).
function EnemyRegistry.All()
	return byId
end

function EnemyRegistry.Init()
	CollectionService:GetInstanceAddedSignal(TAG):Connect(add)
	CollectionService:GetInstanceRemovedSignal(TAG):Connect(remove)
	for _, model in CollectionService:GetTagged(TAG) do
		add(model)
	end
end

return EnemyRegistry
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="47">
          <Properties>
            <string name="Name">FollowerController</string>
            <string name="Source"><![CDATA[-- FollowerController: герої бойової команди йдуть за своїм гравцем.
-- Моделі будує кожен клієнт сам (за атрибутом гравця "TeamData"), тому рух
-- плавний і не навантажує мережу. Сервер від цього нічого не "вірить" —
-- шкоду все одно рахує тільки він.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = Shared:WaitForChild("Config")
local CombatConfig = require(Config:WaitForChild("CombatConfig"))
local HeroConfig = require(Config:WaitForChild("HeroConfig"))
local GameMath = require(Shared:WaitForChild("GameMath"))
local HeroModelBuilder = require(Shared:WaitForChild("HeroModelBuilder"))

local Client = script.Parent
local EnemyRegistry = require(Client:WaitForChild("EnemyRegistry"))

local FollowerController = {}

local followers = {} -- [Player] = { key = string, models = { [slot] = Model }, positions = {} }
local folder = nil

local function clear(entry)
	for _, model in entry.models do
		model:Destroy()
	end
	entry.models = {}
	entry.positions = {}
end

local function rebuild(player)
	local entry = followers[player]
	if not entry then
		entry = { key = nil, models = {}, positions = {} }
		followers[player] = entry
	end
	local teamData = player:GetAttribute("TeamData") or ""
	if teamData == entry.key then
		return
	end
	entry.key = teamData
	clear(entry)

	local slot = 0
	for token in string.gmatch(teamData .. ";", "([^;]*);") do
		slot += 1
		local heroId, level, flag = string.match(token, "^([%w_]+):(%d+):?(%a?)$")
		local awakened = flag == "A"
		local heroDef = heroId and HeroConfig.Heroes[heroId]
		if heroDef and slot <= CombatConfig.TeamSize then
			local heroLevel = tonumber(level) or 1
			local damage = GameMath.GetHeroDamage(heroDef, heroLevel, awakened)
			local model = HeroModelBuilder.Build(heroDef, heroLevel, "⚔️ " .. GameMath.FormatNumber(math.floor(damage)), awakened)
			model.Name = ("%s_%d"):format(player.Name, slot)
			model:SetAttribute("HeroId", heroDef.id)
			model:ScaleTo(CombatConfig.FollowerScale)
			model.Parent = folder
			entry.models[slot] = model
		end
	end
end

local function watchPlayer(player)
	rebuild(player)
	player:GetAttributeChangedSignal("TeamData"):Connect(function()
		rebuild(player)
	end)
end

-- Модель героя-супутника (для ефектів атаки).
function FollowerController.GetModel(userId, slot)
	local player = Players:GetPlayerByUserId(userId)
	local entry = player and followers[player]
	return entry and entry.models[slot]
end

local function update(dt)
	local alpha = 1 - math.exp(-8 * dt)
	local time = os.clock()
	for player, entry in followers do
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if root and humanoid and next(entry.models) then
			local groundY = root.Position.Y - humanoid.HipHeight - root.Size.Y / 2
			local base = CFrame.new(root.Position.X, groundY, root.Position.Z) * root.CFrame.Rotation
			local target = EnemyRegistry.Get(player:GetAttribute("TargetId"))
			local targetPosition = target and target:GetPivot().Position

			for slot, model in entry.models do
				local offset = CombatConfig.FollowerOffsets[slot] or Vector3.zero
				local bob = math.sin(time * 3 + slot) * 0.25 + 0.3
				local desired = (base * CFrame.new(offset)).Position + Vector3.new(0, bob, 0)
				local current = entry.positions[slot]
				if not current or (current - desired).Magnitude > 60 then
					current = desired -- телепорт або перша поява
				else
					current = current:Lerp(desired, alpha)
				end
				entry.positions[slot] = current

				-- Дивимось на ціль, а без цілі — туди ж, куди гравець
				local lookPoint = if targetPosition then targetPosition else current + root.CFrame.LookVector * 10
				lookPoint = Vector3.new(lookPoint.X, current.Y, lookPoint.Z)
				if (lookPoint - current).Magnitude > 0.1 then
					model:PivotTo(CFrame.lookAt(current, lookPoint))
				end
			end
		end
	end
end

function FollowerController.Init()
	folder = Instance.new("Folder")
	folder.Name = "LocalFollowers"
	folder.Parent = workspace

	Players.PlayerAdded:Connect(watchPlayer)
	Players.PlayerRemoving:Connect(function(player)
		local entry = followers[player]
		if entry then
			clear(entry)
			followers[player] = nil
		end
	end)
	for _, player in Players:GetPlayers() do
		watchPlayer(player)
	end
	RunService.RenderStepped:Connect(update)
end

return FollowerController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="48">
          <Properties>
            <string name="Name">Hud</string>
            <string name="Source"><![CDATA[-- Hud: головний екран у стилі аніме-симуляторів.
--
--   зверху по центру     — 🌍 Worlds / 🏠 Home / 💎 Shop
--   ліворуч              — великі кнопки 📜 Quests, ♻️ Rebirth, 📖 Index
--   внизу по центру      — ⚔️ Team, 🎒 Backpack, великий 🎲 ROLL, ⬆️ Upgrades
--   над ROLL             — вибір кубика
--   внизу ліворуч        — гроші, кристали й дохід
--   внизу праворуч       — Auto Roll і поточна удача 🍀
--   вгорі праворуч       — ⚙️ та активні зілля
--
-- Інші модулі змінюють поведінку кнопок через Hud.SetAction і читають їх через Hud.Get.

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameMath = require(Shared:WaitForChild("GameMath"))
local Config = Shared:WaitForChild("Config")
local CombatConfig = require(Config:WaitForChild("CombatConfig"))
local ShopConfig = require(Config:WaitForChild("ShopConfig"))

local Client = script.Parent
local UIKit = require(Client:WaitForChild("UIKit"))
local ClientState = require(Client:WaitForChild("ClientState"))

local Hud = {}

local panels = {} -- [name] = Frame
local elements = {} -- [name] = кнопка або напис
local actions = {} -- [name] = функція, що замінює стандартну дію кнопки

-- Кнопка відкриває вікно з такою назвою (якщо назви різні)
local PANEL_FOR = {
	Backpack = "Inventory",
	Dice = "Roll",
	Index = "Quests",
}

local COLORS = {
	Worlds = Color3.fromRGB(255, 185, 40),
	Home = Color3.fromRGB(60, 165, 255),
	Shop = Color3.fromRGB(60, 205, 85),
	Quests = Color3.fromRGB(255, 150, 40),
	Rebirth = Color3.fromRGB(255, 65, 90),
	Index = Color3.fromRGB(70, 130, 255),
	Team = Color3.fromRGB(255, 120, 60),
	Backpack = Color3.fromRGB(135, 85, 255),
	Roll = Color3.fromRGB(190, 70, 255),
	Upgrades = Color3.fromRGB(70, 205, 100),
	Settings = Color3.fromRGB(110, 110, 150),
}
Hud.Colors = COLORS

local updateHint = function() end

-- Розмиття світу позаду відкритого вікна (лише на екрані цього гравця)
local blur = Instance.new("BlurEffect")
blur.Name = "PanelBlur"
blur.Size = 0
blur.Parent = Lighting

local function anyPanelOpen()
	for _, panel in panels do
		if panel.Visible then
			return true
		end
	end
	return false
end

function Hud.RegisterPanel(name, panel)
	panels[name] = panel
	-- Підказка навчання ховається, поки відкрите будь-яке вікно
	panel:GetPropertyChangedSignal("Visible"):Connect(function()
		updateHint()
		local open = false
		for _, other in panels do
			open = open or other.Visible
		end
		TweenService:Create(blur, TweenInfo.new(0.2), { Size = if open then 14 else 0 }):Play()
	end)
end

function Hud.OpenPanel(name)
	for panelName, panel in panels do
		panel.Visible = panelName == name
	end
end

function Hud.TogglePanel(name)
	local target = panels[name]
	if not target then
		return
	end
	if target.Visible then
		target.Visible = false
	else
		Hud.OpenPanel(name)
	end
end

function Hud.IsPanelOpen(name)
	return panels[name] ~= nil and panels[name].Visible
end

-- Замінити дію кнопки (наприклад, ROLL кидає кубик, а не відкриває вікно).
function Hud.SetAction(name, callback)
	actions[name] = callback
end

-- Кнопка або напис головного екрана за назвою.
function Hud.Get(name)
	return elements[name]
end

Hud.GetMenuButton = Hud.Get

-- Червона позначка на кнопці: true — "!", число — лічильник, false — сховати.
function Hud.SetBadge(name, value)
	local button = elements[name]
	if button then
		UIKit.SetBadge(button, value)
	end
end

local function press(name)
	if actions[name] then
		actions[name]()
	else
		Hud.TogglePanel(PANEL_FOR[name] or name)
	end
end

---------------------------------------------------------------------
-- Зверху: Worlds / Home / Shop
---------------------------------------------------------------------

local function buildTopNav(gui)
	local bar = UIKit.Create("Frame", {
		Name = "TopNav",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 6),
		Size = UDim2.fromOffset(660, 66),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	UIKit.AddScale(bar)
	UIKit.Create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		Padding = UDim.new(0, 12),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = bar,
	})
	for index, name in { "Worlds", "Home", "Shop" } do
		local button = UIKit.Button({
			Name = name,
			LayoutOrder = index,
			Size = UDim2.fromOffset(205, 62),
			BackgroundColor3 = COLORS[name],
			Text = "",
			Parent = bar,
		}, function()
			press(name)
		end)
		button.Outline.UIStroke.Thickness = 4
		-- Іконка ліворуч, що трохи виходить за межі кнопки (як у симуляторах)
		UIKit.Icon({
			Key = name,
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0, 2, 0.5, -2),
			Size = UDim2.fromOffset(62, 62),
			Parent = button,
		})
		UIKit.Label({
			Name = "Caption",
			Position = UDim2.fromOffset(66, 4),
			Size = UDim2.new(1, -74, 1, -8),
			Font = UIKit.Font,
			TextScaled = true,
			Text = name,
			Outline = 3,
			Parent = button,
		})
		elements[name] = button
	end
end

---------------------------------------------------------------------
-- Ліворуч: великі квадратні кнопки
---------------------------------------------------------------------

local function buildLeftColumn(gui)
	local column = UIKit.Create("Frame", {
		Name = "LeftButtons",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 12, 0.5, -24),
		Size = UDim2.fromOffset(104, 336),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	UIKit.AddScale(column)
	UIKit.Create("UIListLayout", { Padding = UDim.new(0, 12), SortOrder = Enum.SortOrder.LayoutOrder, Parent = column })
	for index, entry in { { "Quests", "📜", "Quests" }, { "Rebirth", "♻️", "Rebirth" }, { "Index", "📖", "Index" } } do
		local name = entry[1]
		elements[name] = UIKit.IconButton({
			Name = name,
			IconKey = name,
			Icon = entry[2],
			Text = entry[3],
			Color = COLORS[name],
			Size = UDim2.fromOffset(104, 104),
			LayoutOrder = index,
			Parent = column,
		}, function()
			press(name)
		end)
	end
end

---------------------------------------------------------------------
-- Внизу по центру: Team, Backpack, ROLL, Upgrades + вибір кубика
---------------------------------------------------------------------

local function buildBottomBar(gui)
	local bar = UIKit.Create("Frame", {
		Name = "BottomBar",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -8),
		Size = UDim2.fromOffset(520, 146),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	UIKit.AddScale(bar)
	UIKit.Create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		VerticalAlignment = Enum.VerticalAlignment.Bottom,
		Padding = UDim.new(0, 14),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = bar,
	})
	local items = {
		{ "Team", "⚔️", "TEAM", 104 },
		{ "Backpack", "🎒", "BACKPACK", 104 },
		{ "Roll", "🎲", "ROLL", 142, "🎁 FREE" },
		{ "Upgrades", "⬆️", "UPGRADES", 104 },
	}
	for index, item in items do
		local name = item[1]
		elements[name] = UIKit.IconButton({
			Name = name,
			IconKey = name,
			Icon = item[2],
			Text = item[3],
			Sub = item[5],
			Color = COLORS[name],
			Size = UDim2.fromOffset(item[4], item[4]),
			LayoutOrder = index,
			Parent = bar,
		}, function()
			press(name)
		end)
	end

	-- Іконка ROLL "дихає", щоб привертати увагу
	local rollScale = UIKit.Create("UIScale", { Parent = elements.Roll.Icon })
	TweenService:Create(rollScale, TweenInfo.new(0.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Scale = 1.12 }):Play()

	-- Вибір кубика над ROLL
	local dice = UIKit.Button({
		Name = "Dice",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -162),
		Size = UDim2.fromOffset(240, 40),
		BackgroundColor3 = UIKit.Colors.Panel,
		Text = "🎲 Basic Dice ▾",
		TextSize = 20,
		Parent = gui,
	}, function()
		press("Dice")
	end)
	UIKit.AddScale(dice)
	elements.Dice = dice
end

---------------------------------------------------------------------
-- Внизу ліворуч: гроші
---------------------------------------------------------------------

local function buildMoney(gui)
	local frame = UIKit.Create("Frame", {
		Name = "Money",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 14, 1, -10),
		Size = UDim2.fromOffset(270, 110),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	UIKit.AddScale(frame)
	UIKit.Icon({ Key = "Coin", Position = UDim2.fromOffset(0, 2), Size = UDim2.fromOffset(58, 58), Parent = frame })
	UIKit.Icon({ Key = "Crystal", Position = UDim2.fromOffset(0, 66), Size = UDim2.fromOffset(34, 34), Parent = frame })
	local coins = UIKit.Label({
		Name = "Coins",
		Position = UDim2.fromOffset(64, 0),
		Size = UDim2.new(1, -64, 0, 62),
		Font = UIKit.Font,
		TextScaled = true,
		TextColor3 = UIKit.Colors.Money,
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = "...",
		Outline = 4,
		Parent = frame,
	})
	UIKit.Shade(coins, 0.25)
	local crystals = UIKit.Label({
		Name = "Crystals",
		Position = UDim2.fromOffset(38, 64),
		Size = UDim2.fromOffset(84, 36),
		Font = UIKit.Font,
		TextScaled = true,
		TextColor3 = UIKit.Colors.Accent2,
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = "0",
		Outline = 3,
		Parent = frame,
	})
	local income = UIKit.Label({
		Name = "Income",
		Position = UDim2.fromOffset(126, 64),
		Size = UDim2.fromOffset(144, 36),
		Font = UIKit.Font,
		TextScaled = true,
		TextColor3 = UIKit.Colors.Gold,
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = "⚡ +0/s",
		Outline = 3,
		Parent = frame,
	})
	elements.Coins, elements.Crystals, elements.Income = coins, crystals, income

	local lastCoins = nil
	ClientState.OnCurrencyChanged(function(coinsValue, crystalsValue)
		coins.Text = GameMath.FormatNumber(coinsValue)
		crystals.Text = GameMath.FormatNumber(crystalsValue)
		-- Маленький "стрибок" при отриманні монет
		if lastCoins and coinsValue > lastCoins then
			coins.Size = UDim2.new(1, -64, 0, 68)
			TweenService:Create(coins, TweenInfo.new(0.2), { Size = UDim2.new(1, -64, 0, 62) }):Play()
		end
		lastCoins = coinsValue
	end)

	-- Дохід залежить і від часу (буст може закінчитись), тому оновлюємо щосекунди
	local function updateIncome()
		local data = ClientState.Data
		if data then
			income.Text = "⚡ +" .. GameMath.FormatNumber(GameMath.GetTotalIncome(data, workspace:GetServerTimeNow())) .. "/s"
		end
	end
	ClientState.OnDataChanged(updateIncome)
	task.spawn(function()
		while true do
			task.wait(1)
			updateIncome()
		end
	end)
end

---------------------------------------------------------------------
-- Внизу праворуч: Auto Roll та удача
---------------------------------------------------------------------

local function buildLuck(gui)
	local frame = UIKit.Create("Frame", {
		Name = "LuckArea",
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -14, 1, -10),
		Size = UDim2.fromOffset(160, 160),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	UIKit.AddScale(frame)
	elements.Auto = UIKit.Button({
		Name = "Auto",
		Size = UDim2.fromOffset(160, 46),
		BackgroundColor3 = UIKit.Colors.Disabled,
		Text = "🔒 AUTO",
		TextSize = 22,
		Parent = frame,
	}, function()
		press("Auto")
	end)
	UIKit.Icon({
		Name = "Clover",
		Key = "Luck",
		Position = UDim2.fromOffset(40, 52),
		Size = UDim2.fromOffset(80, 66),
		Parent = frame,
	})
	elements.Luck = UIKit.Label({
		Name = "Luck",
		Position = UDim2.fromOffset(0, 116),
		Size = UDim2.fromOffset(160, 40),
		Font = UIKit.Font,
		TextScaled = true,
		Text = "x1",
		Outline = 3,
		Parent = frame,
	})
end

---------------------------------------------------------------------
-- Вгорі праворуч: налаштування й зілля
---------------------------------------------------------------------

local function buildTopRight(gui)
	local settings = UIKit.Button({
		Name = "Settings",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 8),
		Size = UDim2.fromOffset(58, 58),
		BackgroundColor3 = COLORS.Settings,
		Text = "",
		Parent = gui,
	}, function()
		press("Settings")
	end)
	UIKit.Icon({ Key = "Settings", Position = UDim2.fromScale(0.1, 0.1), Size = UDim2.fromScale(0.8, 0.8), Parent = settings })
	UIKit.AddScale(settings)
	elements.Settings = settings

	local bar = UIKit.Create("Frame", {
		Name = "Boosts",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 76),
		Size = UDim2.fromOffset(200, 80),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	UIKit.AddScale(bar)
	UIKit.Create("UIListLayout", {
		Padding = UDim.new(0, 6),
		HorizontalAlignment = Enum.HorizontalAlignment.Right,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = bar,
	})
	local labels = {}
	local order = 0
	for boostId, boost in ShopConfig.Boosts do
		order += 1
		local label = UIKit.Label({
			LayoutOrder = order,
			Size = UDim2.fromOffset(200, 34),
			BackgroundColor3 = UIKit.Colors.Success,
			BackgroundTransparency = 0,
			Font = UIKit.Font,
			TextSize = 18,
			Visible = false,
			Parent = bar,
		})
		UIKit.Corner(label, 10)
		UIKit.Stroke(label, UIKit.Colors.Outline, 3)
		UIKit.Shade(label, 0.25)
		labels[boostId] = { label = label, boost = boost }
	end
	task.spawn(function()
		while true do
			local data = ClientState.Data
			local now = workspace:GetServerTimeNow()
			for boostId, entry in labels do
				local active = data ~= nil and GameMath.IsBoostActive(data, boostId, now)
				entry.label.Visible = active
				if active then
					entry.label.Text = ("%s ×%d  %s"):format(entry.boost.displayName, entry.boost.multiplier, GameMath.FormatTime(data.boosts[boostId] - now))
				end
			end
			task.wait(1)
		end
	end)
end

---------------------------------------------------------------------
-- Підказка навчання над кнопкою ROLL
---------------------------------------------------------------------

local function buildTutorialHint(gui)
	local hint = UIKit.Label({
		Name = "TutorialHint",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -212),
		Size = UDim2.fromOffset(600, 48),
		BackgroundColor3 = UIKit.Colors.Gold,
		BackgroundTransparency = 0,
		Font = UIKit.Font,
		TextSize = 22,
		Visible = false,
		Parent = gui,
	})
	UIKit.Corner(hint, 14)
	UIKit.Stroke(hint, UIKit.Colors.Outline, 3)
	UIKit.AddScale(hint)
	-- Підказка м'яко гойдається
	TweenService:Create(hint, TweenInfo.new(0.7, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Position = UDim2.new(0.5, 0, 1, -220) }):Play()

	local function teamIsEmpty(data)
		for i = 1, CombatConfig.TeamSize do
			if data.team[i] ~= "" then
				return false
			end
		end
		return true
	end

	updateHint = function()
		local data = ClientState.Data
		local text = nil
		if not data then
			text = nil
		elseif not data.tutorial.freeRollUsed then
			text = "👇 Натисни великий 🎲 ROLL — перший кидок безкоштовний!"
		elseif not data.tutorial.completed then
			text = "👇 Відкрий 🎒 BACKPACK, вибери героя й натисни Place"
		elseif teamIsEmpty(data) and data.totalRolls >= 5 and data.stats.enemiesDefeated == 0 then
			text = "⚔️ Збери TEAM і вирушай у 🌍 Worlds → Ninja Village"
		end
		if text then
			hint.Text = text
		end
		hint.Visible = text ~= nil and not anyPanelOpen()
	end
	ClientState.OnDataChanged(function()
		updateHint()
	end)
end

function Hud.Init(gui)
	buildTopNav(gui)
	buildLeftColumn(gui)
	buildBottomBar(gui)
	buildMoney(gui)
	buildLuck(gui)
	buildTopRight(gui)
	buildTutorialHint(gui)

	-- Home: повернення на свою базу з будь-якого світу
	Hud.SetAction("Home", function()
		local result = ClientState.Request("Travel", "Lobby")
		UIKit.Toast(result.message or "", if result.ok then "success" else "error")
	end)
end

return Hud
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="49">
          <Properties>
            <string name="Name">InventoryUI</string>
            <string name="Source"><![CDATA[-- InventoryUI: сітка героїв, сортування, Equip Best і дії з вибраним героєм
-- (Place / Remove, Lock, Merge, Sell). Кожна дія — запит до сервера.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = Shared:WaitForChild("Config")
local HeroConfig = require(Config:WaitForChild("HeroConfig"))
local RarityConfig = require(Config:WaitForChild("RarityConfig"))
local GameMath = require(Shared:WaitForChild("GameMath"))

local Client = script.Parent
local UIKit = require(Client:WaitForChild("UIKit"))
local ClientState = require(Client:WaitForChild("ClientState"))
local Hud = require(Client:WaitForChild("Hud"))

local InventoryUI = {}

local SORTS = {
	{ id = "rarity", label = "Рідкість" },
	{ id = "income", label = "Дохід" },
	{ id = "level", label = "Рівень" },
	{ id = "newest", label = "Нові" },
}

local sortIndex = 1
local selectedUid = nil
local busy = false
local dirty = true
local ui: { [string]: any } = {}

local function getPlacedSet(data)
	local placed = {}
	for i = 1, data.slotCount do
		local uid = data.slots[i]
		if uid ~= "" then
			placed[uid] = true
		end
	end
	return placed
end

local function getSortedHeroes(data)
	local mode = SORTS[sortIndex].id
	local list = {}
	for uid, hero in data.heroes do
		local heroDef = HeroConfig.Heroes[hero.id]
		if heroDef then
			table.insert(list, {
				uid = uid,
				hero = hero,
				def = heroDef,
				rank = RarityConfig.GetRank(heroDef.rarity),
				income = GameMath.GetHeroIncome(heroDef, hero.level, data.incomeLevel, hero.awakened),
				number = tonumber(string.sub(uid, 2)) or 0,
			})
		end
	end
	table.sort(list, function(a, b)
		if mode == "rarity" then
			if a.rank ~= b.rank then
				return a.rank > b.rank
			end
			if a.income ~= b.income then
				return a.income > b.income
			end
		elseif mode == "income" then
			if a.income ~= b.income then
				return a.income > b.income
			end
		elseif mode == "level" then
			if a.hero.level ~= b.hero.level then
				return a.hero.level > b.hero.level
			end
		end
		return a.number > b.number -- новіші вище
	end)
	return list
end

local function countDuplicates(data, uid, heroId)
	local count = 0
	local placed = getPlacedSet(data)
	for otherUid, other in data.heroes do
		if otherUid ~= uid and other.id == heroId and not other.locked and not placed[otherUid] and not GameMath.IsInTeam(data, otherUid) then
			count += 1
		end
	end
	return count
end

local refreshAll -- оголошена нижче

local function request(action, uid)
	if busy then
		return
	end
	busy = true
	local result = ClientState.Request("InventoryAction", action, uid)
	busy = false
	UIKit.Toast(result.message or "", if result.ok then "success" else "error")
	if result.ok and action == "Sell" then
		selectedUid = nil
	end
end

local function makeCard(entry, placed, order)
	local color = RarityConfig.GetColor(entry.def.rarity)
	local card = UIKit.Create("TextButton", {
		Name = entry.uid,
		LayoutOrder = order,
		BackgroundColor3 = color:Lerp(UIKit.Colors.Background, 0.6),
		AutoButtonColor = true,
		Text = "",
		Parent = ui.grid,
	})
	UIKit.Corner(card, 12)
	UIKit.Shade(card, 0.3)
	UIKit.HeroPortrait(card, entry.def.id)
	local selected = entry.uid == selectedUid
	UIKit.Stroke(card, if selected then Color3.new(1, 1, 1) elseif entry.hero.awakened then UIKit.Colors.Gold else color, if selected then 4 else 3)

	UIKit.Label({
		Position = UDim2.fromOffset(4, 4),
		Size = UDim2.new(1, -8, 0, 38),
		Font = UIKit.Font,
		TextSize = 15,
		TextColor3 = if entry.hero.awakened then UIKit.Colors.Gold else color,
		Text = (if entry.hero.awakened then "✨" else "") .. GameMath.GetHeroName(entry.def, entry.hero.awakened),
		Parent = card,
	})
	UIKit.Label({
		Position = UDim2.fromOffset(4, 44),
		Size = UDim2.new(1, -8, 0, 20),
		TextSize = 14,
		Text = ("Lv %d • +%s/s"):format(entry.hero.level, GameMath.FormatNumber(entry.income)),
		Parent = card,
	})
	local icons = (HeroConfig.ElementIcons[entry.def.element] or "")
		.. (if placed[entry.uid] then " 🏠" else "")
		.. (if GameMath.IsInTeam(ClientState.Data, entry.uid) then " ⚔️" else "")
		.. (if entry.hero.locked then " 🔒" else "")
	UIKit.Label({
		Position = UDim2.fromOffset(4, 66),
		Size = UDim2.new(1, -8, 0, 22),
		TextSize = 16,
		Text = icons,
		Parent = card,
	})

	card.Activated:Connect(function()
		selectedUid = entry.uid
		refreshAll()
	end)
end

local function refreshDetails(data, placed)
	local hero = selectedUid and data.heroes[selectedUid]
	local heroDef = hero and HeroConfig.Heroes[hero.id]
	ui.details.Visible = heroDef ~= nil
	ui.emptyDetails.Visible = heroDef == nil
	if not heroDef then
		selectedUid = nil
		return
	end
	local rarityInfo = RarityConfig.Info[heroDef.rarity]
	local isPlaced = placed[selectedUid] == true
	ui.detailText.Text = ("<font color=\"#%s\"><b>%s</b> (%s)</font>\n%s %s • %s • Lv %d/%d\n⚔️ %s  ⏱ %.1f/s  🪙 +%s/s\n✦ %s: %s"):format(
		(if hero.awakened then UIKit.Colors.Gold else rarityInfo.color):ToHex(),
		(if hero.awakened then "✨ " else "") .. GameMath.GetHeroName(heroDef, hero.awakened),
		heroDef.rarity,
		HeroConfig.ElementIcons[heroDef.element] or "",
		heroDef.element,
		heroDef.archetype,
		hero.level,
		rarityInfo.maxLevel,
		GameMath.FormatNumber(GameMath.GetHeroDamage(heroDef, hero.level, hero.awakened)),
		heroDef.attackSpeed,
		GameMath.FormatNumber(GameMath.GetHeroIncome(heroDef, hero.level, data.incomeLevel, hero.awakened)),
		heroDef.ability.name,
		heroDef.ability.description
	)

	ui.placeButton.Text = if isPlaced then "🏠 Remove" else "🏠 Place"
	ui.placeButton.BackgroundColor3 = if isPlaced then UIKit.Colors.PanelLight else UIKit.Colors.Success
	ui.lockButton.Text = if hero.locked then "🔓 Unlock" else "🔒 Lock"
	local duplicates = countDuplicates(data, selectedUid, hero.id)
	ui.mergeButton.Text = ("⬆️ Merge (%d)"):format(duplicates)
	ui.mergeButton.BackgroundColor3 = if duplicates > 0 and hero.level < rarityInfo.maxLevel then UIKit.Colors.Accent else UIKit.Colors.Disabled
	local canSell = not hero.locked and not isPlaced and not GameMath.IsInTeam(data, selectedUid)
	ui.sellButton.Text = "💰 Sell " .. GameMath.FormatNumber(GameMath.GetSellPrice(heroDef, hero.level))
	ui.sellButton.BackgroundColor3 = if canSell then UIKit.Colors.Gold:Lerp(UIKit.Colors.Danger, 0.3) else UIKit.Colors.Disabled

	local canAwaken, _, cost = GameMath.CanAwaken(heroDef, hero)
	if hero.awakened then
		ui.awakenButton.Text = "✨ Пробуджено"
		ui.awakenButton.BackgroundColor3 = UIKit.Colors.Disabled
	else
		ui.awakenButton.Text = ("✨ Awaken %d💎"):format(cost)
		ui.awakenButton.BackgroundColor3 = if canAwaken and ClientState.Crystals >= cost then UIKit.Colors.Gold else UIKit.Colors.Disabled
	end
end

function refreshAll()
	local data = ClientState.Data
	if not data then
		return
	end
	if not ui.panel.Visible then
		dirty = true -- оновимо, коли вікно відкриють
		return
	end
	dirty = false

	for _, child in ui.grid:GetChildren() do
		if child:IsA("GuiButton") then
			child:Destroy()
		end
	end
	local placed = getPlacedSet(data)
	local list = getSortedHeroes(data)
	for order, entry in list do
		makeCard(entry, placed, order)
	end
	ui.countLabel.Text = ("Герої: %d / %d"):format(#list, GameMath.GetMaxInventory(data))
	ui.sortButton.Text = "↕ " .. SORTS[sortIndex].label
	refreshDetails(data, placed)
end

local function buildPanel(gui)
	local panel, content = UIKit.Panel(gui, "Inventory", "🎒 Backpack", Color3.fromRGB(135, 85, 255))
	ui.panel = panel
	Hud.RegisterPanel("Inventory", panel)
	panel:GetPropertyChangedSignal("Visible"):Connect(function()
		if panel.Visible and dirty then
			refreshAll()
		end
	end)

	-- Верхній рядок
	ui.countLabel = UIKit.Label({
		Size = UDim2.fromOffset(240, 40),
		Font = UIKit.Font,
		TextSize = 20,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = content,
	})
	ui.sortButton = UIKit.Button({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -190, 0, 0),
		Size = UDim2.fromOffset(170, 40),
		BackgroundColor3 = UIKit.Colors.PanelLight,
		TextSize = 18,
		Parent = content,
	}, function()
		sortIndex = sortIndex % #SORTS + 1
		refreshAll()
	end)
	UIKit.Button({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 0),
		Size = UDim2.fromOffset(180, 40),
		BackgroundColor3 = UIKit.Colors.Success,
		TextSize = 18,
		Text = "⭐ Equip Best",
		Parent = content,
	}, function()
		request("EquipBest")
	end)

	-- Сітка героїв
	ui.grid = UIKit.Create("ScrollingFrame", {
		Position = UDim2.fromOffset(0, 48),
		Size = UDim2.new(1, 0, 1, -48 - 112),
		BackgroundColor3 = UIKit.Colors.Background,
		BackgroundTransparency = 0.4,
		BorderSizePixel = 0,
		ScrollBarThickness = 8,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Parent = content,
	})
	UIKit.Corner(ui.grid, 12)
	UIKit.Create("UIGridLayout", {
		CellSize = UDim2.fromOffset(112, 92),
		CellPadding = UDim2.fromOffset(8, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = ui.grid,
	})
	UIKit.Create("UIPadding", {
		PaddingTop = UDim.new(0, 8),
		PaddingLeft = UDim.new(0, 8),
		PaddingRight = UDim.new(0, 8),
		PaddingBottom = UDim.new(0, 8),
		Parent = ui.grid,
	})

	-- Нижня панель із деталями вибраного героя
	local bottom = UIKit.Create("Frame", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.new(1, 0, 0, 104),
		BackgroundColor3 = UIKit.Colors.Background,
		BackgroundTransparency = 0.3,
		Parent = content,
	})
	UIKit.Corner(bottom, 12)

	ui.emptyDetails = UIKit.Label({
		Size = UDim2.fromScale(1, 1),
		TextColor3 = UIKit.Colors.SubText,
		Text = "Вибери героя, щоб поставити його на базу, заблокувати, злити або продати",
		Parent = bottom,
	})

	ui.details = UIKit.Create("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = bottom })
	ui.detailText = UIKit.Label({
		Position = UDim2.fromOffset(10, 4),
		Size = UDim2.new(1, -456, 1, -8),
		TextSize = 14,
		RichText = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		Parent = ui.details,
	})
	local actions = UIKit.Create("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -8, 0.5, 0),
		Size = UDim2.fromOffset(440, 92),
		BackgroundTransparency = 1,
		Parent = ui.details,
	})
	UIKit.Create("UIGridLayout", {
		CellSize = UDim2.fromOffset(140, 43),
		CellPadding = UDim2.fromOffset(8, 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = actions,
	})
	local function actionButton(order, callback)
		local button = UIKit.Button({ LayoutOrder = order, TextSize = 17, Parent = actions }, callback)
		return button
	end
	ui.placeButton = actionButton(1, function()
		local data = ClientState.Data
		if data and selectedUid then
			request(if getPlacedSet(data)[selectedUid] then "Remove" else "Place", selectedUid)
		end
	end)
	ui.lockButton = actionButton(2, function()
		if selectedUid then
			request("Lock", selectedUid)
		end
	end)
	ui.lockButton.BackgroundColor3 = UIKit.Colors.PanelLight
	ui.mergeButton = actionButton(3, function()
		if selectedUid then
			request("Merge", selectedUid)
		end
	end)
	ui.sellButton = actionButton(4, function()
		if selectedUid then
			request("Sell", selectedUid)
		end
	end)
	-- Пробудження: герой максимального рівня + кристали
	ui.awakenButton = actionButton(5, function()
		if selectedUid then
			request("Awaken", selectedUid)
		end
	end)
end

function InventoryUI.Init(gui)
	buildPanel(gui)
	ClientState.OnDataChanged(function()
		refreshAll()
	end)
end

return InventoryUI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="50">
          <Properties>
            <string name="Name">QuestsUI</string>
            <string name="Source"><![CDATA[-- QuestsUI: вікно Quests з вкладками "Завдання" (сюжет + щоденні) і "Колекція"
-- (усі герої, бонус доходу, нагороди за відкриття). Нагороди видає сервер.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = Shared:WaitForChild("Config")
local EconomyConfig = require(Config:WaitForChild("EconomyConfig"))
local HeroConfig = require(Config:WaitForChild("HeroConfig"))
local QuestConfig = require(Config:WaitForChild("QuestConfig"))
local RarityConfig = require(Config:WaitForChild("RarityConfig"))
local GameMath = require(Shared:WaitForChild("GameMath"))

local Client = script.Parent
local UIKit = require(Client:WaitForChild("UIKit"))
local ClientState = require(Client:WaitForChild("ClientState"))
local Hud = require(Client:WaitForChild("Hud"))

local QuestsUI = {}

local ui: { [string]: any } = {}
local activeTab = "Quests"
local busy = false

local function serverNow()
	return workspace:GetServerTimeNow()
end

local function request(action, arg)
	if busy then
		return
	end
	busy = true
	local result = ClientState.Request("QuestAction", action, arg)
	busy = false
	UIKit.Toast(result.message or "", if result.ok then "success" else "error")
end

-- Щоденний прогрес з урахуванням нового дня (поки сервер ще не обнулив)
local function dailyState(data)
	local today = GameMath.GetDay(serverNow())
	if data.daily.day ~= today then
		return today, {}, {}
	end
	return today, data.daily.progress, data.daily.claimed
end

---------------------------------------------------------------------
-- Картка завдання
---------------------------------------------------------------------

local function makeQuestCard(parent, order, height)
	local card = UIKit.Create("Frame", {
		LayoutOrder = order,
		Size = UDim2.new(1, -12, 0, height),
		BackgroundColor3 = UIKit.Colors.Background,
		BackgroundTransparency = 0.25,
		Parent = parent,
	})
	UIKit.Corner(card, 12)
	local stroke = UIKit.Stroke(card, UIKit.Colors.PanelLight, 2)
	local title = UIKit.Label({
		Position = UDim2.fromOffset(12, 4),
		Size = UDim2.new(1, -200, 0, 26),
		Font = UIKit.Font,
		TextSize = 20,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = card,
	})
	local description = UIKit.Label({
		Position = UDim2.fromOffset(12, 30),
		Size = UDim2.new(1, -200, 0, 20),
		TextSize = 14,
		TextColor3 = UIKit.Colors.SubText,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = card,
	})
	local back = UIKit.Create("Frame", {
		Position = UDim2.new(0, 12, 1, -24),
		Size = UDim2.new(1, -200, 0, 16),
		BackgroundColor3 = Color3.fromRGB(30, 25, 50),
		Parent = card,
	})
	UIKit.Corner(back, 6)
	local fill = UIKit.Create("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = UIKit.Colors.Accent2, Parent = back })
	UIKit.Corner(fill, 6)
	local progress = UIKit.Label({ Size = UDim2.fromScale(1, 1), TextSize = 12, TextStrokeTransparency = 0.4, Parent = back })
	local reward = UIKit.Label({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 4),
		Size = UDim2.fromOffset(170, 24),
		Font = UIKit.Font,
		TextSize = 17,
		TextColor3 = UIKit.Colors.Gold,
		Parent = card,
	})
	local button = UIKit.Button({
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -12, 1, -6),
		Size = UDim2.fromOffset(170, 34),
		TextSize = 18,
		Parent = card,
	})
	return { card = card, stroke = stroke, title = title, description = description, fill = fill, progress = progress, reward = reward, button = button }
end

-- state: "claim" | "progress" | "done"
local function fillCard(refs, title, description, current, target, reward, state)
	refs.title.Text = title
	refs.description.Text = description
	refs.fill.Size = UDim2.fromScale(math.clamp(current / math.max(target, 1), 0, 1), 1)
	refs.progress.Text = GameMath.FormatNumber(math.min(current, target)) .. " / " .. GameMath.FormatNumber(target)
	refs.reward.Text = GameMath.FormatReward(reward)
	if state == "claim" then
		refs.button.Text = "🎁 Claim"
		refs.button.BackgroundColor3 = UIKit.Colors.Success
		refs.stroke.Color = UIKit.Colors.Success
	elseif state == "done" then
		refs.button.Text = "✅ Отримано"
		refs.button.BackgroundColor3 = UIKit.Colors.Disabled
		refs.stroke.Color = UIKit.Colors.PanelLight
	else
		refs.button.Text = "У процесі"
		refs.button.BackgroundColor3 = UIKit.Colors.Disabled
		refs.stroke.Color = UIKit.Colors.PanelLight
	end
end

---------------------------------------------------------------------
-- Підрахунок доступних нагород (для червоної позначки на кнопці Quests)
---------------------------------------------------------------------

local function countClaimable(data)
	local count = 0
	local main = QuestConfig.Main[data.quests.main]
	if main and GameMath.GetMetric(data, main.metric) >= main.target then
		count += 1
	end
	local today, progress, claimed = dailyState(data)
	for _, quest in QuestConfig.GetDaily(today) do
		if not claimed[quest.id] and (progress[quest.event] or 0) >= quest.target then
			count += 1
		end
	end
	local discovered = GameMath.CountDiscovered(data)
	for index, milestone in QuestConfig.CollectionMilestones do
		if not data.collectionClaimed["m" .. index] and discovered >= milestone.count then
			count += 1
		end
	end
	return count
end

---------------------------------------------------------------------
-- Вкладка "Завдання"
---------------------------------------------------------------------

local function refreshQuests(data)
	local mainQuest = QuestConfig.Main[data.quests.main]
	if mainQuest then
		local current = GameMath.GetMetric(data, mainQuest.metric)
		fillCard(ui.main, ("%d. %s"):format(data.quests.main, mainQuest.title), mainQuest.description, current, mainQuest.target, mainQuest.reward, if current >= mainQuest.target then "claim" else "progress")
	else
		fillCard(ui.main, "🏆 Сюжет пройдено!", "Нові завдання з'являться разом з новими світами", 1, 1, {}, "done")
	end

	local today, progress, claimed = dailyState(data)
	for index, quest in QuestConfig.GetDaily(today) do
		local refs = ui.daily[index]
		local current = progress[quest.event] or 0
		local state = if claimed[quest.id] then "done" elseif current >= quest.target then "claim" else "progress"
		fillCard(refs, quest.title, quest.description, current, quest.target, quest.reward, state)
		refs.questId = quest.id
	end
end

local function refreshTimer()
	local now = serverNow()
	local nextDay = (GameMath.GetDay(now) + 1) * 86400
	ui.dailyHeader.Text = "📅 Щоденні завдання • нові через " .. GameMath.FormatTime(nextDay - now)
end

---------------------------------------------------------------------
-- Вкладка "Колекція"
---------------------------------------------------------------------

local function refreshCollection(data)
	local discovered = GameMath.CountDiscovered(data)
	ui.collectionHeader.Text = ("📖 Відкрито %d / %d • бонус доходу бази +%d%%"):format(
		discovered,
		#HeroConfig.List,
		math.floor(discovered * EconomyConfig.CollectionIncomeBonus * 100 + 0.5)
	)
	for index, milestone in QuestConfig.CollectionMilestones do
		local button = ui.milestones[index]
		local claimed = data.collectionClaimed["m" .. index]
		local ready = discovered >= milestone.count
		button.Text = ("%s %d героїв\n+%d 💎"):format(if claimed then "✅" elseif ready then "🎁" else "🔒", milestone.count, milestone.crystals)
		button.BackgroundColor3 = if claimed then UIKit.Colors.Disabled elseif ready then UIKit.Colors.Success else UIKit.Colors.PanelLight
	end

	for _, child in ui.collectionGrid:GetChildren() do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end
	for order, heroDef in HeroConfig.List do
		local known = data.discovered[heroDef.id] == true
		local color = RarityConfig.GetColor(heroDef.rarity)
		local cell = UIKit.Create("Frame", {
			LayoutOrder = order,
			BackgroundColor3 = if known then color:Lerp(UIKit.Colors.Background, 0.6) else Color3.fromRGB(25, 22, 35),
			Parent = ui.collectionGrid,
		})
		UIKit.Corner(cell, 10)
		-- Невідомий герой — темний силует портрета
		local portrait = UIKit.HeroPortrait(cell, heroDef.id, if known then 0.35 else 0.85)
		if portrait and not known then
			portrait.ImageColor3 = Color3.new(0, 0, 0)
		end
		UIKit.Stroke(cell, if known then color else UIKit.Colors.Disabled, 2)
		UIKit.Label({
			Position = UDim2.fromOffset(4, 4),
			Size = UDim2.new(1, -8, 0, 40),
			Font = UIKit.Font,
			TextSize = 15,
			TextColor3 = if known then color else UIKit.Colors.Disabled,
			Text = if known then heroDef.name else "???",
			Parent = cell,
		})
		UIKit.Label({
			Position = UDim2.fromOffset(4, 46),
			Size = UDim2.new(1, -8, 0, 22),
			TextSize = 13,
			TextColor3 = color,
			Text = (if known then (HeroConfig.ElementIcons[heroDef.element] or "") .. " " else "") .. heroDef.rarity,
			Parent = cell,
		})
	end
end

---------------------------------------------------------------------

local function refresh()
	local data = ClientState.Data
	if not data then
		return
	end
	Hud.SetBadge("Quests", countClaimable(data))
	if not ui.panel.Visible then
		return
	end
	if activeTab == "Quests" then
		refreshQuests(data)
		refreshTimer()
	else
		refreshCollection(data)
	end
end

local function selectTab(name)
	activeTab = name
	ui.questsBody.Visible = name == "Quests"
	ui.collectionBody.Visible = name == "Collection"
	ui.tabQuests.BackgroundColor3 = if name == "Quests" then UIKit.Colors.Accent else UIKit.Colors.PanelLight
	ui.tabCollection.BackgroundColor3 = if name == "Collection" then UIKit.Colors.Accent else UIKit.Colors.PanelLight
	refresh()
end

local function buildQuestsBody(content)
	local body = UIKit.Create("ScrollingFrame", {
		Position = UDim2.fromOffset(0, 52),
		Size = UDim2.new(1, 0, 1, -52),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 8,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Parent = content,
	})
	UIKit.Create("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = body })
	ui.questsBody = body

	UIKit.Label({
		LayoutOrder = 1,
		Size = UDim2.new(1, -12, 0, 26),
		Font = UIKit.Font,
		TextSize = 20,
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = "📖 Сюжет",
		Parent = body,
	})
	ui.main = makeQuestCard(body, 2, 92)
	ui.main.button.Activated:Connect(function()
		request("ClaimMain")
	end)

	ui.dailyHeader = UIKit.Label({
		LayoutOrder = 3,
		Size = UDim2.new(1, -12, 0, 26),
		Font = UIKit.Font,
		TextSize = 20,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = body,
	})
	ui.daily = {}
	for index = 1, QuestConfig.DailyCount do
		local refs = makeQuestCard(body, 3 + index, 86)
		refs.button.Activated:Connect(function()
			if refs.questId then
				request("ClaimDaily", refs.questId)
			end
		end)
		ui.daily[index] = refs
	end
end

local function buildCollectionBody(content)
	local body = UIKit.Create("Frame", {
		Position = UDim2.fromOffset(0, 52),
		Size = UDim2.new(1, 0, 1, -52),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = content,
	})
	ui.collectionBody = body
	ui.collectionHeader = UIKit.Label({
		Size = UDim2.new(1, 0, 0, 28),
		Font = UIKit.Font,
		TextSize = 19,
		TextColor3 = UIKit.Colors.Gold,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = body,
	})
	local row = UIKit.Create("Frame", { Position = UDim2.fromOffset(0, 32), Size = UDim2.new(1, 0, 0, 52), BackgroundTransparency = 1, Parent = body })
	UIKit.Create("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = row })
	ui.milestones = {}
	local count = #QuestConfig.CollectionMilestones
	for index = 1, count do
		ui.milestones[index] = UIKit.Button({
			LayoutOrder = index,
			Size = UDim2.new(1 / count, -6, 1, 0),
			TextSize = 16,
			Parent = row,
		}, function()
			request("ClaimCollection", index)
		end)
	end

	ui.collectionGrid = UIKit.Create("ScrollingFrame", {
		Position = UDim2.fromOffset(0, 92),
		Size = UDim2.new(1, 0, 1, -92),
		BackgroundColor3 = UIKit.Colors.Background,
		BackgroundTransparency = 0.4,
		BorderSizePixel = 0,
		ScrollBarThickness = 8,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Parent = body,
	})
	UIKit.Corner(ui.collectionGrid, 12)
	UIKit.Create("UIGridLayout", {
		CellSize = UDim2.fromOffset(112, 74),
		CellPadding = UDim2.fromOffset(8, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = ui.collectionGrid,
	})
	UIKit.Create("UIPadding", {
		PaddingTop = UDim.new(0, 8),
		PaddingLeft = UDim.new(0, 8),
		PaddingRight = UDim.new(0, 8),
		PaddingBottom = UDim.new(0, 8),
		Parent = ui.collectionGrid,
	})
end

function QuestsUI.Init(gui)
	local panel, content = UIKit.Panel(gui, "Quests", "📜 Quests", Color3.fromRGB(255, 150, 40))
	ui.panel = panel
	Hud.RegisterPanel("Quests", panel)

	ui.tabQuests = UIKit.Button({
		Size = UDim2.fromOffset(200, 44),
		Text = "📜 Завдання",
		Parent = content,
	}, function()
		selectTab("Quests")
	end)
	ui.tabCollection = UIKit.Button({
		Position = UDim2.fromOffset(210, 0),
		Size = UDim2.fromOffset(200, 44),
		Text = "📖 Колекція",
		Parent = content,
	}, function()
		selectTab("Collection")
	end)

	buildQuestsBody(content)
	buildCollectionBody(content)
	selectTab("Quests")

	-- 📜 Quests і 📖 Index відкривають одне вікно на різних вкладках
	local function openTab(tab)
		if panel.Visible and activeTab == tab then
			panel.Visible = false
		else
			Hud.OpenPanel("Quests")
			selectTab(tab)
		end
	end
	Hud.SetAction("Quests", function()
		openTab("Quests")
	end)
	Hud.SetAction("Index", function()
		openTab("Collection")
	end)

	panel:GetPropertyChangedSignal("Visible"):Connect(refresh)
	ClientState.OnDataChanged(refresh)

	-- Таймер щоденних завдань і зміна дня
	task.spawn(function()
		local lastDay = nil
		while true do
			task.wait(1)
			local day = GameMath.GetDay(serverNow())
			if day ~= lastDay then
				lastDay = day
				refresh()
			elseif panel.Visible and activeTab == "Quests" then
				refreshTimer()
			end
		end
	end)
end

return QuestsUI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="51">
          <Properties>
            <string name="Name">RebirthUI</string>
            <string name="Source"><![CDATA[-- RebirthUI: вікно Rebirth — прогрес до наступного Rebirth, що отримаєш і що скинеться.
-- Підтвердження вимагає двох натискань, щоб не зробити Rebirth випадково.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local EconomyConfig = require(Shared:WaitForChild("Config"):WaitForChild("EconomyConfig"))
local GameMath = require(Shared:WaitForChild("GameMath"))

local Client = script.Parent
local UIKit = require(Client:WaitForChild("UIKit"))
local ClientState = require(Client:WaitForChild("ClientState"))
local Hud = require(Client:WaitForChild("Hud"))

local RebirthUI = {}

local ui: { [string]: any } = {}
local confirmUntil = 0

local function infoCard(parent, position, title, color)
	local card = UIKit.Create("Frame", {
		Position = position,
		Size = UDim2.new(0.5, -8, 0, 150),
		BackgroundColor3 = UIKit.Colors.Background,
		BackgroundTransparency = 0.15,
		Parent = parent,
	})
	UIKit.Corner(card, 16)
	UIKit.Stroke(card, color, 3)
	UIKit.Label({
		Position = UDim2.fromOffset(12, 6),
		Size = UDim2.new(1, -24, 0, 30),
		Font = UIKit.Font,
		TextSize = 22,
		TextColor3 = color,
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = title,
		Parent = card,
	})
	return UIKit.Label({
		Position = UDim2.fromOffset(12, 38),
		Size = UDim2.new(1, -24, 1, -44),
		TextSize = 16,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		Parent = card,
	})
end

local function refresh()
	local data = ClientState.Data
	if not data then
		return
	end
	local rebirths = data.rebirths or 0
	local cost = GameMath.GetRebirthCost(rebirths)
	local coins = ClientState.Coins
	local ready = coins >= cost

	ui.count.Text = ("♻️ Rebirth: %d"):format(rebirths)
	ui.current.Text = ("Зараз: дохід ×%.1f • удача ×%.2f"):format(GameMath.GetRebirthIncome(rebirths), GameMath.GetRebirthLuck(rebirths))
	ui.fill.Size = UDim2.fromScale(math.clamp(coins / cost, 0, 1), 1)
	ui.progress.Text = ("🪙 %s / %s"):format(GameMath.FormatNumber(coins), GameMath.FormatNumber(cost))

	local nextRebirth = rebirths + 1
	ui.gain.Text = ("💰 Дохід ×%.1f назавжди\n🍀 Удача ×%.2f назавжди\n💎 +%d кристалів"):format(
		GameMath.GetRebirthIncome(nextRebirth),
		GameMath.GetRebirthLuck(nextRebirth),
		EconomyConfig.Rebirth.crystalReward * nextRebirth
	)

	if os.clock() < confirmUntil then
		ui.button.Text = "⚠️ Точно? Натисни ще раз!"
		ui.button.BackgroundColor3 = UIKit.Colors.Danger
	elseif ready then
		ui.button.Text = "♻️ REBIRTH!"
		ui.button.BackgroundColor3 = Hud.Colors.Rebirth
	else
		ui.button.Text = "Потрібно ще 🪙 " .. GameMath.FormatNumber(cost - coins)
		ui.button.BackgroundColor3 = UIKit.Colors.Disabled
	end
	Hud.SetBadge("Rebirth", ready)
end

function RebirthUI.Init(gui)
	local panel, content = UIKit.Panel(gui, "Rebirth", "♻️ Rebirth", Hud.Colors.Rebirth)
	Hud.RegisterPanel("Rebirth", panel)

	ui.count = UIKit.Label({
		Size = UDim2.new(0.5, 0, 0, 36),
		Font = UIKit.Font,
		TextSize = 30,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = content,
	})
	ui.current = UIKit.Label({
		Position = UDim2.new(0.5, 0, 0, 0),
		Size = UDim2.new(0.5, 0, 0, 36),
		Font = UIKit.Font,
		TextSize = 19,
		TextColor3 = UIKit.Colors.Gold,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = content,
	})

	local back = UIKit.Create("Frame", {
		Position = UDim2.fromOffset(0, 46),
		Size = UDim2.new(1, 0, 0, 34),
		BackgroundColor3 = UIKit.Colors.Background,
		Parent = content,
	})
	UIKit.Corner(back, 12)
	UIKit.Stroke(back, UIKit.Colors.Outline, 3)
	ui.fill = UIKit.Create("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = UIKit.Colors.Money, Parent = back })
	UIKit.Corner(ui.fill, 12)
	UIKit.Shade(ui.fill, 0.35)
	ui.progress = UIKit.Label({ Size = UDim2.fromScale(1, 1), Font = UIKit.Font, TextSize = 20, Parent = back })

	ui.gain = infoCard(content, UDim2.fromOffset(0, 94), "✅ Отримаєш", UIKit.Colors.Success)
	infoCard(content, UDim2.new(0.5, 8, 0, 94), "❌ Скинеться", UIKit.Colors.Danger).Text =
		"🪙 Монети → " .. EconomyConfig.StartingCoins .. "\n🧱 Слоти бази → " .. EconomyConfig.StartSlots .. "\n💰 Рівень доходу → 0\nГерої, команда, 💎 і світи залишаться!"

	ui.button = UIKit.Button({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.fromScale(0.5, 1),
		Size = UDim2.fromOffset(400, 70),
		TextSize = 30,
		Parent = content,
	}, function()
		local data = ClientState.Data
		if not data or ClientState.Coins < GameMath.GetRebirthCost(data.rebirths or 0) then
			UIKit.Toast("Ще не вистачає монет для Rebirth", "error")
			return
		end
		if os.clock() >= confirmUntil then
			confirmUntil = os.clock() + 3
			refresh()
			task.delay(3.05, refresh)
			return
		end
		confirmUntil = 0
		local result = ClientState.Request("Rebirth")
		UIKit.Toast(result.message or "", if result.ok then "success" else "error")
		refresh()
	end)
	ui.button.TextOutline.Thickness = 3

	ClientState.OnDataChanged(refresh)
	ClientState.OnCurrencyChanged(refresh)
end

return RebirthUI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="52">
          <Properties>
            <string name="Name">RollUI</string>
            <string name="Source"><![CDATA[-- RollUI: вікно кубиків (вибір кубика, шанси, гарантія), кнопки Roll / Auto / Skip
-- та анімація кидка. Анімація показує результат, який УЖЕ визначив сервер.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = Shared:WaitForChild("Config")
local DiceConfig = require(Config:WaitForChild("DiceConfig"))
local EconomyConfig = require(Config:WaitForChild("EconomyConfig"))
local HeroConfig = require(Config:WaitForChild("HeroConfig"))
local RarityConfig = require(Config:WaitForChild("RarityConfig"))
local GameMath = require(Shared:WaitForChild("GameMath"))
local HeroModelBuilder = require(Shared:WaitForChild("HeroModelBuilder"))
local AssetConfig = require(Config:WaitForChild("AssetConfig"))

local Client = script.Parent
local UIKit = require(Client:WaitForChild("UIKit"))
local ClientState = require(Client:WaitForChild("ClientState"))
local Hud = require(Client:WaitForChild("Hud"))
local SoundController = require(Client:WaitForChild("SoundController"))

local RollUI = {}

local selectedDice = "Basic"
local rolling = false
local autoRolling = false
local lastRequestTime = 0
local skipRequested = false

local ui: { [string]: any } = {} -- посилання на елементи інтерфейсу

---------------------------------------------------------------------
-- Показ кидка: герої швидко змінюють один одного (як у слот-машині),
-- сповільнюються й зупиняються на тому, якого вже вибрав сервер.
-- Над героєм — шанс "1 in 52K", під ним — ім'я та рідкість, позаду — промені.
---------------------------------------------------------------------

local RAY_COUNT = 16
local rng = Random.new()

local function buildOverlay(gui)
	local overlay = UIKit.Create("TextButton", {
		Name = "RollOverlay",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(8, 18, 70),
		BackgroundTransparency = 0.18,
		AutoButtonColor = false,
		Text = "",
		Visible = false,
		ZIndex = 40,
		Parent = gui,
	})
	overlay.Activated:Connect(function()
		skipRequested = true
	end)
	UIKit.Create("UIGradient", {
		Color = ColorSequence.new(Color3.fromRGB(70, 120, 255), Color3.fromRGB(10, 20, 90)),
		Rotation = 90,
		Parent = overlay,
	})

	local flash = UIKit.Create("Frame", {
		Name = "Flash",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 1,
		ZIndex = 5,
		Parent = overlay,
	})

	local stage = UIKit.Create("Frame", {
		Name = "Stage",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(900, 640),
		BackgroundTransparency = 1,
		Parent = overlay,
	})
	UIKit.AddScale(stage)

	-- Промені від центру
	local rays = UIKit.Create("Frame", {
		Name = "Rays",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.4),
		Size = UDim2.fromOffset(10, 10),
		BackgroundTransparency = 1,
		Parent = stage,
	})
	-- Кожен промінь — смуга через центр (GUI обертається навколо свого центру),
	-- яскрава посередині й прозора на кінцях: виходить "сонце" з RAY_COUNT променів.
	local rayParts = {}
	for i = 1, RAY_COUNT / 2 do
		local ray = UIKit.Create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(if i % 2 == 0 then 70 else 40, 1150),
			Rotation = i * (360 / RAY_COUNT),
			BackgroundColor3 = Color3.new(1, 1, 1),
			BorderSizePixel = 0,
			Parent = rays,
		})
		UIKit.Create("UIGradient", {
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1),
				NumberSequenceKeypoint.new(0.5, 0.35),
				NumberSequenceKeypoint.new(1, 1),
			}),
			Rotation = 90,
			Parent = ray,
		})
		rayParts[i] = ray
	end

	-- Кольорове сяйво позаду героя
	local glow = UIKit.Create("Frame", {
		Name = "Glow",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.4),
		Size = UDim2.fromOffset(380, 380),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.45,
		Parent = stage,
	})
	UIKit.Create("UICorner", { CornerRadius = UDim.new(0.5, 0), Parent = glow })
	UIKit.Create("UIGradient", {
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.7, 0.6), NumberSequenceKeypoint.new(1, 1) }),
		Rotation = 90,
		Parent = glow,
	})

	-- Сам герой — справжня 3D-модель у ViewportFrame
	local holder = UIKit.Create("Frame", {
		Name = "Holder",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.4),
		Size = UDim2.fromOffset(340, 340),
		BackgroundTransparency = 1,
		Parent = stage,
	})
	local pop = UIKit.Create("UIScale", { Parent = holder })
	local viewport = UIKit.Create("ViewportFrame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Ambient = Color3.fromRGB(190, 190, 210),
		LightColor = Color3.new(1, 1, 1),
		LightDirection = Vector3.new(-0.4, -1, 0.6),
		Parent = holder,
	})
	local portrait = UIKit.Create("ImageLabel", {
		Name = "Portrait",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ScaleType = Enum.ScaleType.Fit,
		Visible = false,
		Parent = holder,
	})
	local camera = Instance.new("Camera")
	camera.FieldOfView = 40
	camera.Parent = viewport
	viewport.CurrentCamera = camera

	-- Білі "леза" з боків
	local glints = {}
	for side = -1, 1, 2 do
		local glint = UIKit.Create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, side * 300, 0.4, 0),
			Size = UDim2.fromOffset(170, 14),
			BackgroundColor3 = Color3.new(1, 1, 1),
			Parent = stage,
		})
		UIKit.Create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = glint })
		UIKit.Create("UIGradient", {
			Transparency = NumberSequence.new(if side < 0 then 0.9 else 0, if side < 0 then 0 else 0.9),
			Parent = glint,
		})
		glints[side] = glint
	end

	-- "1 in 52K" — нахилений, великий
	local odds = UIKit.Label({
		Name = "Odds",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.1),
		Size = UDim2.fromOffset(520, 90),
		Rotation = -10,
		Font = UIKit.Font,
		TextSize = 72,
		RichText = true,
		Text = "",
		Outline = 5,
		Parent = stage,
	})
	odds.TextOutline.Color = Color3.fromRGB(10, 20, 70)

	local name = UIKit.Label({
		Name = "HeroName",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.67),
		Size = UDim2.fromOffset(880, 90),
		Font = UIKit.Font,
		TextSize = 76,
		Text = "",
		Outline = 6,
		Parent = stage,
	})
	local rarity = UIKit.Label({
		Name = "Rarity",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.77),
		Size = UDim2.fromOffset(800, 44),
		Font = UIKit.Font,
		TextSize = 38,
		RichText = true,
		Text = "",
		Outline = 4,
		Parent = stage,
	})

	-- Кругла кнопка AUTO внизу (як у грі на скриншоті)
	local auto = UIKit.Create("TextButton", {
		Name = "Auto",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -12),
		Size = UDim2.fromOffset(100, 100),
		BackgroundColor3 = Color3.fromRGB(16, 22, 48),
		AutoButtonColor = true,
		Font = UIKit.Font,
		TextSize = 26,
		TextColor3 = Color3.new(1, 1, 1),
		Text = "AUTO",
		TextYAlignment = Enum.TextYAlignment.Bottom,
		ZIndex = 6,
		Parent = overlay,
	})
	UIKit.Create("UIPadding", { PaddingBottom = UDim.new(0, 12), Parent = auto })
	UIKit.Icon({
		Key = "Auto",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 10),
		Size = UDim2.fromScale(0.56, 0.56),
		ZIndex = 7,
		Parent = auto,
	})
	UIKit.Create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = auto })
	UIKit.Stroke(auto, Color3.fromRGB(70, 110, 220), 4)
	UIKit.TextOutline(auto, 2.5)
	UIKit.AddScale(auto)
	auto.Activated:Connect(function()
		if ui.toggleAuto then
			ui.toggleAuto()
		end
	end)

	local hint = UIKit.Label({
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 16, 1, -14),
		Size = UDim2.fromOffset(300, 30),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = UIKit.Colors.SubText,
		TextSize = 18,
		Text = "Натисни, щоб пропустити",
		ZIndex = 6,
		Parent = overlay,
	})

	ui.overlay = {
		root = overlay,
		flash = flash,
		rays = rays,
		rayParts = rayParts,
		glow = glow,
		holder = holder,
		pop = pop,
		viewport = viewport,
		portrait = portrait,
		camera = camera,
		model = nil,
		glints = glints,
		odds = odds,
		name = name,
		rarity = rarity,
		auto = auto,
		hint = hint,
	}

	-- Повільне обертання променів і героя
	game:GetService("RunService").RenderStepped:Connect(function(dt)
		if not overlay.Visible then
			return
		end
		rays.Rotation = (rays.Rotation + dt * 18) % 360
		local o = ui.overlay
		if o.model then
			o.model:PivotTo(CFrame.Angles(0, math.sin(os.clock() * 1.6) * 0.45, 0))
		end
	end)
end

local function oddsText(chance)
	local number = string.sub(GameMath.FormatOdds(chance), 6)
	return ('<font color="#FFFFFF">1 in </font><font color="#55B8FF">%s</font>'):format(number)
end

-- Показати героя у ViewportFrame
local function showHero(heroDef, awakened)
	local o = ui.overlay
	if o.model then
		o.model:Destroy()
		o.model = nil
	end
	-- Якщо для героя підключено портрет — показуємо його замість 3D-моделі
	local portrait = AssetConfig.GetPortrait(heroDef.id)
	o.portrait.Visible = portrait ~= nil
	o.viewport.Visible = portrait == nil
	if portrait then
		o.portrait.Image = portrait
		return
	end
	local model = HeroModelBuilder.Build(heroDef, 1, "", awakened)
	local nameplate = model:FindFirstChild("Nameplate")
	if nameplate then
		nameplate:Destroy()
	end
	model.Parent = o.viewport
	o.model = model
	local s = heroDef.look.height or 1
	o.camera.CFrame = CFrame.lookAt(Vector3.new(0, 3.6 * s, -17 * s), Vector3.new(0, 3.4 * s, 0))
end

local function setDisplay(heroDef, chance)
	local o = ui.overlay
	local color = RarityConfig.GetColor(heroDef.rarity)
	showHero(heroDef, false)
	o.odds.Text = oddsText(chance)
	o.name.Text = heroDef.name
	o.rarity.Text = heroDef.rarity
	o.rarity.TextColor3 = color
	o.glow.BackgroundColor3 = color
	for _, ray in o.rayParts do
		ray.BackgroundColor3 = color:Lerp(Color3.new(1, 1, 1), 0.5)
	end
end

-- Випадковий герой для "прокрутки" (з тими ж вагами, що й справжній кидок)
local function randomHero(dice, luck)
	local weights, total = GameMath.GetRarityWeights(dice, luck)
	local roll = rng:NextNumber() * total
	local rarityName = "Common"
	for _, name in RarityConfig.Order do
		roll -= weights[name]
		if roll <= 0 and weights[name] > 0 then
			rarityName = name
			break
		end
	end
	local pool = HeroConfig.ByRarity[rarityName]
	return pool[rng:NextInteger(1, #pool)]
end

local function waitOrSkip(seconds)
	local start = os.clock()
	while os.clock() - start < seconds and not skipRequested do
		task.wait(0.03)
	end
	local skipped = skipRequested
	skipRequested = false
	return skipped
end

local function playReveal(result)
	local heroDef = HeroConfig.Heroes[result.heroId]
	local rarityInfo = RarityConfig.Info[result.rarity]
	if not heroDef or not rarityInfo then
		return
	end

	-- Режим без анімації: лише коротке повідомлення
	if ClientState.GetSetting("skipAnimations") then
		local text = ("%s%s — %s"):format(if result.isNew then "🆕 " else "", heroDef.name, result.rarity)
		UIKit.Toast(text, "rarity", rarityInfo.color:Lerp(Color3.new(0, 0, 0), 0.35))
		task.wait(0.3)
		return
	end

	local o = ui.overlay
	local effects = ClientState.GetSetting("effects")
	local dice = DiceConfig.Dice[selectedDice] or DiceConfig.Dice.Basic
	local data = ClientState.Data
	local luck = if data then GameMath.GetLuck(data, workspace:GetServerTimeNow()) else 1
	skipRequested = false
	o.root.Visible = true
	o.rays.Visible = false
	for _, glint in o.glints do
		glint.Visible = false
	end

	-- 1. Прокрутка: герої змінюються дедалі повільніше. Для Legendary+ — довше (інтрига).
	local rare = rarityInfo.rank >= 4
	local steps = if rare then 13 else 8
	local delay = 0.06
	for _ = 1, steps do
		if skipRequested then
			break
		end
		local candidate = randomHero(dice, luck)
		setDisplay(candidate, GameMath.GetHeroChance(dice, candidate.id, luck))
		SoundController.Play("RollTick", 0.9 + rng:NextNumber() * 0.3)
		o.pop.Scale = 1.08
		TweenService:Create(o.pop, TweenInfo.new(0.08), { Scale = 1 }):Play()
		task.wait(delay)
		delay *= 1.2
	end
	skipRequested = false

	-- 2. Справжній результат
	setDisplay(heroDef, GameMath.GetHeroChance(dice, heroDef.id, luck))
	SoundController.Play(if rare then "RareReveal" else "Reveal")
	o.pop.Scale = 0.45
	TweenService:Create(o.pop, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1.1 }):Play()

	local badges = {}
	if result.isNew then
		table.insert(badges, "🆕 NEW!")
	end
	if result.pity then
		table.insert(badges, "🎯 Гарантія!")
	end
	if result.free then
		table.insert(badges, "🎁 FREE")
	end
	-- Позначки в тому ж рядку, що й рідкість, золотим кольором
	if #badges > 0 then
		o.rarity.Text = heroDef.rarity .. '   <font color="#FFCD3C">' .. table.concat(badges, "   ") .. "</font>"
	end

	if effects then
		o.rays.Visible = rarityInfo.rank >= 2
		for side, glint in o.glints do
			glint.Visible = true
			glint.Position = UDim2.new(0.5, side * 460, 0.4, 0)
			TweenService:Create(glint, TweenInfo.new(0.35, Enum.EasingStyle.Quart), { Position = UDim2.new(0.5, side * 300, 0.4, 0) }):Play()
		end
		if rare then
			o.flash.BackgroundTransparency = 0.1
			TweenService:Create(o.flash, TweenInfo.new(0.7), { BackgroundTransparency = 1 }):Play()
		end
	end

	waitOrSkip(if autoRolling then 1.0 else 2.5)
	o.root.Visible = false
	if o.model then
		o.model:Destroy()
		o.model = nil
	end
end

---------------------------------------------------------------------
-- Кидок
---------------------------------------------------------------------

local function doRoll()
	if rolling then
		return false
	end
	rolling = true
	-- Не надсилаємо запит частіше, ніж дозволяє сервер
	local waitFor = EconomyConfig.RollCooldown + 0.05 - (os.clock() - lastRequestTime)
	if waitFor > 0 then
		task.wait(waitFor)
	end
	lastRequestTime = os.clock()
	local result = ClientState.Request("RollDice", selectedDice)
	if not result.ok then
		UIKit.Toast(result.message or "Не вдалося кинути кубик", "error")
		rolling = false
		return false
	end
	playReveal(result)
	rolling = false
	return true
end

local refreshButtons -- оголошена нижче

local function setAuto(enabled)
	autoRolling = enabled
	refreshButtons()
	if enabled then
		task.spawn(function()
			while autoRolling do
				if rolling then
					task.wait(0.1)
				elseif not doRoll() then
					autoRolling = false
					refreshButtons()
				else
					task.wait(0.1)
				end
			end
		end)
	end
end

---------------------------------------------------------------------
-- Вікно кубиків
---------------------------------------------------------------------

local function isDiceUnlocked(data, dice)
	return data ~= nil and (GameMath.IsDiceUnlocked(data, dice))
end

local function refreshInfo()
	local data = ClientState.Data
	local dice = DiceConfig.Dice[selectedDice]
	local playerLuck = if data then GameMath.GetLuck(data, workspace:GetServerTimeNow()) else 1
	ui.diceTitle.Text = dice.icon .. " " .. dice.displayName
	ui.diceDesc.Text = ("%s Удача: ×%.2f%s"):format(dice.description, dice.luck * playerLuck, if playerLuck > 1 then " 🍀 зілля активне!" else "")

	local chances = GameMath.GetChances(dice, playerLuck)
	for _, rarity in RarityConfig.Order do
		ui.chanceLabels[rarity].Text = GameMath.FormatChance(chances[rarity])
	end

	if data then
		local lines = {}
		for _, info in GameMath.GetPityRemaining(data) do
			table.insert(lines, ("🎯 %s+ гарантовано щонайпізніше через %d кидк."):format(info.rarity, info.remaining))
		end
		ui.pityLabel.Text = table.concat(lines, "\n")
	end
end

function refreshButtons()
	local data = ClientState.Data
	for diceId, button in ui.diceButtons do
		local dice = DiceConfig.Dice[diceId]
		local unlocked = isDiceUnlocked(data, dice)
		if unlocked then
			button.Text = ("%s %s\n🪙 %s"):format(dice.icon, dice.displayName, GameMath.FormatNumber(dice.price))
		else
			local requirement = if data then select(2, GameMath.IsDiceUnlocked(data, dice)) else "..."
			button.Text = ("🔒 %s\n%s"):format(dice.displayName, requirement)
		end
		button.BackgroundColor3 = if unlocked then dice.color:Lerp(UIKit.Colors.Panel, 0.45) else UIKit.Colors.Disabled
		UIKit.SetOutline(button, if diceId == selectedDice then Color3.new(1, 1, 1) else UIKit.Colors.Outline, if diceId == selectedDice then 5 else 3)
	end

	local dice = DiceConfig.Dice[selectedDice]
	local free = data ~= nil and not data.tutorial.freeRollUsed and selectedDice == DiceConfig.TutorialDice
	local canAfford = free or (ClientState.Coins >= dice.price and isDiceUnlocked(data, dice))
	local priceText = if free then "🎁 FREE" else "🪙 " .. GameMath.FormatNumber(dice.price)
	if free then
		ui.rollButton.Text = "ROLL\n🎁 FREE!"
		ui.rollButton.BackgroundColor3 = UIKit.Colors.Success
	else
		ui.rollButton.Text = "ROLL\n" .. priceText
		ui.rollButton.BackgroundColor3 = if canAfford then UIKit.Colors.Accent else UIKit.Colors.Disabled
	end

	-- Велика кнопка ROLL і вибір кубика на головному екрані
	local bigRoll = Hud.Get("Roll")
	if bigRoll then
		bigRoll.Sub.Text = priceText
		bigRoll.Sub.TextColor3 = if canAfford then UIKit.Colors.Gold else UIKit.Colors.Danger
		UIKit.SetIconEmoji(bigRoll.Icon, dice.icon)
	end
	local dicePill = Hud.Get("Dice")
	if dicePill then
		dicePill.Text = ("%s %s ▾"):format(dice.icon, dice.displayName)
	end

	local autoUnlocked = data ~= nil and data.tutorial.completed
	if ui.overlay then
		ui.overlay.auto.BackgroundColor3 = if autoRolling then Color3.fromRGB(30, 140, 60) else Color3.fromRGB(16, 22, 48)
	end
	local autoButtons = { ui.autoButton, Hud.Get("Auto") }
	for _, button in autoButtons do
		if not autoUnlocked then
			button.Text = "🔒 AUTO"
			button.BackgroundColor3 = UIKit.Colors.Disabled
		else
			button.Text = if autoRolling then "AUTO: ON" else "AUTO: OFF"
			button.BackgroundColor3 = if autoRolling then UIKit.Colors.Success else UIKit.Colors.PanelLight
		end
	end

	-- Поточна удача (кубик × зілля × Rebirth)
	local luckLabel = Hud.Get("Luck")
	if luckLabel then
		local playerLuck = if data then GameMath.GetLuck(data, workspace:GetServerTimeNow()) else 1
		luckLabel.Text = "x" .. GameMath.FormatNumber(math.floor(dice.luck * playerLuck * 100 + 0.5) / 100)
	end

	local skip = ClientState.GetSetting("skipAnimations")
	ui.skipButton.Text = if skip then "⏩ Skip: ON" else "⏩ Skip: OFF"
	ui.skipButton.BackgroundColor3 = if skip then UIKit.Colors.Success else UIKit.Colors.PanelLight
end

local function toggleAuto()
	local data = ClientState.Data
	if not (data and data.tutorial.completed) then
		UIKit.Toast("Auto Roll відкриється після навчання: постав героя на базу", "info")
		return
	end
	setAuto(not autoRolling)
end

local function buildPanel(gui)
	local panel, content = UIKit.Panel(gui, "Roll", "🎲 Dice", Color3.fromRGB(190, 70, 255))
	ui.panel = panel
	Hud.RegisterPanel("Roll", panel)

	-- Ліва колонка: список кубиків
	local list = UIKit.Create("Frame", {
		Size = UDim2.new(0, 220, 1, 0),
		BackgroundTransparency = 1,
		Parent = content,
	})
	UIKit.Create("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder, Parent = list })
	ui.diceButtons = {}
	for index, diceId in DiceConfig.Order do
		ui.diceButtons[diceId] = UIKit.Button({
			LayoutOrder = index,
			Size = UDim2.new(1, 0, 0, 50), -- 7 кубиків мають вміститися у вікно
			TextSize = 16,
			Parent = list,
		}, function()
			selectedDice = diceId
			refreshInfo()
			refreshButtons()
		end)
	end

	-- Права колонка: інформація та шанси
	local info = UIKit.Create("Frame", {
		Position = UDim2.fromOffset(236, 0),
		Size = UDim2.new(1, -236, 1, -72),
		BackgroundTransparency = 1,
		Parent = content,
	})
	ui.diceTitle = UIKit.Label({
		Size = UDim2.new(1, 0, 0, 32),
		Font = UIKit.Font,
		TextSize = 26,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = info,
	})
	ui.diceDesc = UIKit.Label({
		Position = UDim2.fromOffset(0, 32),
		Size = UDim2.new(1, 0, 0, 24),
		TextSize = 15,
		TextColor3 = UIKit.Colors.SubText,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = info,
	})

	local chancesFrame = UIKit.Create("Frame", {
		Position = UDim2.fromOffset(0, 62),
		Size = UDim2.new(1, 0, 0, 160),
		BackgroundColor3 = UIKit.Colors.Background,
		BackgroundTransparency = 0.3,
		Parent = info,
	})
	UIKit.Corner(chancesFrame, 12)
	UIKit.Create("UIGridLayout", {
		CellSize = UDim2.new(0.5, -8, 0, 46),
		CellPadding = UDim2.fromOffset(8, 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = chancesFrame,
	})
	UIKit.Create("UIPadding", {
		PaddingTop = UDim.new(0, 6),
		PaddingLeft = UDim.new(0, 8),
		Parent = chancesFrame,
	})
	ui.chanceLabels = {}
	for index, rarity in RarityConfig.Order do
		local row = UIKit.Create("Frame", { LayoutOrder = index, BackgroundTransparency = 1, Parent = chancesFrame })
		UIKit.Label({
			Size = UDim2.fromScale(0.6, 1),
			Font = UIKit.Font,
			TextSize = 20,
			TextColor3 = RarityConfig.GetColor(rarity),
			TextXAlignment = Enum.TextXAlignment.Left,
			Text = rarity,
			Parent = row,
		})
		ui.chanceLabels[rarity] = UIKit.Label({
			Position = UDim2.fromScale(0.6, 0),
			Size = UDim2.fromScale(0.4, 1),
			Font = UIKit.Font,
			TextSize = 20,
			TextXAlignment = Enum.TextXAlignment.Right,
			Parent = row,
		})
	end

	ui.pityLabel = UIKit.Label({
		Position = UDim2.fromOffset(0, 228),
		Size = UDim2.new(1, 0, 0, 50),
		TextSize = 15,
		TextColor3 = UIKit.Colors.Gold,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = info,
	})

	-- Кнопки внизу
	local buttons = UIKit.Create("Frame", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 236, 1, 0),
		Size = UDim2.new(1, -236, 0, 64),
		BackgroundTransparency = 1,
		Parent = content,
	})
	UIKit.Create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		Padding = UDim.new(0, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = buttons,
	})
	ui.rollButton = UIKit.Button({ LayoutOrder = 1, Size = UDim2.fromOffset(210, 64), TextSize = 22 }, function()
		task.spawn(doRoll)
	end)
	ui.rollButton.Parent = buttons
	ui.autoButton = UIKit.Button({ LayoutOrder = 2, Size = UDim2.fromOffset(130, 64), TextSize = 20 }, toggleAuto)
	ui.autoButton.Parent = buttons
	ui.skipButton = UIKit.Button({ LayoutOrder = 3, Size = UDim2.fromOffset(152, 64), TextSize = 19 }, function()
		ClientState.SetSetting("skipAnimations", not ClientState.GetSetting("skipAnimations"))
	end)
	ui.skipButton.Parent = buttons
end

function RollUI.Init(gui)
	buildPanel(gui)
	buildOverlay(gui)
	-- Велика кнопка ROLL одразу кидає вибраний кубик; AUTO вмикає автокидки
	Hud.SetAction("Roll", function()
		task.spawn(doRoll)
	end)
	Hud.SetAction("Auto", toggleAuto)
	ui.toggleAuto = toggleAuto
	refreshInfo()
	refreshButtons()
	ClientState.OnDataChanged(function()
		refreshInfo()
		refreshButtons()
	end)
	ClientState.OnCurrencyChanged(function()
		refreshButtons()
	end)
	ClientState.OnSettingChanged(function()
		refreshButtons()
	end)
	-- Зілля удачі може закінчитись — оновлюємо шанси й удачу
	task.spawn(function()
		while true do
			task.wait(2)
			refreshButtons()
			if ui.panel and ui.panel.Visible then
				refreshInfo()
			end
		end
	end)
end

return RollUI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="53">
          <Properties>
            <string name="Name">SettingsUI</string>
            <string name="Source"><![CDATA[-- SettingsUI: перемикачі звуку, ефектів і пропуску анімацій.
-- Налаштування зберігаються на сервері разом із прогресом.

local Client = script.Parent
local UIKit = require(Client:WaitForChild("UIKit"))
local ClientState = require(Client:WaitForChild("ClientState"))
local Hud = require(Client:WaitForChild("Hud"))

local SettingsUI = {}

local OPTIONS = {
	{ key = "sound", title = "🔊 Звук", hint = "Звуки кидків і нагород (з'являться на наступному етапі)" },
	{ key = "effects", title = "✨ Ефекти", hint = "Аури героїв, спалахи й промені рідкісних випадінь" },
	{ key = "skipAnimations", title = "⏩ Пропуск анімацій", hint = "Показувати результат кидка одразу" },
}

local toggles = {}

local function refresh()
	for key, button in toggles do
		local enabled = ClientState.GetSetting(key)
		button.Text = if enabled then "ON" else "OFF"
		button.BackgroundColor3 = if enabled then UIKit.Colors.Success else UIKit.Colors.Disabled
	end
end

function SettingsUI.Init(gui)
	local panel, content = UIKit.Panel(gui, "Settings", "⚙️ Settings", Color3.fromRGB(110, 110, 150))
	Hud.RegisterPanel("Settings", panel)
	UIKit.Create("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder, Parent = content })

	for index, option in OPTIONS do
		local row = UIKit.Create("Frame", {
			LayoutOrder = index,
			Size = UDim2.new(1, 0, 0, 80),
			BackgroundColor3 = UIKit.Colors.Background,
			BackgroundTransparency = 0.3,
			Parent = content,
		})
		UIKit.Corner(row, 14)
		UIKit.Label({
			Position = UDim2.fromOffset(16, 6),
			Size = UDim2.new(1, -200, 0, 36),
			Font = UIKit.Font,
			TextSize = 24,
			TextXAlignment = Enum.TextXAlignment.Left,
			Text = option.title,
			Parent = row,
		})
		UIKit.Label({
			Position = UDim2.fromOffset(16, 42),
			Size = UDim2.new(1, -200, 0, 30),
			TextSize = 15,
			TextColor3 = UIKit.Colors.SubText,
			TextXAlignment = Enum.TextXAlignment.Left,
			Text = option.hint,
			Parent = row,
		})
		toggles[option.key] = UIKit.Button({
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -16, 0.5, 0),
			Size = UDim2.fromOffset(140, 56),
			TextSize = 24,
			Parent = row,
		}, function()
			ClientState.SetSetting(option.key, not ClientState.GetSetting(option.key))
		end)
	end

	refresh()
	ClientState.OnDataChanged(refresh)
	ClientState.OnSettingChanged(refresh)
end

return SettingsUI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="54">
          <Properties>
            <string name="Name">SoundController</string>
            <string name="Source"><![CDATA[-- SoundController: звуки інтерфейсу. ID звуків — у Config/AssetConfig.
-- Звук грає лише якщо його ID заповнено і в налаштуваннях увімкнено "Звук".

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")

local AssetConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"):WaitForChild("AssetConfig"))

local Client = script.Parent
local ClientState = require(Client:WaitForChild("ClientState"))

local SoundController = {}

local sounds = {} -- [key] = Sound

function SoundController.Play(key, pitch)
	local soundId = AssetConfig.GetSound(key)
	if not soundId then
		return
	end
	-- Поки дані не прийшли, звук дозволено; далі — за налаштуванням
	if ClientState.Data and not ClientState.GetSetting("sound") then
		return
	end
	local sound = sounds[key]
	if not sound then
		sound = Instance.new("Sound")
		sound.Name = "UI_" .. key
		sound.SoundId = soundId
		sound.Volume = AssetConfig.SoundVolume[key] or 0.5
		sound.Parent = SoundService
		sounds[key] = sound
	end
	sound.PlaybackSpeed = pitch or 1
	SoundService:PlayLocalSound(sound)
end

return SoundController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="55">
          <Properties>
            <string name="Name">TeamUI</string>
            <string name="Source"><![CDATA[-- TeamUI: вікно бойової команди. Зверху 3 слоти, нижче — усі герої за шкодою.
-- Дотик по герою: додати в команду / прибрати. Герой з бази переходить у команду сам.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = Shared:WaitForChild("Config")
local CombatConfig = require(Config:WaitForChild("CombatConfig"))
local HeroConfig = require(Config:WaitForChild("HeroConfig"))
local RarityConfig = require(Config:WaitForChild("RarityConfig"))
local GameMath = require(Shared:WaitForChild("GameMath"))

local Client = script.Parent
local UIKit = require(Client:WaitForChild("UIKit"))
local ClientState = require(Client:WaitForChild("ClientState"))
local Hud = require(Client:WaitForChild("Hud"))

local TeamUI = {}

local ui: { [string]: any } = {}
local dirty = true
local busy = false

local function request(action, uid)
	if busy then
		return
	end
	busy = true
	local result = ClientState.Request("TeamAction", action, uid)
	busy = false
	UIKit.Toast(result.message or "", if result.ok then "success" else "error")
end

local function heroLine(heroDef, hero)
	return ("Lv %d • ⚔️ %s/s"):format(hero.level, GameMath.FormatNumber(math.floor(GameMath.GetHeroDps(heroDef, hero.level, hero.awakened))))
end

local function refreshSlots(data)
	for slot = 1, CombatConfig.TeamSize do
		local card = ui.slots[slot]
		local uid = data.team[slot]
		local hero = uid ~= "" and data.heroes[uid]
		local heroDef = hero and HeroConfig.Heroes[hero.id]
		if heroDef then
			local color = RarityConfig.GetColor(heroDef.rarity)
			card.BackgroundColor3 = color:Lerp(UIKit.Colors.Background, 0.55)
			card.Stroke.Color = color
			card.Title.Text = heroDef.name
			card.Title.TextColor3 = color
			card.Info.Text = heroLine(heroDef, hero) .. "\n✦ " .. heroDef.ability.name .. "   (натисни, щоб прибрати)"
		else
			card.BackgroundColor3 = UIKit.Colors.Background
			card.Stroke.Color = UIKit.Colors.Disabled
			card.Title.Text = ("Слот %d"):format(slot)
			card.Title.TextColor3 = UIKit.Colors.SubText
			card.Info.Text = "Порожньо — вибери героя нижче"
		end
	end
	ui.dps.Text = "⚔️ Шкода команди: " .. GameMath.FormatNumber(math.floor(GameMath.GetTeamDps(data))) .. "/s"
end

local function refreshGrid(data)
	for _, child in ui.grid:GetChildren() do
		if child:IsA("GuiButton") then
			child:Destroy()
		end
	end
	local list = {}
	for uid, hero in data.heroes do
		local heroDef = HeroConfig.Heroes[hero.id]
		if heroDef then
			table.insert(list, { uid = uid, hero = hero, def = heroDef, dps = GameMath.GetHeroDps(heroDef, hero.level, hero.awakened) })
		end
	end
	table.sort(list, function(a, b)
		if a.dps ~= b.dps then
			return a.dps > b.dps
		end
		return a.uid < b.uid
	end)
	for order, entry in list do
		local inTeam = GameMath.IsInTeam(data, entry.uid)
		local onBase = GameMath.IsOnBase(data, entry.uid)
		local color = RarityConfig.GetColor(entry.def.rarity)
		local card = UIKit.Create("TextButton", {
			Name = entry.uid,
			LayoutOrder = order,
			BackgroundColor3 = color:Lerp(UIKit.Colors.Background, if inTeam then 0.3 else 0.6),
			Text = "",
			Parent = ui.grid,
		})
		UIKit.Corner(card, 10)
		UIKit.HeroPortrait(card, entry.def.id)
		UIKit.Stroke(card, if inTeam then Color3.new(1, 1, 1) else color, if inTeam then 3 else 2)
		UIKit.Label({
			Position = UDim2.fromOffset(4, 4),
			Size = UDim2.new(1, -8, 0, 38),
			Font = UIKit.Font,
			TextSize = 15,
			TextColor3 = color,
			Text = entry.def.name,
			Parent = card,
		})
		UIKit.Label({
			Position = UDim2.fromOffset(4, 44),
			Size = UDim2.new(1, -8, 0, 20),
			TextSize = 13,
			Text = heroLine(entry.def, entry.hero),
			Parent = card,
		})
		UIKit.Label({
			Position = UDim2.fromOffset(4, 66),
			Size = UDim2.new(1, -8, 0, 22),
			TextSize = 15,
			Text = (HeroConfig.ElementIcons[entry.def.element] or "") .. (if inTeam then " ⚔️ у команді" elseif onBase then " 🏠 на базі" else ""),
			Parent = card,
		})
		card.Activated:Connect(function()
			request(if inTeam then "Remove" else "Add", entry.uid)
		end)
	end
end

local function refresh()
	local data = ClientState.Data
	if not data then
		return
	end
	if not ui.panel.Visible then
		dirty = true
		return
	end
	dirty = false
	refreshSlots(data)
	refreshGrid(data)
end

function TeamUI.Init(gui)
	local panel, content = UIKit.Panel(gui, "Team", "⚔️ Team", Color3.fromRGB(255, 120, 60))
	ui.panel = panel
	Hud.RegisterPanel("Team", panel)
	panel:GetPropertyChangedSignal("Visible"):Connect(function()
		if panel.Visible and dirty then
			refresh()
		end
	end)

	-- 3 слоти команди
	local slotsRow = UIKit.Create("Frame", { Size = UDim2.new(1, 0, 0, 96), BackgroundTransparency = 1, Parent = content })
	UIKit.Create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		Padding = UDim.new(0, 10),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = slotsRow,
	})
	ui.slots = {}
	for slot = 1, CombatConfig.TeamSize do
		local card = UIKit.Create("TextButton", {
			LayoutOrder = slot,
			Size = UDim2.new(1 / CombatConfig.TeamSize, -7, 1, 0),
			BackgroundColor3 = UIKit.Colors.Background,
			Text = "",
			Parent = slotsRow,
		})
		UIKit.Corner(card, 12)
		UIKit.Stroke(card, UIKit.Colors.Disabled, 2).Name = "Stroke"
		UIKit.Label({
			Name = "Title",
			Position = UDim2.fromOffset(8, 4),
			Size = UDim2.new(1, -16, 0, 30),
			Font = UIKit.Font,
			TextSize = 19,
			Parent = card,
		})
		UIKit.Label({
			Name = "Info",
			Position = UDim2.fromOffset(8, 36),
			Size = UDim2.new(1, -16, 1, -40),
			TextSize = 13,
			TextColor3 = UIKit.Colors.SubText,
			Parent = card,
		})
		card.Activated:Connect(function()
			local data = ClientState.Data
			local uid = data and data.team[slot]
			if uid and uid ~= "" then
				request("Remove", uid)
			end
		end)
		ui.slots[slot] = card
	end

	-- Рядок керування
	ui.dps = UIKit.Label({
		Position = UDim2.fromOffset(0, 104),
		Size = UDim2.new(1, -330, 0, 40),
		Font = UIKit.Font,
		TextSize = 19,
		TextColor3 = UIKit.Colors.Gold,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = content,
	})
	UIKit.Button({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -140, 0, 104),
		Size = UDim2.fromOffset(180, 40),
		BackgroundColor3 = UIKit.Colors.Success,
		TextSize = 18,
		Text = "⭐ Best Team",
		Parent = content,
	}, function()
		request("Best")
	end)
	UIKit.Button({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 104),
		Size = UDim2.fromOffset(130, 40),
		BackgroundColor3 = UIKit.Colors.PanelLight,
		TextSize = 18,
		Text = "✖ Clear",
		Parent = content,
	}, function()
		request("Clear")
	end)

	-- Усі герої
	ui.grid = UIKit.Create("ScrollingFrame", {
		Position = UDim2.fromOffset(0, 152),
		Size = UDim2.new(1, 0, 1, -152),
		BackgroundColor3 = UIKit.Colors.Background,
		BackgroundTransparency = 0.4,
		BorderSizePixel = 0,
		ScrollBarThickness = 8,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Parent = content,
	})
	UIKit.Corner(ui.grid, 12)
	UIKit.Create("UIGridLayout", {
		CellSize = UDim2.fromOffset(112, 92),
		CellPadding = UDim2.fromOffset(8, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = ui.grid,
	})
	UIKit.Create("UIPadding", {
		PaddingTop = UDim.new(0, 8),
		PaddingLeft = UDim.new(0, 8),
		PaddingRight = UDim.new(0, 8),
		PaddingBottom = UDim.new(0, 8),
		Parent = ui.grid,
	})

	ClientState.OnDataChanged(refresh)
end

return TeamUI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="56">
          <Properties>
            <string name="Name">UIKit</string>
            <string name="Source"><![CDATA[-- UIKit: стиль і готові елементи інтерфейсу.
-- Стиль "аніме-симулятор": яскраві кнопки з градієнтом, товста темна обводка,
-- білий текст з чорним контуром, великі емодзі-іконки (працюють без жодних картинок).
--
-- Адаптивність: усі розміри задані для екрана ~1100×650, а UIScale
-- автоматично зменшує або збільшує їх під ПК, планшет чи телефон.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local AssetConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"):WaitForChild("AssetConfig"))
local SoundController = require(script.Parent:WaitForChild("SoundController"))

local player = Players.LocalPlayer

local UIKit = {}

UIKit.Colors = {
	Background = Color3.fromRGB(22, 22, 28),
	Panel = Color3.fromRGB(40, 40, 50),
	PanelLight = Color3.fromRGB(78, 78, 96),
	Outline = Color3.fromRGB(18, 10, 32),
	Accent = Color3.fromRGB(255, 90, 200),
	Accent2 = Color3.fromRGB(80, 190, 255),
	Text = Color3.fromRGB(255, 255, 255),
	SubText = Color3.fromRGB(205, 198, 240),
	Success = Color3.fromRGB(70, 210, 90),
	Danger = Color3.fromRGB(255, 70, 90),
	Gold = Color3.fromRGB(255, 205, 60),
	Money = Color3.fromRGB(120, 255, 80),
	Disabled = Color3.fromRGB(95, 88, 120),
}

UIKit.Font = Enum.Font.FredokaOne
UIKit.BodyFont = Enum.Font.GothamBold

local REFERENCE_SIZE = Vector2.new(1100, 650)
local scaleObjects = {}
local currentScale = 1

local function computeScale()
	local camera = workspace.CurrentCamera
	local viewport = if camera then camera.ViewportSize else REFERENCE_SIZE
	return math.clamp(math.min(viewport.X / REFERENCE_SIZE.X, viewport.Y / REFERENCE_SIZE.Y), 0.5, 1.3)
end

local function updateScales()
	currentScale = computeScale()
	for scaleObject in scaleObjects do
		scaleObject.Scale = currentScale
	end
end

-- Створює Instance із властивостями та дітьми. Parent ставиться останнім.
function UIKit.Create(className, props, children)
	local instance = Instance.new(className)
	local parent = nil
	for key, value in props or {} do
		if key == "Parent" then
			parent = value
		else
			instance[key] = value
		end
	end
	for _, child in children or {} do
		child.Parent = instance
	end
	instance.Parent = parent
	return instance
end

function UIKit.Corner(parent, radius)
	return UIKit.Create("UICorner", { CornerRadius = UDim.new(0, radius or 12), Parent = parent })
end

-- Обводка рамки елемента
function UIKit.Stroke(parent, color, thickness)
	return UIKit.Create("UIStroke", {
		Color = color or UIKit.Colors.Outline,
		Thickness = thickness or 2,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = parent,
	})
end

-- Чорний контур навколо тексту (як у популярних симуляторах)
function UIKit.TextOutline(parent, thickness, color)
	return UIKit.Create("UIStroke", {
		Name = "TextOutline",
		Color = color or UIKit.Colors.Outline,
		Thickness = thickness or 2,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
		LineJoinMode = Enum.LineJoinMode.Round,
		Parent = parent,
	})
end

-- Вертикальний градієнт: зверху світліше, знизу темніше
function UIKit.Shade(parent, amount)
	local bottom = 1 - (amount or 0.18)
	return UIKit.Create("UIGradient", {
		Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.new(bottom, bottom, bottom)),
		Rotation = 90,
		Parent = parent,
	})
end

-- Додає адаптивний UIScale до верхньорівневого елемента.
function UIKit.AddScale(guiObject)
	local scaleObject = UIKit.Create("UIScale", { Scale = currentScale, Parent = guiObject })
	scaleObjects[scaleObject] = true
	scaleObject.Destroying:Connect(function()
		scaleObjects[scaleObject] = nil
	end)
	return scaleObject
end

function UIKit.GetScale()
	return currentScale
end

-- Текст. Псевдовластивість Outline = товщина контуру (0 — без контуру).
-- Для заголовкового шрифту контур додається автоматично.
function UIKit.Label(props)
	local outline = props.Outline
	local defaults = {
		BackgroundTransparency = 1,
		Font = UIKit.BodyFont,
		TextColor3 = UIKit.Colors.Text,
		TextSize = 18,
		TextWrapped = true,
	}
	for key, value in props do
		if key ~= "Outline" then
			defaults[key] = value
		end
	end
	local label = UIKit.Create("TextLabel", defaults)
	if outline == nil and defaults.Font == UIKit.Font then
		outline = 2
	end
	if outline and outline > 0 then
		UIKit.TextOutline(label, outline)
	end
	return label
end

-- Іконка: картинка з AssetConfig, а якщо її ще не підключено — емодзі.
-- props: Key (назва з AssetConfig.Icons), Emoji (свій запасний варіант) + звичайні
-- властивості розміщення (Name, Size, Position, AnchorPoint, LayoutOrder, ZIndex, Parent).
function UIKit.Icon(props)
	local image = AssetConfig.GetImage(props.Key)
	local base = {
		Name = props.Name or "Icon",
		Size = props.Size,
		Position = props.Position,
		AnchorPoint = props.AnchorPoint,
		LayoutOrder = props.LayoutOrder,
		ZIndex = props.ZIndex,
		BackgroundTransparency = 1,
	}
	local icon
	if image then
		base.Image = image
		base.ScaleType = Enum.ScaleType.Fit
		icon = UIKit.Create("ImageLabel", base)
	else
		base.Font = UIKit.Font
		base.TextScaled = true
		base.TextColor3 = Color3.new(1, 1, 1)
		base.Text = props.Emoji or AssetConfig.Fallback[props.Key] or "⭐"
		icon = UIKit.Create("TextLabel", base)
	end
	icon.Parent = props.Parent
	return icon
end

-- Портрет героя як фон картки (якщо підключено в AssetConfig.HeroPortraits).
-- Повертає ImageLabel або nil.
function UIKit.HeroPortrait(parent, heroId, transparency)
	local image = AssetConfig.GetPortrait(heroId)
	if not image then
		return nil
	end
	local portrait = UIKit.Create("ImageLabel", {
		Name = "Portrait",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Image = image,
		ImageTransparency = transparency or 0.35,
		ScaleType = Enum.ScaleType.Crop,
		ZIndex = 0,
		Parent = parent,
	})
	UIKit.Corner(portrait, 12)
	return portrait
end

-- Змінити іконку вже створеного елемента (наприклад, значок кубика на ROLL).
-- Якщо підключена картинка — лишаємо її, емодзі міняємо.
function UIKit.SetIconEmoji(icon, emoji)
	if icon and icon:IsA("TextLabel") then
		icon.Text = emoji
	end
end

-- Кнопка: градієнт, "блиск" зверху, товста обводка, текст з контуром, ефект натискання.
function UIKit.Button(props, onClick)
	local defaults = {
		BackgroundColor3 = UIKit.Colors.Accent,
		Font = UIKit.Font,
		TextColor3 = UIKit.Colors.Text,
		TextSize = 20,
		AutoButtonColor = true,
		TextWrapped = true,
	}
	for key, value in props do
		defaults[key] = value
	end
	local button = UIKit.Create("TextButton", defaults)
	UIKit.Corner(button, 12)
	UIKit.TextOutline(button, 2)
	UIKit.Shade(button, 0.2)

	local shine = UIKit.Create("Frame", {
		Name = "Shine",
		Position = UDim2.fromOffset(4, 3),
		Size = UDim2.new(1, -8, 0.42, 0),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.82,
		Parent = button,
	})
	UIKit.Corner(shine, 9)

	local outline = UIKit.Create("Frame", {
		Name = "Outline",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Parent = button,
	})
	UIKit.Corner(outline, 12)
	UIKit.Stroke(outline, UIKit.Colors.Outline, 3)

	local pressScale = UIKit.Create("UIScale", { Parent = button })
	button.MouseButton1Down:Connect(function()
		TweenService:Create(pressScale, TweenInfo.new(0.06), { Scale = 0.92 }):Play()
	end)
	local function release()
		TweenService:Create(pressScale, TweenInfo.new(0.12, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	end
	button.MouseButton1Up:Connect(release)
	button.MouseLeave:Connect(release)
	button.MouseEnter:Connect(function()
		TweenService:Create(pressScale, TweenInfo.new(0.1), { Scale = 1.05 }):Play()
	end)
	button.Activated:Connect(function()
		SoundController.Play("Click")
	end)
	if onClick then
		button.Activated:Connect(onClick)
	end
	return button
end

-- Колір і товщина обводки кнопки (наприклад, щоб виділити вибраний кубик).
function UIKit.SetOutline(button, color, thickness)
	local outline = button:FindFirstChild("Outline")
	local stroke = outline and outline:FindFirstChildOfClass("UIStroke")
	if stroke then
		stroke.Color = color
		stroke.Thickness = thickness or 3
	end
end

-- Велика квадратна кнопка з іконкою та підписом (як Shop / Rebirth / ROLL).
-- props: Name, IconKey (з AssetConfig), Icon (емодзі-запаска), Text, Sub (необов'язковий другий рядок), Color, Size, Position,
--        AnchorPoint, LayoutOrder, Parent
function UIKit.IconButton(props, onClick)
	local button = UIKit.Button({
		Name = props.Name,
		Size = props.Size or UDim2.fromOffset(100, 100),
		Position = props.Position,
		AnchorPoint = props.AnchorPoint,
		LayoutOrder = props.LayoutOrder,
		BackgroundColor3 = props.Color or UIKit.Colors.Accent,
		Text = "",
		Parent = props.Parent,
	}, onClick)
	button.UICorner.CornerRadius = UDim.new(0, 18)
	button.Outline.UICorner.CornerRadius = UDim.new(0, 18)
	button.Outline.UIStroke.Thickness = 4

	local hasSub = props.Sub ~= nil
	local iconHeight = if hasSub then 0.5 else 0.6
	UIKit.Icon({
		Name = "Icon",
		Key = props.IconKey,
		Emoji = props.Icon,
		AnchorPoint = Vector2.new(0.5, 0.5), -- щоб анімація масштабу йшла від центру
		Position = UDim2.fromScale(0.5, 0.04 + iconHeight / 2),
		Size = UDim2.fromScale(0.84, iconHeight),
		Parent = button,
	})
	UIKit.Label({
		Name = "Caption",
		Position = UDim2.fromScale(0.04, if hasSub then 0.54 else 0.64),
		Size = UDim2.fromScale(0.92, if hasSub then 0.24 else 0.3),
		Font = UIKit.Font,
		TextScaled = true,
		Text = props.Text,
		Outline = 2.5,
		Parent = button,
	})
	if hasSub then
		UIKit.Label({
			Name = "Sub",
			Position = UDim2.fromScale(0.04, 0.78),
			Size = UDim2.fromScale(0.92, 0.18),
			Font = UIKit.Font,
			TextScaled = true,
			TextColor3 = UIKit.Colors.Gold,
			Text = props.Sub,
			Outline = 2,
			Parent = button,
		})
	end
	return button
end

-- Червоний кружечок з числом або "!" у куті кнопки. value: false/nil — сховати.
function UIKit.SetBadge(button, value)
	local badge = button:FindFirstChild("Badge")
	if not badge then
		badge = UIKit.Label({
			Name = "Badge",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(1, -6, 0, 6),
			Size = UDim2.fromOffset(32, 32),
			BackgroundColor3 = UIKit.Colors.Danger,
			BackgroundTransparency = 0,
			Font = UIKit.Font,
			TextSize = 20,
			ZIndex = 5,
			Parent = button,
		})
		UIKit.Corner(badge, 16)
		UIKit.Stroke(badge, Color3.new(1, 1, 1), 2.5)
	end
	badge.Visible = value ~= nil and value ~= false and value ~= 0
	if type(value) == "number" then
		badge.Text = if value > 9 then "9+" else tostring(value)
	else
		badge.Text = "!"
	end
end

-- Веселковий градієнт для особливих шапок (як у магазинах симуляторів)
UIKit.Rainbow = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 170, 40)),
	ColorSequenceKeypoint.new(0.2, Color3.fromRGB(255, 60, 120)),
	ColorSequenceKeypoint.new(0.4, Color3.fromRGB(150, 60, 255)),
	ColorSequenceKeypoint.new(0.6, Color3.fromRGB(50, 120, 255)),
	ColorSequenceKeypoint.new(0.8, Color3.fromRGB(40, 230, 220)),
	ColorSequenceKeypoint.new(1, Color3.fromRGB(80, 230, 70)),
})

-- Горизонтальний градієнт кольору шапки: світліший ліворуч, насиченіший праворуч
local function headerSequence(color)
	if typeof(color) == "ColorSequence" then
		return color
	end
	return ColorSequence.new(color:Lerp(Color3.new(1, 1, 1), 0.25), color:Lerp(Color3.new(0, 0, 0), 0.15))
end

-- Діагональні смуги поверх шапки (замість "шахівниці" з картинки)
local function addStripes(parent)
	local holder = UIKit.Create("Frame", {
		Name = "Stripes",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		Parent = parent,
	})
	for i = 0, 24 do
		UIKit.Create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0, i * 40, 0.5, 0),
			Size = UDim2.new(0, 14, 2.5, 0),
			Rotation = 30,
			BackgroundColor3 = Color3.new(1, 1, 1),
			BackgroundTransparency = 0.9,
			BorderSizePixel = 0,
			Parent = holder,
		})
	end
	return holder
end

-- Вікно по центру екрана: темне тіло, яскрава шапка з емодзі й великим червоним X.
-- color — Color3 або ColorSequence (наприклад, UIKit.Rainbow). Повертає panel, content.
function UIKit.Panel(gui, name, title, color)
	color = color or UIKit.Colors.Accent
	local panel = UIKit.Create("Frame", {
		Name = name .. "Panel",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(780, 470),
		BackgroundColor3 = UIKit.Colors.Panel,
		Visible = false,
		ZIndex = 10,
		Parent = gui,
	})
	UIKit.Corner(panel, 18)
	UIKit.Stroke(panel, UIKit.Colors.Outline, 6)
	UIKit.AddScale(panel)
	UIKit.Create("UIGradient", {
		Color = ColorSequence.new(Color3.fromRGB(62, 62, 74), Color3.fromRGB(34, 34, 42)),
		Rotation = 90,
		Parent = panel,
	})

	-- Яскрава шапка
	local header = UIKit.Create("Frame", {
		Name = "Header",
		Size = UDim2.new(1, 0, 0, 64),
		BackgroundColor3 = Color3.new(1, 1, 1),
		ClipsDescendants = true,
		Parent = panel,
	})
	UIKit.Corner(header, 18)
	UIKit.Create("UIGradient", { Color = headerSequence(color), Parent = header })
	addStripes(header)
	-- Нижні кути шапки прямі
	local filler = UIKit.Create("Frame", {
		Position = UDim2.new(0, 0, 1, -20),
		Size = UDim2.new(1, 0, 0, 20),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		ZIndex = 0,
		Parent = header,
	})
	UIKit.Create("UIGradient", { Color = headerSequence(color), Parent = filler })
	local shine = UIKit.Create("Frame", {
		Position = UDim2.fromOffset(0, 0),
		Size = UDim2.new(1, 0, 0.45, 0),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.82,
		BorderSizePixel = 0,
		Parent = header,
	})
	UIKit.Create("UIGradient", {
		Transparency = NumberSequence.new(0.3, 1),
		Rotation = 90,
		Parent = shine,
	})
	UIKit.Create("Frame", {
		Name = "Divider",
		Position = UDim2.new(0, 0, 0, 64),
		Size = UDim2.new(1, 0, 0, 5),
		BackgroundColor3 = UIKit.Colors.Outline,
		BorderSizePixel = 0,
		Parent = panel,
	})

	UIKit.Label({
		Name = "Title",
		Position = UDim2.fromOffset(22, 4),
		Size = UDim2.new(1, -110, 0, 56),
		Font = UIKit.Font,
		TextSize = 40,
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = title,
		Outline = 3.5,
		Parent = header,
	})

	-- Великий червоний X у правому куті
	local close = UIKit.Button({
		Name = "Close",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 0),
		Size = UDim2.fromOffset(78, 64),
		BackgroundColor3 = Color3.fromRGB(235, 45, 55),
		Text = "X",
		TextSize = 46,
		Parent = panel,
	}, function()
		panel.Visible = false
	end)
	close.UICorner.CornerRadius = UDim.new(0, 18)
	close.Outline.UICorner.CornerRadius = UDim.new(0, 18)
	close.TextOutline.Thickness = 3.5

	local content = UIKit.Create("Frame", {
		Name = "Content",
		Position = UDim2.fromOffset(18, 82),
		Size = UDim2.new(1, -36, 1, -96),
		BackgroundTransparency = 1,
		Parent = panel,
	})

	-- Поява вікна з легким "стрибком"
	panel:GetPropertyChangedSignal("Visible"):Connect(function()
		if panel.Visible then
			panel.Position = UDim2.new(0.5, 0, 0.5, 30)
			TweenService:Create(panel, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Position = UDim2.fromScale(0.5, 0.5) }):Play()
		end
	end)
	return panel, content
end

-- Картка всередині вікна: темна, з товстою кольоровою рамкою й легким світінням зверху.
function UIKit.Card(props, color)
	color = color or UIKit.Colors.Accent2
	local defaults = { BackgroundColor3 = Color3.fromRGB(26, 26, 32) }
	for key, value in props do
		if key ~= "ClassName" then
			defaults[key] = value
		end
	end
	local card = UIKit.Create(props.ClassName or "Frame", defaults)
	UIKit.Corner(card, 14)
	UIKit.Stroke(card, color, 4)
	local glow = UIKit.Create("Frame", {
		Name = "Glow",
		Size = UDim2.new(1, 0, 0.6, 0),
		BackgroundColor3 = color,
		BackgroundTransparency = 0.6,
		BorderSizePixel = 0,
		Parent = card,
	})
	UIKit.Corner(glow, 14)
	UIKit.Create("UIGradient", { Transparency = NumberSequence.new(0.35, 1), Rotation = 90, Parent = glow })
	return card
end

-- Розділювач секції: — Gamepasses —
function UIKit.Divider(parent, text, order)
	local frame = UIKit.Create("Frame", {
		LayoutOrder = order or 0,
		Size = UDim2.new(1, -12, 0, 40),
		BackgroundTransparency = 1,
		Parent = parent,
	})
	for side = 0, 1 do
		UIKit.Create("Frame", {
			AnchorPoint = Vector2.new(side, 0.5),
			Position = UDim2.new(side, 0, 0.5, 0),
			Size = UDim2.new(0.3, 0, 0, 3),
			BackgroundColor3 = Color3.fromRGB(220, 220, 230),
			BorderSizePixel = 0,
			Parent = frame,
		})
	end
	UIKit.Label({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(0.38, 0, 1, 0),
		Font = UIKit.Font,
		TextSize = 28,
		Text = text,
		Outline = 3,
		Parent = frame,
	})
	return frame
end

-- Спливаючі повідомлення
local toastContainer = nil

function UIKit.Toast(text, kind, color)
	if not toastContainer or text == nil or text == "" then
		return
	end
	local background = color
		or (if kind == "error" then UIKit.Colors.Danger elseif kind == "success" then UIKit.Colors.Success else UIKit.Colors.PanelLight)
	if kind == "error" then
		SoundController.Play("Error")
	elseif kind == "success" then
		SoundController.Play("Reward")
	end
	local toast = UIKit.Label({
		Size = UDim2.fromOffset(480, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = background,
		BackgroundTransparency = 0,
		Font = UIKit.Font,
		TextSize = 21,
		Text = text,
		Parent = toastContainer,
	})
	UIKit.Corner(toast, 12)
	UIKit.Stroke(toast, UIKit.Colors.Outline, 3)
	UIKit.Shade(toast, 0.25)
	UIKit.Create("UIPadding", {
		PaddingTop = UDim.new(0, 8),
		PaddingBottom = UDim.new(0, 8),
		PaddingLeft = UDim.new(0, 12),
		PaddingRight = UDim.new(0, 12),
		Parent = toast,
	})

	-- Не більше 4 повідомлень одночасно
	local toasts = {}
	for _, child in toastContainer:GetChildren() do
		if child:IsA("TextLabel") then
			table.insert(toasts, child)
		end
	end
	if #toasts > 4 then
		toasts[1]:Destroy()
	end

	task.delay(3, function()
		if toast.Parent then
			local tween = TweenService:Create(toast, TweenInfo.new(0.4), { BackgroundTransparency = 1, TextTransparency = 1 })
			tween:Play()
			local stroke = toast:FindFirstChild("TextOutline")
			if stroke then
				TweenService:Create(stroke, TweenInfo.new(0.4), { Transparency = 1 }):Play()
			end
			tween.Completed:Wait()
			toast:Destroy()
		end
	end)
end

function UIKit.CreateScreenGui()
	local gui = UIKit.Create("ScreenGui", {
		Name = "MainGui",
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	})

	toastContainer = UIKit.Create("Frame", {
		Name = "Toasts",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 84),
		Size = UDim2.fromOffset(480, 300),
		BackgroundTransparency = 1,
		ZIndex = 50,
		Parent = gui,
	})
	UIKit.Create("UIListLayout", {
		Padding = UDim.new(0, 6),
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = toastContainer,
	})
	UIKit.AddScale(toastContainer)

	updateScales()
	local function watchCamera()
		local camera = workspace.CurrentCamera
		if camera then
			camera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScales)
		end
		updateScales()
	end
	workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(watchCamera)
	watchCamera()

	return gui
end

return UIKit
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="57">
          <Properties>
            <string name="Name">UpgradesUI</string>
            <string name="Source"><![CDATA[-- UpgradesUI: покращення бази за Coins і магазин за Crystals (зілля, більша сумка).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = Shared:WaitForChild("Config")
local EconomyConfig = require(Config:WaitForChild("EconomyConfig"))
local ShopConfig = require(Config:WaitForChild("ShopConfig"))
local GameMath = require(Shared:WaitForChild("GameMath"))

local Client = script.Parent
local UIKit = require(Client:WaitForChild("UIKit"))
local ClientState = require(Client:WaitForChild("ClientState"))
local Hud = require(Client:WaitForChild("Hud"))
local SoundController = require(Client:WaitForChild("SoundController"))

local UpgradesUI = {}

local rows = {}

-- Кожен рядок: currency ("Coins" | "Crystals"), describe(data, now), getPrice(data, now) -> ціна або nil (MAX), buy()
local ENTRIES = {
	{
		id = "Slots",
		title = "🧱 Слоти бази",
		currency = "Coins",
		describe = function(data)
			return ("Слотів: %d / %d. Більше героїв на базі — більше монет."):format(data.slotCount, EconomyConfig.MaxSlots)
		end,
		getPrice = function(data)
			return GameMath.GetSlotPrice(data.slotCount)
		end,
		remote = "BuyUpgrade",
	},
	{
		id = "Income",
		title = "💰 Дохід бази",
		currency = "Coins",
		describe = function(data)
			return ("Рівень %d. Множник доходу: ×%.1f (+%d%% за рівень)."):format(
				data.incomeLevel,
				GameMath.GetIncomeMultiplier(data.incomeLevel),
				EconomyConfig.IncomeUpgrade.bonusPerLevel * 100
			)
		end,
		getPrice = function(data)
			return GameMath.GetIncomeUpgradePrice(data.incomeLevel)
		end,
		remote = "BuyUpgrade",
	},
}

for _, itemId in ShopConfig.Order do
	local item = ShopConfig.Items[itemId]
	table.insert(ENTRIES, {
		id = itemId,
		title = item.displayName,
		currency = "Crystals",
		describe = function(data, now)
			if item.kind == "boost" then
				local left = (data.boosts[item.boost] or 0) - now
				if left > 0 then
					return item.description .. " • діє ще " .. GameMath.FormatTime(left)
				end
				return item.description
			end
			return ("%s • зараз %d місць"):format(item.description, GameMath.GetMaxInventory(data))
		end,
		getPrice = function(data)
			if item.kind == "inventory" then
				return GameMath.GetBagPrice(data)
			end
			return item.price
		end,
		remote = "BuyShopItem",
	})
end

local function refresh()
	local data = ClientState.Data
	if not data then
		return
	end
	local now = workspace:GetServerTimeNow()
	local affordableUpgrades = 0
	for _, entry in ENTRIES do
		local row = rows[entry.id]
		row.description.Text = entry.describe(data, now)
		local price = entry.getPrice(data, now)
		if price then
			local icon = if entry.currency == "Crystals" then "💎" else "🪙"
			local balance = if entry.currency == "Crystals" then ClientState.Crystals else ClientState.Coins
			row.button.Text = ("%s %s"):format(icon, GameMath.FormatNumber(price))
			row.button.BackgroundColor3 = if balance >= price
				then (if entry.currency == "Crystals" then UIKit.Colors.Accent2 else UIKit.Colors.Success)
				else UIKit.Colors.Disabled
			if entry.currency == "Coins" and balance >= price then
				affordableUpgrades += 1
			end
		else
			row.button.Text = "MAX"
			row.button.BackgroundColor3 = UIKit.Colors.Disabled
		end
	end
	-- Лічильник на кнопці UPGRADES: скільки покращень можна купити просто зараз
	Hud.SetBadge("Upgrades", affordableUpgrades)
end

-- Колір рамки картки для кожного товару
local CARD_COLORS = {
	Slots = Color3.fromRGB(70, 140, 255),
	Income = Color3.fromRGB(255, 185, 40),
	LuckPotion = Color3.fromRGB(70, 210, 90),
	CoinPotion = Color3.fromRGB(255, 185, 40),
	BigBag = Color3.fromRGB(170, 90, 255),
}

-- Картка товару: велика іконка, кольорова назва, опис і зелена кнопка ціни
local function buildCard(grid, order, entry)
	local color = CARD_COLORS[entry.id] or UIKit.Colors.Accent2
	local card = UIKit.Card({ LayoutOrder = order, Parent = grid }, color)

	local icon, name = string.match(entry.title, "^(%S+)%s+(.+)$")
	local iconLabel = UIKit.Icon({
		Key = entry.id, -- Slots, Income, LuckPotion, CoinPotion, BigBag
		Emoji = icon,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 8),
		Size = UDim2.fromOffset(100, 84),
		Parent = card,
	})
	-- Іконка м'яко "плаває"
	TweenService:Create(iconLabel, TweenInfo.new(1.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), {
		Position = UDim2.new(0.5, 0, 0, 2),
	}):Play()

	local title = UIKit.Label({
		Position = UDim2.fromOffset(8, 92),
		Size = UDim2.new(1, -16, 0, 34),
		Font = UIKit.Font,
		TextScaled = true,
		TextColor3 = color:Lerp(Color3.new(1, 1, 1), 0.25),
		Text = name or entry.title,
		Outline = 3,
		Parent = card,
	})
	UIKit.Create("UITextSizeConstraint", { MaxTextSize = 30, Parent = title })
	local description = UIKit.Label({
		Position = UDim2.fromOffset(10, 126),
		Size = UDim2.new(1, -20, 0, 52),
		Font = UIKit.Font,
		TextScaled = true,
		Outline = 1.5,
		Parent = card,
	})
	UIKit.Create("UITextSizeConstraint", { MaxTextSize = 17, Parent = description })
	local button = UIKit.Button({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -10),
		Size = UDim2.new(1, -30, 0, 48),
		BackgroundColor3 = UIKit.Colors.Success,
		TextSize = 28,
		Parent = card,
	}, function()
		local result = ClientState.Request(entry.remote, entry.id)
		if result.ok then
			SoundController.Play("Purchase")
		end
		UIKit.Toast(result.message or "", if result.ok then "info" else "error")
	end)
	button.TextOutline.Thickness = 3
	rows[entry.id] = { description = description, button = button }
end

-- Вікно з сіткою карток однієї валюти
local function buildPanel(gui, panelName, title, color, currency, sectionTitle, hint)
	local newPanel, content = UIKit.Panel(gui, panelName, title, color)
	Hud.RegisterPanel(panelName, newPanel)
	local list = UIKit.Create("ScrollingFrame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 8,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Parent = content,
	})
	UIKit.Create("UIListLayout", {
		Padding = UDim.new(0, 8),
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = list,
	})
	UIKit.Divider(list, sectionTitle, 1)
	UIKit.Label({
		LayoutOrder = 2,
		Size = UDim2.new(1, -12, 0, 22),
		TextSize = 15,
		TextColor3 = UIKit.Colors.SubText,
		Text = hint,
		Parent = list,
	})
	local grid = UIKit.Create("Frame", {
		LayoutOrder = 3,
		Size = UDim2.new(1, -12, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Parent = list,
	})
	UIKit.Create("UIGridLayout", {
		CellSize = UDim2.fromOffset(230, 240),
		CellPadding = UDim2.fromOffset(12, 12),
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = grid,
	})
	UIKit.Create("UIPadding", { PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6), Parent = grid })
	for index, entry in ENTRIES do
		if entry.currency == currency then
			buildCard(grid, index, entry)
		end
	end
	return newPanel
end

function UpgradesUI.Init(gui)
	local upgradesPanel = buildPanel(gui, "Upgrades", "⬆️ Upgrades", Color3.fromRGB(70, 205, 100), "Coins", "Base", "Покращення бази за 🪙 Coins")
	local shopPanel = buildPanel(gui, "Shop", "🛒 Shop", UIKit.Rainbow, "Crystals", "Crystal Shop", "💎 Кристали дають боси, завдання, колекція та Rebirth")

	ClientState.OnDataChanged(refresh)
	ClientState.OnCurrencyChanged(refresh)
	-- Таймери зілля
	task.spawn(function()
		while true do
			task.wait(1)
			if upgradesPanel.Visible or shopPanel.Visible then
				refresh()
			end
		end
	end)
end

return UpgradesUI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="58">
          <Properties>
            <string name="Name">WorldEffects</string>
            <string name="Source"><![CDATA[-- WorldEffects: локальні ефекти світу на екрані цього гравця.
--  • вмикає/вимикає аури героїв і частинки оточення (пелюстки, іскри) за налаштуванням "Ефекти";
--  • плавно обертає моделі з тегом Spin (наприклад, гігантський кубик у лобі).
-- Змінюється лише на екрані цього гравця, інші гравці бачать свої налаштування.

local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")

local Client = script.Parent
local ClientState = require(Client:WaitForChild("ClientState"))

local WorldEffects = {}

local AURA_TAG = "HeroAura" -- той самий тег, що в HeroModelBuilder на сервері
local AMBIENT_TAG = "AmbientFx" -- той самий тег, що в BuildUtil на сервері
local SPIN_TAG = "Spin"

local spinning = {} -- [Model] = { base = CFrame, speed = град/с, bob = студів }

local function effectsEnabled()
	-- Поки дані не прийшли, ефекти увімкнені
	return ClientState.Data == nil or ClientState.GetSetting("effects")
end

local function apply(instance)
	if instance:IsA("ParticleEmitter") or instance:IsA("Light") then
		instance.Enabled = effectsEnabled()
	end
end

local function applyAll()
	for _, tag in { AURA_TAG, AMBIENT_TAG } do
		for _, instance in CollectionService:GetTagged(tag) do
			apply(instance)
		end
	end
end

local function addSpinner(model)
	if model:IsA("Model") then
		spinning[model] = {
			base = model:GetPivot(),
			speed = math.rad(model:GetAttribute("SpinSpeed") or 30),
			bob = model:GetAttribute("BobHeight") or 0,
		}
	end
end

function WorldEffects.Init()
	for _, tag in { AURA_TAG, AMBIENT_TAG } do
		CollectionService:GetInstanceAddedSignal(tag):Connect(apply)
	end
	ClientState.OnSettingChanged(function(key)
		if key == "effects" then
			applyAll()
		end
	end)
	applyAll()

	for _, model in CollectionService:GetTagged(SPIN_TAG) do
		addSpinner(model)
	end
	CollectionService:GetInstanceAddedSignal(SPIN_TAG):Connect(addSpinner)
	CollectionService:GetInstanceRemovedSignal(SPIN_TAG):Connect(function(model)
		spinning[model] = nil
	end)
	RunService.RenderStepped:Connect(function()
		local t = os.clock()
		for model, spin in spinning do
			if model.Parent then
				local position = spin.base.Position + Vector3.new(0, math.sin(t * 1.6) * spin.bob, 0)
				model:PivotTo(CFrame.new(position) * CFrame.Angles(0, t * spin.speed, 0) * spin.base.Rotation)
			else
				spinning[model] = nil
			end
		end
	end)
end

return WorldEffects
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="59">
          <Properties>
            <string name="Name">WorldLighting</string>
            <string name="Source"><![CDATA[-- WorldLighting: освітлення й атмосфера на екрані цього гравця.
-- Кожна локація має свій настрій: яскравий день у лобі, захід сонця в селі ніндзя,
-- тропічний полудень на острові, неонова ніч у місті демонів.

local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local WorldConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"):WaitForChild("WorldConfig"))

local player = Players.LocalPlayer

local WorldLighting = {}

-- Lighting — властивості Lighting; Atmosphere / ColorCorrection / Bloom / SunRays — однойменних ефектів
local PRESETS = {
	Lobby = {
		Lighting = { ClockTime = 14.5, Brightness = 2.4, Ambient = Color3.fromRGB(110, 105, 130), OutdoorAmbient = Color3.fromRGB(150, 145, 170), FogColor = Color3.fromRGB(200, 225, 255), FogEnd = 100000 },
		Atmosphere = { Density = 0.3, Offset = 0.15, Color = Color3.fromRGB(205, 225, 255), Decay = Color3.fromRGB(150, 175, 230), Glare = 0.3, Haze = 1.2 },
		ColorCorrection = { Brightness = 0.02, Contrast = 0.08, Saturation = 0.18, TintColor = Color3.fromRGB(255, 250, 255) },
		Bloom = { Intensity = 0.6, Size = 28, Threshold = 1.6 },
		SunRays = { Intensity = 0.08, Spread = 0.8 },
	},
	NinjaVillage = {
		Lighting = { ClockTime = 17.2, Brightness = 2.2, Ambient = Color3.fromRGB(125, 95, 95), OutdoorAmbient = Color3.fromRGB(170, 130, 120), FogColor = Color3.fromRGB(255, 200, 170), FogEnd = 100000 },
		Atmosphere = { Density = 0.38, Offset = 0.2, Color = Color3.fromRGB(255, 205, 175), Decay = Color3.fromRGB(230, 140, 120), Glare = 0.6, Haze = 1.8 },
		ColorCorrection = { Brightness = 0.02, Contrast = 0.1, Saturation = 0.15, TintColor = Color3.fromRGB(255, 240, 230) },
		Bloom = { Intensity = 0.8, Size = 30, Threshold = 1.4 },
		SunRays = { Intensity = 0.15, Spread = 0.9 },
	},
	PirateIsland = {
		Lighting = { ClockTime = 12.8, Brightness = 2.8, Ambient = Color3.fromRGB(110, 120, 135), OutdoorAmbient = Color3.fromRGB(150, 170, 190), FogColor = Color3.fromRGB(200, 235, 255), FogEnd = 100000 },
		Atmosphere = { Density = 0.33, Offset = 0.1, Color = Color3.fromRGB(195, 235, 255), Decay = Color3.fromRGB(120, 190, 240), Glare = 0.2, Haze = 1.4 },
		ColorCorrection = { Brightness = 0.03, Contrast = 0.08, Saturation = 0.25, TintColor = Color3.fromRGB(250, 255, 255) },
		Bloom = { Intensity = 0.5, Size = 24, Threshold = 1.7 },
		SunRays = { Intensity = 0.1, Spread = 0.6 },
	},
	DemonCity = {
		Lighting = { ClockTime = 0, Brightness = 1, Ambient = Color3.fromRGB(70, 40, 110), OutdoorAmbient = Color3.fromRGB(80, 50, 130), FogColor = Color3.fromRGB(40, 15, 60), FogEnd = 100000 },
		Atmosphere = { Density = 0.45, Offset = 0.05, Color = Color3.fromRGB(90, 40, 130), Decay = Color3.fromRGB(40, 10, 70), Glare = 0, Haze = 2.2 },
		ColorCorrection = { Brightness = 0, Contrast = 0.15, Saturation = 0.3, TintColor = Color3.fromRGB(240, 225, 255) },
		Bloom = { Intensity = 1.2, Size = 36, Threshold = 0.9 },
		SunRays = { Intensity = 0, Spread = 0.5 },
	},
}
-- Світи без власного пресету (MagicAcademy, SkyArena) беруть денний; нічні — нічний
local DEFAULT_DAY, DEFAULT_NIGHT = PRESETS.Lobby, PRESETS.DemonCity

local effects = {}

-- Беремо ефект, що вже є в Lighting (шаблони Studio додають Atmosphere, Bloom, SunRays), або створюємо свій
local function ensureEffect(className)
	local effect = Lighting:FindFirstChildOfClass(className)
	if not effect then
		effect = Instance.new(className)
		effect.Parent = Lighting
	end
	return effect
end

local function apply(instant)
	local worldId = player:GetAttribute("World") or "Lobby"
	local preset = PRESETS[worldId]
	if not preset then
		local world = WorldConfig.Worlds[worldId]
		preset = if world and world.night then DEFAULT_NIGHT else DEFAULT_DAY
	end
	local info = TweenInfo.new(if instant then 0 else 1.2, Enum.EasingStyle.Sine)
	TweenService:Create(Lighting, info, preset.Lighting):Play()
	for key, props in preset do
		local effect = effects[key]
		if effect then
			TweenService:Create(effect, info, props):Play()
		end
	end
end

function WorldLighting.Init()
	Lighting.GlobalShadows = true
	Lighting.EnvironmentDiffuseScale = 1
	Lighting.EnvironmentSpecularScale = 1
	Lighting.ShadowSoftness = 0.25
	effects.Atmosphere = ensureEffect("Atmosphere")
	effects.ColorCorrection = ensureEffect("ColorCorrectionEffect")
	effects.Bloom = ensureEffect("BloomEffect")
	effects.SunRays = ensureEffect("SunRaysEffect")
	player:GetAttributeChangedSignal("World"):Connect(function()
		apply(false)
	end)
	apply(true)
end

return WorldLighting
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="60">
          <Properties>
            <string name="Name">WorldsUI</string>
            <string name="Source"><![CDATA[-- WorldsUI: список світів і кнопки подорожі. Переносить гравця сервер.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local WorldConfig = require(Shared:WaitForChild("Config"):WaitForChild("WorldConfig"))
local GameMath = require(Shared:WaitForChild("GameMath"))

local Client = script.Parent
local UIKit = require(Client:WaitForChild("UIKit"))
local ClientState = require(Client:WaitForChild("ClientState"))
local Hud = require(Client:WaitForChild("Hud"))

local player = Players.LocalPlayer

local WorldsUI = {}

local rows = {} -- [worldId] = { frame, button }

local function travel(worldId, panel)
	local result = ClientState.Request("Travel", worldId)
	UIKit.Toast(result.message or "", if result.ok then "success" else "error")
	if result.ok then
		panel.Visible = false
	end
end

local function refresh()
	local current = player:GetAttribute("World") or "Lobby"
	local data = ClientState.Data
	for worldId, row in rows do
		local here = worldId == current
		row.stroke.Color = if here then Color3.new(1, 1, 1) else row.color
		row.stroke.Thickness = if here then 3 else 2
		if row.available then
			local unlocked, requirement = true, nil
			if worldId ~= "Lobby" and data then
				unlocked, requirement = GameMath.IsWorldUnlocked(data, worldId)
			end
			row.locked = not unlocked
			if not unlocked then
				row.button.Text = "🔒 Закрито"
				row.button.BackgroundColor3 = UIKit.Colors.Disabled
				row.subtitle.Text = "Щоб відкрити: " .. requirement
			else
				row.button.Text = if here then "📍 Ти тут" else "▶ Travel"
				row.button.BackgroundColor3 = if here then UIKit.Colors.Disabled else UIKit.Colors.Success
				row.subtitle.Text = row.description
			end
		end
	end
end

local function addRow(content, order, worldId, title, subtitle, color, available, panel)
	local frame = UIKit.Create("Frame", {
		LayoutOrder = order,
		Size = UDim2.new(1, 0, 0, 58),
		BackgroundColor3 = color:Lerp(UIKit.Colors.Background, 0.75),
		Parent = content,
	})
	UIKit.Corner(frame, 12)
	local stroke = UIKit.Stroke(frame, color, 2)
	UIKit.Label({
		Position = UDim2.fromOffset(14, 2),
		Size = UDim2.new(1, -200, 0, 30),
		Font = UIKit.Font,
		TextSize = 22,
		TextColor3 = color:Lerp(Color3.new(1, 1, 1), 0.3),
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = title,
		Parent = frame,
	})
	local subtitleLabel = UIKit.Label({
		Position = UDim2.fromOffset(14, 31),
		Size = UDim2.new(1, -200, 0, 22),
		TextSize = 14,
		TextColor3 = UIKit.Colors.SubText,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Text = subtitle,
		Parent = frame,
	})
	local row = { stroke = nil, button = nil, color = color, available = available, subtitle = subtitleLabel, description = subtitle, locked = false }
	local button = UIKit.Button({
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
		Size = UDim2.fromOffset(170, 44),
		BackgroundColor3 = if available then UIKit.Colors.Success else UIKit.Colors.Disabled,
		Text = if available then "▶ Travel" else "🔒 Скоро",
		TextSize = 19,
		Parent = frame,
	}, function()
		if not available then
			UIKit.Toast("Цей світ відкриється в наступних оновленнях", "info")
		elseif row.locked then
			UIKit.Toast(row.subtitle.Text, "error")
		else
			travel(worldId, panel)
		end
	end)
	row.stroke = stroke
	row.button = button
	rows[worldId] = row
end

function WorldsUI.Init(gui)
	local panel, content = UIKit.Panel(gui, "Worlds", "🌍 Worlds", Color3.fromRGB(255, 185, 40))
	Hud.RegisterPanel("Worlds", panel)
	UIKit.Create("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder, Parent = content })

	addRow(content, 0, "Lobby", "🏠 Lobby", "Твоя база та кубики", UIKit.Colors.Accent, true, panel)
	for index, worldId in WorldConfig.Order do
		local world = WorldConfig.Worlds[worldId]
		addRow(content, index, worldId, world.displayName .. " — " .. world.localName, world.description, world.color, world.available, panel)
	end

	refresh()
	player:GetAttributeChangedSignal("World"):Connect(refresh)
	ClientState.OnDataChanged(refresh)
end

return WorldsUI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="61">
          <Properties>
            <string name="Name">ZoneGates</string>
            <string name="Source"><![CDATA[-- ZoneGates: ворота зон на екрані цього гравця.
-- Відкрита зона — ворота стають прозорими й прохідними (тільки для нього:
-- персонажем керує його клієнт). Закрита — показуємо прогрес перемог.

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameMath = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("GameMath"))

local Client = script.Parent
local ClientState = require(Client:WaitForChild("ClientState"))

local ZoneGates = {}

local GATE_TAG = "ZoneGate" -- той самий тег, що у WorldService

local function apply(gate)
	local data = ClientState.Data
	if not data then
		return
	end
	local zoneIndex = gate:GetAttribute("ZoneIndex")
	local unlocked = GameMath.IsZoneUnlocked(data, gate:GetAttribute("World"), zoneIndex)
	gate.CanCollide = not unlocked
	gate.Transparency = if unlocked then 0.9 else 0.3

	local sign = gate:FindFirstChild("Sign")
	local label = sign and sign:FindFirstChild("Gui") and sign.Gui:FindFirstChild("Label")
	if label then
		local name = gate:GetAttribute("ZoneName") or "?"
		if unlocked then
			label.Text = "✅ " .. name
		else
			local kills = GameMath.GetWorldKills(data, gate:GetAttribute("World"))
			label.Text = ("🔒 %s — перемоги тут: %d / %d"):format(name, kills, gate:GetAttribute("RequiredKills") or 0)
		end
	end
end

local function applyAll()
	for _, gate in CollectionService:GetTagged(GATE_TAG) do
		apply(gate)
	end
end

function ZoneGates.Init()
	CollectionService:GetInstanceAddedSignal(GATE_TAG):Connect(apply)
	ClientState.OnDataChanged(applyAll)
	applyAll()
end

return ZoneGates
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="LocalScript" referent="62">
        <Properties>
          <string name="Name">ClientMain</string>
          <string name="Source"><![CDATA[-- ClientMain: точка входу клієнта. Будує інтерфейс і підключає модулі.
-- Тип: LocalScript, шлях: StarterPlayer/StarterPlayerScripts/ClientMain

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Remotes"))

local Client = script.Parent:WaitForChild("Client")
local ClientState = require(Client:WaitForChild("ClientState"))
local UIKit = require(Client:WaitForChild("UIKit"))
local Hud = require(Client:WaitForChild("Hud"))
local RollUI = require(Client:WaitForChild("RollUI"))
local InventoryUI = require(Client:WaitForChild("InventoryUI"))
local UpgradesUI = require(Client:WaitForChild("UpgradesUI"))
local SettingsUI = require(Client:WaitForChild("SettingsUI"))
local WorldEffects = require(Client:WaitForChild("WorldEffects"))
local EnemyRegistry = require(Client:WaitForChild("EnemyRegistry"))
local FollowerController = require(Client:WaitForChild("FollowerController"))
local TeamUI = require(Client:WaitForChild("TeamUI"))
local WorldsUI = require(Client:WaitForChild("WorldsUI"))
local CombatUI = require(Client:WaitForChild("CombatUI"))
local QuestsUI = require(Client:WaitForChild("QuestsUI"))
local ZoneGates = require(Client:WaitForChild("ZoneGates"))
local RebirthUI = require(Client:WaitForChild("RebirthUI"))
local WorldLighting = require(Client:WaitForChild("WorldLighting"))
local AdminUI = require(Client:WaitForChild("AdminUI"))

local gui = UIKit.CreateScreenGui()

Hud.Init(gui)
RollUI.Init(gui)
InventoryUI.Init(gui)
UpgradesUI.Init(gui)
SettingsUI.Init(gui)
TeamUI.Init(gui)
WorldsUI.Init(gui)
EnemyRegistry.Init()
FollowerController.Init()
CombatUI.Init(gui)
QuestsUI.Init(gui)
RebirthUI.Init(gui)
AdminUI.Init(gui)
ZoneGates.Init()
WorldLighting.Init()
WorldEffects.Init()

Remotes.Get("Notify").OnClientEvent:Connect(function(text, kind)
	UIKit.Toast(text, kind)
end)

-- Підключаємо дані останніми, щоб усі вікна вже слухали оновлення
ClientState.Init()

UIKit.Toast("Ласкаво просимо до Anime Dice: Awakening!", "info")
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
</roblox>