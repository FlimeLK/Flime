<roblox version="4">
  <Item class="Players" referent="0">
    <Properties>
      <string name="Name">Players</string>
      <bool name="CharacterAutoLoads">true</bool>
    </Properties>
  </Item>
  <Item class="ReplicatedStorage" referent="1">
    <Properties>
      <string name="Name">ReplicatedStorage</string>
    </Properties>
    <Item class="Folder" referent="2">
      <Properties>
        <string name="Name">Shared</string>
      </Properties>
      <Item class="Folder" referent="3">
        <Properties>
          <string name="Name">Config</string>
        </Properties>
        <Item class="ModuleScript" referent="4">
          <Properties>
            <string name="Name">AdminConfig</string>
            <string name="Source"><![CDATA[-- AdminConfig: хто має доступ до адмін-панелі.
-- Кожну дію адміна сервер перевіряє заново — клієнт лише показує кнопки.

local AdminConfig = {}

-- Імена адмінів. Сервер сам перетворює їх на UserId (так надійніше, ніж порівнювати імена).
AdminConfig.Usernames = { "FlimeYTLK" }

-- UserId адмінів (необов'язково): числа з посилання на профіль roblox.com/users/<UserId>/profile
AdminConfig.UserIds = {}

-- Власник гри (або власник групи, якщо гра групова) — завжди адмін
AdminConfig.OwnerIsAdmin = true

-- У Studio (Play / Start Server) адмінами є всі тестові гравці — зручно перевіряти панель
AdminConfig.StudioIsAdmin = true

-- Межі, щоб випадковий нуль зайвий не зламав економіку
AdminConfig.MaxCurrency = 1e15
AdminConfig.MaxHeroesPerAction = 10
AdminConfig.MaxBoostMinutes = 24 * 60
AdminConfig.MaxEventMinutes = 120
AdminConfig.EventMultipliers = { 2, 3, 5, 10 }
AdminConfig.WalkSpeeds = { 16, 32, 60, 100 }
AdminConfig.LogSize = 60

return AdminConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="5">
          <Properties>
            <string name="Name">AssetConfig</string>
            <string name="Source"><![CDATA[-- AssetConfig: картинки (іконки) і звуки гри.
--
-- Іконки лежать у репозиторії: assets/icons/*.png (власний набір гри, можна вільно
-- використовувати). Завантаж їх у Roblox (Asset Manager → Bulk Import),
-- скопіюй ID кожної та встав сюди: "rbxassetid://1234567890" або просто "1234567890".
--
-- Поки поле порожнє (""), гра показує емодзі — нічого не ламається.
-- Звуки так само: Toolbox → Audio → права кнопка → Copy Asset ID.

local AssetConfig = {}

AssetConfig.Icons = {
	-- Головний екран
	Roll = "",
	Backpack = "",
	Team = "",
	Upgrades = "",
	Quests = "",
	Rebirth = "",
	Index = "",
	Worlds = "",
	Home = "",
	Shop = "",
	Settings = "",
	Auto = "",
	Lock = "",
	-- Валюти й удача
	Coin = "",
	Crystal = "",
	Luck = "",
	-- Магазин і покращення
	Slots = "",
	Income = "",
	LuckPotion = "",
	CoinPotion = "",
	BigBag = "",
}

-- Емодзі, які показуються, поки картинку не підключено
AssetConfig.Fallback = {
	Roll = "🎲",
	Backpack = "🎒",
	Team = "⚔️",
	Upgrades = "⬆️",
	Quests = "📜",
	Rebirth = "♻️",
	Index = "📖",
	Worlds = "🌍",
	Home = "🏠",
	Shop = "🛒",
	Settings = "⚙️",
	Auto = "🔄",
	Lock = "🔒",
	Coin = "🪙",
	Crystal = "💎",
	Luck = "🍀",
	Slots = "🧱",
	Income = "💰",
	LuckPotion = "🍀",
	CoinPotion = "💰",
	BigBag = "🎒",
}

-- Портрети героїв (картинка, яка показується під час кидка, у Backpack, Team та Index).
-- Використовуй лише картинки, на які маєш права: власний арт, куплений арт-пак
-- або безкоштовний пак, що дозволяє використання в іграх. Порожньо — показується 3D-модель.
AssetConfig.HeroPortraits = {
	riku_windstep = "", -- Riku Windstep (Common)
	tomo_deckhand = "", -- Tomo the Deckhand (Common)
	hana_emberling = "", -- Hana Emberling (Common)
	zen_cadet = "", -- Zen Star Cadet (Common)
	shiro_quickblade = "", -- Shiro Quickblade (Rare)
	kaito_saltfang = "", -- Kaito Saltfang (Rare)
	mira_cinderveil = "", -- Mira Cinderveil (Rare)
	yoru_lantern = "", -- Yoru Lanternbearer (Rare)
	akane_crimsonfan = "", -- Akane Crimson Fan (Epic)
	raizo_thunderstep = "", -- Raizo Thunderstep (Epic)
	nox_hollowhunter = "", -- Nox Hollowhunter (Epic)
	coral_vex = "", -- Captain Coral Vex (Epic)
	seren_starblade = "", -- Seren Starblade (Legendary)
	kuro_moonreaper = "", -- Kuro Moonreaper (Legendary)
	homura_ashcrown = "", -- Homura Ashcrown (Legendary)
	ryo_skybolt = "", -- Ryo Skybolt (Legendary)
	marisol_tidecaller = "", -- Marisol Tidecaller (Legendary)
	rin_hellbane = "", -- Rin Hellbane (Legendary)
	astra_novaempress = "", -- Astra, Nova Empress (Mythic)
	gekko_voidshinobi = "", -- Gekko the Void Shinobi (Mythic)
	volta_stormcaptain = "", -- Storm Captain Volta (Mythic)
	ifra_phoenixsaint = "", -- Ifra, Phoenix Saint (Mythic)
	kaizen_deepcrown = "", -- Admiral Kaizen Deepcrown (Mythic)
	kagura_duskblade = "", -- Kagura Duskblade (Mythic)
	solenne_eclipse = "", -- Solenne, Eclipse Sovereign (Secret)
	mugen_dicegod = "", -- Mugen, the Dice God (Secret)
	vael_abyssal = "", -- Vael, Abyssal Emperor (Secret)
}

AssetConfig.Sounds = {
	Click = "", -- натискання кнопки
	RollTick = "", -- кожна зміна героя під час прокрутки
	Reveal = "", -- випав герой
	RareReveal = "", -- випав Legendary і рідкісніший
	Purchase = "", -- успішна покупка
	Reward = "", -- нагорода (завдання, бос)
	Error = "", -- помилка / не вистачає монет
}

AssetConfig.SoundVolume = {
	Click = 0.4,
	RollTick = 0.3,
	Reveal = 0.7,
	RareReveal = 0.9,
	Purchase = 0.6,
	Reward = 0.7,
	Error = 0.5,
}

local function normalize(id)
	if type(id) ~= "string" or id == "" then
		return nil
	end
	if string.match(id, "^%d+$") then
		return "rbxassetid://" .. id
	end
	return id
end

-- Повна адреса картинки або nil, якщо її ще не підключено.
function AssetConfig.GetImage(key)
	return normalize(AssetConfig.Icons[key])
end

function AssetConfig.GetPortrait(heroId)
	return normalize(AssetConfig.HeroPortraits[heroId])
end

function AssetConfig.GetSound(key)
	return normalize(AssetConfig.Sounds[key])
end

return AssetConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="6">
          <Properties>
            <string name="Name">CombatConfig</string>
            <string name="Source"><![CDATA[-- CombatConfig: налаштування бою та бойової команди.

local CombatConfig = {
	TeamSize = 3, -- героїв у бойовій команді

	AttackRange = 45, -- макс. відстань (studs) від гравця до ворога, щоб команда атакувала
	TargetSelectRange = 120, -- з якої відстані можна вибрати ворога кліком або кнопкою 🎯
	TickSeconds = 0.1, -- як часто сервер рахує атаки

	-- Частка здоров'я ворога, яку треба зняти, щоб отримати нагороду
	-- (захист від "один раз клікнув — забрав нагороду боса").
	MinContributionShare = 0.03,

	-- Де стоять герої відносно гравця: X — вбік, Z — назад
	FollowerOffsets = {
		Vector3.new(-5, 0, 4),
		Vector3.new(5, 0, 4),
		Vector3.new(0, 0, 8),
	},
	FollowerScale = 0.8, -- герої-супутники трохи менші за героїв на базі
}

return CombatConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="7">
          <Properties>
            <string name="Name">DiceConfig</string>
            <string name="Source"><![CDATA[-- DiceConfig: усі кубики гри.
-- price         — ціна одного кидка в Coins
-- luck          — множник удачі (діє на рідкості з luckAffected = true)
-- requiredRolls — скільки всього кидків треба зробити, щоб відкрити кубик
-- requiredBoss  — (необов'язково) id боса, якого треба перемогти хоча б раз
-- element       — стихія, герої якої випадають частіше
-- elementBonus  — у скільки разів частіше випадають герої цієї стихії
-- weights       — базові ваги рідкостей (не обов'язково в сумі 100)

local DiceConfig = {}

-- Кубик, яким робиться перший безкоштовний навчальний кидок.
DiceConfig.TutorialDice = "Basic"

DiceConfig.Order = { "Basic", "Fire", "Lightning", "Shadow", "Tidal", "Celestial", "Abyss" }

DiceConfig.Dice = {
	Abyss = {
		displayName = "Abyss Dice",
		description = "Нагорода за Demon Queen Noctyra. Тіньові герої втричі частіше.",
		icon = "🔮",
		color = Color3.fromRGB(150, 40, 200),
		price = 25000,
		luck = 2.8,
		requiredRolls = 0,
		requiredBoss = "demon_queen_noctyra",
		element = "Shadow",
		elementBonus = 3,
		weights = { Common = 200, Rare = 300, Epic = 250, Legendary = 150, Mythic = 75, Secret = 25 },
	},
	Basic = {
		displayName = "Basic Dice",
		description = "Простий кубик для старту пригоди.",
		icon = "🎲",
		color = Color3.fromRGB(235, 235, 245),
		price = 25,
		luck = 1,
		requiredRolls = 0,
		element = nil,
		elementBonus = 1,
		weights = { Common = 700, Rare = 230, Epic = 60, Legendary = 9, Mythic = 1, Secret = 0 },
	},
	Fire = {
		displayName = "Fire Dice",
		description = "Вогняні герої випадають утричі частіше.",
		icon = "🔥",
		color = Color3.fromRGB(255, 110, 50),
		price = 150,
		luck = 1.25,
		requiredRolls = 25,
		element = "Fire",
		elementBonus = 3,
		weights = { Common = 600, Rare = 280, Epic = 95, Legendary = 20, Mythic = 4.5, Secret = 0.5 },
	},
	Lightning = {
		displayName = "Lightning Dice",
		description = "Блискавичні герої випадають утричі частіше.",
		icon = "⚡",
		color = Color3.fromRGB(255, 230, 60),
		price = 600,
		luck = 1.5,
		requiredRolls = 75,
		element = "Lightning",
		elementBonus = 3,
		weights = { Common = 500, Rare = 320, Epic = 130, Legendary = 38, Mythic = 10, Secret = 2 },
	},
	Shadow = {
		displayName = "Shadow Dice",
		description = "Тіньові герої випадають утричі частіше.",
		icon = "🌑",
		color = Color3.fromRGB(120, 60, 200),
		price = 2500,
		luck = 1.8,
		requiredRolls = 200,
		element = "Shadow",
		elementBonus = 3,
		weights = { Common = 380, Rare = 340, Epic = 180, Legendary = 70, Mythic = 25, Secret = 5 },
	},
	Tidal = {
		displayName = "Tidal Dice",
		description = "Нагорода за Captain Blackwake. Водні герої втричі частіше.",
		icon = "🌊",
		color = Color3.fromRGB(40, 170, 255),
		price = 5000,
		luck = 2,
		requiredRolls = 0,
		requiredBoss = "captain_blackwake",
		element = "Water",
		elementBonus = 3,
		weights = { Common = 300, Rare = 340, Epic = 210, Legendary = 100, Mythic = 40, Secret = 10 },
	},
	Celestial = {
		displayName = "Celestial Dice",
		description = "Небесний кубик: найкраща удача, світлі герої частіше.",
		icon = "✨",
		color = Color3.fromRGB(150, 230, 255),
		price = 10000,
		luck = 2.2,
		requiredRolls = 500,
		element = "Light",
		elementBonus = 3,
		weights = { Common = 250, Rare = 330, Epic = 230, Legendary = 120, Mythic = 55, Secret = 15 },
	},
}

return DiceConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="8">
          <Properties>
            <string name="Name">EconomyConfig</string>
            <string name="Source"><![CDATA[-- EconomyConfig: ціни, бонуси та ліміти. Усі числа балансу — тут.

local EconomyConfig = {
	StartingCoins = 60,
	StartingCrystals = 0,
	MaxInventory = 150, -- максимум героїв в інвентарі

	-- База
	StartSlots = 3,
	MaxSlots = 12,
	SlotUpgrade = {
		basePrice = 150, -- ціна 4-го слота
		growth = 1.9, -- кожен наступний слот дорожчий у 1.9 раза
	},
	IncomeUpgrade = {
		basePrice = 100,
		growth = 1.55,
		bonusPerLevel = 0.1, -- +10% доходу бази за рівень
		maxLevel = 30,
	},

	-- Герої
	LevelIncomeBonus = 0.2, -- +20% доходу героя за кожен рівень понад 1
	LevelDamageBonus = 0.15, -- +15% шкоди за рівень (знадобиться в боях)
	SellLevelBonus = 0.5, -- кожен рівень додає 50% до ціни продажу

	-- Дохід
	IncomeTickSeconds = 1,
	OfflineMaxSeconds = 2 * 60 * 60, -- офлайн-дохід максимум за 2 години
	OfflineRate = 0.5, -- офлайн герої заробляють 50% від звичайного

	-- Rebirth: віддаєш монети, слоти й покращення доходу — отримуєш назавжди
	-- +50% доходу і +5% удачі за кожен Rebirth та кристали.
	Rebirth = {
		baseCost = 250000, -- ціна першого Rebirth у Coins
		growth = 2.5, -- кожен наступний дорожчий у 2.5 раза
		incomeBonus = 0.5,
		luckBonus = 0.05,
		crystalReward = 10, -- × номер Rebirth (10, 20, 30…)
	},

	-- Колекція: кожен відкритий герой дає +2% до доходу бази
	CollectionIncomeBonus = 0.02,

	-- Кидки
	RollCooldown = 0.5, -- мінімальна пауза між кидками (сервер)

	-- Гарантія: якщо N кидків поспіль не випадало rarity або краще,
	-- N-й кидок гарантовано дасть щонайменше цю рідкість.
	Pity = {
		{ rarity = "Epic", rolls = 40 },
		{ rarity = "Legendary", rolls = 250 },
	},
}

return EconomyConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="9">
          <Properties>
            <string name="Name">EnemyConfig</string>
            <string name="Source"><![CDATA[-- EnemyConfig: вороги, боси та де вони з'являються у кожному світі.
-- health   — запас здоров'я
-- coins    — нагорода в Coins кожному, хто допоміг перемогти
-- crystals — нагорода в Crystals (лише боси)
-- respawn  — через скільки секунд ворог з'явиться знову
-- style    — зовнішній вигляд простої моделі з Part
--
-- Атаки боса (attacks) — список; бос щоразу вибирає випадкову. pattern:
--   "self"    — коло навколо боса
--   "targets" — коло під кожним гравцем поруч
--   "random"  — count кіл у випадкових місцях арени (spread — радіус розкиду)

local EnemyConfig = {}

EnemyConfig.Enemies = {
	bandit_genin = {
		name = "Bandit Genin",
		health = 80,
		coins = 12,
		crystals = 0,
		respawn = 8,
		scale = 1,
		style = "Genin",
		body = Color3.fromRGB(90, 85, 75),
		accent = Color3.fromRGB(200, 60, 60),
	},
	shadow_puppet = {
		name = "Shadow Puppet",
		health = 240,
		coins = 32,
		crystals = 0,
		respawn = 10,
		scale = 1.1,
		style = "Puppet",
		body = Color3.fromRGB(35, 25, 50),
		accent = Color3.fromRGB(170, 80, 255),
	},
	rogue_ronin = {
		name = "Rogue Ronin",
		health = 650,
		coins = 85,
		crystals = 0,
		respawn = 14,
		scale = 1.25,
		style = "Ronin",
		body = Color3.fromRGB(60, 70, 110),
		accent = Color3.fromRGB(230, 230, 240),
	},
	oni_kurogane = {
		name = "Oni Warlord Kurogane",
		health = 6000,
		coins = 1500,
		crystals = 25,
		respawn = 90,
		scale = 2.6,
		style = "Oni",
		body = Color3.fromRGB(180, 40, 40),
		accent = Color3.fromRGB(255, 200, 60),
		isBoss = true,
		attackInterval = 5, -- секунд між атаками
		attacks = {
			-- Удар по землі навколо боса: червоне коло, потім шкода всім усередині
			{ displayName = "Ground Slam", pattern = "self", telegraph = 1.6, radius = 20, damage = 35 },
			-- Дощ сюрикенів: кола під кожним гравцем поруч, треба відбігти
			{ displayName = "Shuriken Rain", pattern = "targets", telegraph = 1.3, radius = 9, damage = 25 },
		},
	},

	-- ===== Pirate Island =====
	deckhand_brawler = {
		name = "Deckhand Brawler",
		health = 900,
		coins = 70,
		crystals = 0,
		respawn = 8,
		scale = 1.15,
		style = "Brawler",
		body = Color3.fromRGB(150, 110, 80),
		accent = Color3.fromRGB(220, 40, 40),
	},
	cannon_crab = {
		name = "Cannon Crab",
		health = 2200,
		coins = 160,
		crystals = 0,
		respawn = 10,
		scale = 1.3,
		style = "Crab",
		body = Color3.fromRGB(230, 90, 60),
		accent = Color3.fromRGB(60, 60, 70),
	},
	cursed_corsair = {
		name = "Cursed Corsair",
		health = 5000,
		coins = 350,
		crystals = 0,
		respawn = 14,
		scale = 1.35,
		style = "Corsair",
		body = Color3.fromRGB(40, 70, 80),
		accent = Color3.fromRGB(80, 255, 200),
	},
	captain_blackwake = {
		name = "Captain Blackwake",
		health = 45000,
		coins = 12000,
		crystals = 60,
		respawn = 120,
		scale = 2.8,
		style = "Captain",
		body = Color3.fromRGB(30, 30, 45),
		accent = Color3.fromRGB(255, 200, 60),
		isBoss = true,
		attackInterval = 4.5,
		attacks = {
			{ displayName = "Cannon Barrage", pattern = "random", count = 7, spread = 26, telegraph = 1.5, radius = 8, damage = 40 },
			{ displayName = "Anchor Sweep", pattern = "self", telegraph = 1.8, radius = 24, damage = 50 },
			{ displayName = "Kraken Grab", pattern = "targets", telegraph = 1.4, radius = 10, damage = 45 },
		},
	},

	-- ===== Demon Night City =====
	alley_imp = {
		name = "Alley Imp",
		health = 6000,
		coins = 300,
		crystals = 0,
		respawn = 8,
		scale = 0.95,
		style = "Imp",
		body = Color3.fromRGB(150, 30, 60),
		accent = Color3.fromRGB(255, 80, 200),
	},
	lantern_wraith = {
		name = "Lantern Wraith",
		health = 14000,
		coins = 650,
		crystals = 0,
		respawn = 10,
		scale = 1.25,
		style = "Wraith",
		body = Color3.fromRGB(40, 30, 70),
		accent = Color3.fromRGB(80, 220, 255),
	},
	night_fiend = {
		name = "Night Fiend",
		health = 32000,
		coins = 1400,
		crystals = 0,
		respawn = 14,
		scale = 1.5,
		style = "Fiend",
		body = Color3.fromRGB(25, 20, 30),
		accent = Color3.fromRGB(255, 60, 60),
	},
	demon_queen_noctyra = {
		name = "Demon Queen Noctyra",
		health = 300000,
		coins = 80000,
		crystals = 150,
		respawn = 150,
		scale = 3,
		style = "DemonQueen",
		body = Color3.fromRGB(60, 15, 70),
		accent = Color3.fromRGB(255, 50, 160),
		isBoss = true,
		attackInterval = 4,
		attacks = {
			{ displayName = "Hellfire Ring", pattern = "self", telegraph = 1.7, radius = 26, damage = 60 },
			{ displayName = "Shadow Spikes", pattern = "random", count = 9, spread = 28, telegraph = 1.4, radius = 8, damage = 55 },
			{ displayName = "Soul Chains", pattern = "targets", telegraph = 1.3, radius = 11, damage = 55 },
		},
	},
}

-- Точки появи. offset — відносно центру світу (Y = 0 — рівень землі).
-- zone — номер зони з WorldConfig (ворогів закритої зони не можна атакувати).
EnemyConfig.WorldSpawns = {
	NinjaVillage = {
		{ enemy = "bandit_genin", offset = Vector3.new(-22, 0, -65), zone = 1 },
		{ enemy = "bandit_genin", offset = Vector3.new(22, 0, -65), zone = 1 },
