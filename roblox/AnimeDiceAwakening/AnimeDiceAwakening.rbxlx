        <Item class="ModuleScript" referent="4">
          <Properties>
            <string name="Name">DiceConfig</string>
            <string name="Source"><![CDATA[-- DiceConfig: усі кубики гри.
-- price         — ціна одного кидка в Coins
-- luck          — множник удачі (діє на рідкості з luckAffected = true)
-- requiredRolls — скільки всього кидків треба зробити, щоб відкрити кубик
-- element       — стихія, герої якої випадають частіше
-- elementBonus  — у скільки разів частіше випадають герої цієї стихії
-- weights       — базові ваги рідкостей (не обов'язково в сумі 100)

local DiceConfig = {}

-- Кубик, яким робиться перший безкоштовний навчальний кидок.
DiceConfig.TutorialDice = "Basic"

DiceConfig.Order = { "Basic", "Fire", "Lightning", "Shadow", "Celestial" }

DiceConfig.Dice = {
	Basic = {
		displayName = "Basic Dice",
		description = "Простий кубик для старту пригоди.",
		icon = "🎲",
		color = Color3.fromRGB(235, 235, 245),
		price = 25,
		luck = 1,
		requiredRolls = 0,
		element = nil,
		elementBonus = 1,
		weights = { Common = 700, Rare = 230, Epic = 60, Legendary = 9, Mythic = 1, Secret = 0 },
	},
	Fire = {
		displayName = "Fire Dice",
		description = "Вогняні герої випадають утричі частіше.",
		icon = "🔥",
		color = Color3.fromRGB(255, 110, 50),
		price = 150,
		luck = 1.25,
		requiredRolls = 25,
		element = "Fire",
		elementBonus = 3,
		weights = { Common = 600, Rare = 280, Epic = 95, Legendary = 20, Mythic = 4.5, Secret = 0.5 },
	},
	Lightning = {
		displayName = "Lightning Dice",
		description = "Блискавичні герої випадають утричі частіше.",
		icon = "⚡",
		color = Color3.fromRGB(255, 230, 60),
		price = 600,
		luck = 1.5,
		requiredRolls = 75,
		element = "Lightning",
		elementBonus = 3,
		weights = { Common = 500, Rare = 320, Epic = 130, Legendary = 38, Mythic = 10, Secret = 2 },
	},
	Shadow = {
		displayName = "Shadow Dice",
		description = "Тіньові герої випадають утричі частіше.",
		icon = "🌑",
		color = Color3.fromRGB(120, 60, 200),
		price = 2500,
		luck = 1.8,
		requiredRolls = 200,
		element = "Shadow",
		elementBonus = 3,
		weights = { Common = 380, Rare = 340, Epic = 180, Legendary = 70, Mythic = 25, Secret = 5 },
	},
	Celestial = {
		displayName = "Celestial Dice",
		description = "Небесний кубик: найкраща удача, світлі герої частіше.",
		icon = "✨",
		color = Color3.fromRGB(150, 230, 255),
		price = 10000,
		luck = 2.2,
		requiredRolls = 500,
		element = "Light",
		elementBonus = 3,
		weights = { Common = 250, Rare = 330, Epic = 230, Legendary = 120, Mythic = 55, Secret = 15 },
	},
}

return DiceConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="5">
          <Properties>
            <string name="Name">EconomyConfig</string>
            <string name="Source"><![CDATA[-- EconomyConfig: ціни, бонуси та ліміти. Усі числа балансу — тут.

local EconomyConfig = {
	StartingCoins = 60,
	StartingCrystals = 0,
	MaxInventory = 150, -- максимум героїв в інвентарі

	-- База
	StartSlots = 3,
	MaxSlots = 12,
	SlotUpgrade = {
		basePrice = 150, -- ціна 4-го слота
		growth = 1.9, -- кожен наступний слот дорожчий у 1.9 раза
	},
	IncomeUpgrade = {
		basePrice = 100,
		growth = 1.55,
		bonusPerLevel = 0.1, -- +10% доходу бази за рівень
		maxLevel = 30,
	},

	-- Герої
	LevelIncomeBonus = 0.2, -- +20% доходу героя за кожен рівень понад 1
	LevelDamageBonus = 0.15, -- +15% шкоди за рівень (знадобиться в боях)
	SellLevelBonus = 0.5, -- кожен рівень додає 50% до ціни продажу

	-- Дохід
	IncomeTickSeconds = 1,
	OfflineMaxSeconds = 2 * 60 * 60, -- офлайн-дохід максимум за 2 години
	OfflineRate = 0.5, -- офлайн герої заробляють 50% від звичайного

	-- Кидки
	RollCooldown = 0.5, -- мінімальна пауза між кидками (сервер)

	-- Гарантія: якщо N кидків поспіль не випадало rarity або краще,
	-- N-й кидок гарантовано дасть щонайменше цю рідкість.
	Pity = {
		{ rarity = "Epic", rolls = 40 },
		{ rarity = "Legendary", rolls = 250 },
	},
}

return EconomyConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="6">
          <Properties>
            <string name="Name">HeroConfig</string>
            <string name="Source"><![CDATA[-- HeroConfig: усі герої гри (оригінальні персонажі).
-- ВАЖЛИВО: ніколи не видаляй і не перейменовуй id героя після релізу —
-- id зберігається в DataStore, і гравці втратять цих героїв.
--
-- damage       — базова шкода (знадобиться в боях, етап 2)
-- attackSpeed  — атак за секунду
-- income       — монет за секунду на базі (рівень 1)
-- ability      — особлива здібність (працюватиме в боях)
-- awakened     — пробуджена форма (відкриється на наступних етапах)
-- look         — кольори простої моделі з Part

